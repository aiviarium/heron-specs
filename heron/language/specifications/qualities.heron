qualities: section {
  | A bound on something measured isn't a rule with a vague word, "fast" or "reliably",
  | but a [metric](#language.specifications.qualities.metric_kind) defined once and a
  | [quality](#language.specifications.qualities.quality_kind) that bounds it.

  metric_kind: term {{
    `name: metric(T) {{ … }}`, what is measured, its type `T` and its definition.
  }}

  quality_kind: term {{
    `quality(targets) { … }`, a bound on a metric: `metric` names it, `at_least` or
    `at_most` bounds it, `percentile` says at which point of its distribution, and
    `applies {{ … }}` and the conditions of rules scope it. Its strength holds a short
    sentence for readers.
  }}

  quality_body: rule(quality_kind, by = product.system.checker) {
    must {{ check a quality's body as a rule's, with at most one strength, at most one of each of `std/spec`'s conditions and at most one `applies` }}
    example {{ a quality with `must` and `should` reports "quality accepts at most 1 strength node" }}
  }

  quality_view: rule(quality_kind, by = product.system.docs_generator) {
    must {{ show a quality's sentence, then its metric, bounds and percentile as facts, then `applies` and its other consequences }}
  }

  vague_words_measured: rule(metric_kind, by = product.system.prose_linter) {
    where {{ a quality targets a rule or a node above it }}
    mustNot {{ report a vague word in that rule }}
    instead {{ read the rule as measured by the quality }}
  }

  no_negative_quality: rule(quality_kind, by = product.system.checker) {
    if {{ a quality's strength is `mustNot` or `shouldNot` }}
    must {{ report [negative quality](#language.specifications.qualities.diagnostics.negative_quality) at the strength }}
    then {{ the bound alone says which direction is bad }}
  }

  bound_typed_by_metric: rule(quality_kind, by = product.system.checker) {
    must {{ check `at_least` and `at_most` against the type of the metric the quality names }}
    example {{ `at_most = "2s"` on a `metric(Duration)` is a duration }}
  }

  measured: rule(quality_kind, by = product.system.interpreter) {
    must {{ verify a quality by measurement, from a benchmark scenario, a measure step or monitoring, never by a test that passes or fails }}
  }

  diagnostics: section {
    @display("Negative quality")
    negative_quality: diagnostic("quality", by = product.system.checker) {
      message = "a quality's strength is positive; the bound says which direction is bad"
      | A quality with `mustNot` or `shouldNot`.
    }
  }
}
