@display("Quality checks")
quality_checks: section {
  | The lints check what ISO/IEC/IEEE 29148 asks of a set of requirements: each one
  | singular, unambiguous and verifiable, and the set complete, consistent and separated
  | from planning. The spec-aware prose lints run in `heron lint` and in editors through
  | the prose provider, and report warnings coded `Spec.` and the check's name.
  |
  | | Property     | Checked by                                                                    |
  | | ------------ | ----------------------------------------------------------------------------- |
  | | Unambiguous  | unlinked terms, ruled-out synonyms, terms in two senses, weak modals and vague words |
  | | Singular     | one strength per rule, from its kind's [schema](#language.schemas.kinds.schema) |
  | | Verifiable   | the spec's status test, and the [coverage](#language.specifications.traceability.coverage) still planned                         |
  | | Complete     | the [lifecycle](#language.specifications.lifecycles.lifecycle) checks still planned |
  | | Consistent   | links and targets that resolve, and the overlap check still planned           |
  | | Separated    | the layout's rule on planning, design words and delivery words                |
  | | Well formed  | compound rules, negations without a condition, long or scripted scenarios, missing measures |

  unambiguous_wording: rule(system.prose_linter) {
    should {{ report weak modal where the text under `must` or `mustNot` says "should", "may", "might", "could" or "ideally", and vague word where a rule that serves no quality and stands beside no quality scenario uses a word such as "fast", "robust" or "several" }}
    while {{ the word is used rather than mentioned: unquoted, outside code and unmasked }}
  }

  nodes_linked: rule(system.prose_linter) {
    should {{ report unlinked node where prose names a node of the tree by its identifier without linking it, and dead link where a link to a file has no target }}
    then {{ a fix offered with it links the name when one node has it }}
  }

  double_negative: rule(system.prose_linter) {
    if {{ the text under `mustNot` or `shouldNot` is itself negative }}
    should {{ report a double negative }}
  }

  singular_check: rule(system.prose_linter) {
    if {{ a rule's text joins two behaviours with "and" or "or" }}
    should {{ report it as not singular }}
  }

  verifiable_check: rule(system.linter) {
    if {{ nothing covers a `must` rule, or a bounded condition lacks an example on each side of the bound }}
    should {{ report it as not verifiable }}
  }

  unlinked_node_fix: rule(system.prose_linter) {
    where {{ the name an unlinked node reports names one node of the tree }}
    must {{ offer a fix that wraps the name in brackets as a [short link](#language.markup.links.short_link), which `heron lint -fix` applies }}
  }

  consistent_check: rule(system.linter) {
    if {{ rules on one target overlap in their conditions and oppose in polarity }}
    should {{ report them as inconsistent, found structurally and confirmed by a decider }}
  }

  separated_check: rule(system.linter) {
    if {{ an `open` is reachable from the [entry point](#language.core_format.files.entry_point) of an implementer }}
    should {{ report it as not separated }}
  }

  compound_rule: rule(system.prose_linter) {
    if {{ a rule's strength text joins two responses with "and" or "or", or a condition joins two triggers }}
    should {{ report compound rule at the joining word }}
  }

  bare_negation: rule(system.prose_linter) {
    if {{ a rule says "not", "never" or "no" under a negative strength with no condition and no `instead` }}
    should {{ report negation without a condition at the word }}
  }

  negated_condition: rule(system.prose_linter) {
    if {{ a condition says "not the case that", or negates twice in one clause, as `isn't … no` or `not … never` }}
    should {{ report a negated condition at the words }}
    then {{ a rule says the state it applies in, as the people who use the product would }}
  }

  design_words: rule(system.prose_linter) {
    if {{ the text of an intent or specification node says a design word, `database`, `table`, `class`, `microservice`, `endpoint`, `column` or `schema migration`, and the tree declares no term of that name }}
    should {{ report a design word at the word, outside code spans, links and quotes }}
    then {{ a product whose domain has such things, as a document tool has its [tables](#heron.language.markup.components.table), declares them as terms }}
  }

  measure_missing: rule(system.linter) {
    if {{ a quality has no `measure` and no quality scenario serves it }}
    should {{ report measure missing at the quality }}
  }

  long_scenario: rule(system.linter) {
    if {{ an outcome scenario has more than five clauses }}
    should {{ report long scenario at the scenario }}
  }

  scripted_scenario: rule(system.prose_linter) {
    if {{ an outcome scenario's text says how a screen is driven: "click", "press", "type", "tap", "field" or "button" }}
    should {{ report scripted scenario at the word }}
  }

  delivery_words: rule(system.prose_linter) {
    if {{ the text of a node in any [layer](#heron.language.specifications.layers.layer) says a delivery word: "sprint", "milestone", "increment", "story points", "backlog" or "deadline" }}
    should {{ report delivery word at the word }}
  }

  errors: section {
    @display("Unlinked term")
    @severity(warning)
    unlinked_term: error("Spec.UnlinkedTerm") {
      title = "\"{phrase}\" is the term {path}; link it"
      phrase: field(String)
      path: field(String)
      | A term's phrase in prose outside the term, not linked.
      | Reported as [language.specifications.quality_checks.nodes_linked] says.
    }

    @display("Ruled-out synonym")
    @severity(warning)
    ruled_out_synonym: error("Spec.Synonym") {
      title = "\"{alias}\" is a synonym the term {path} rules out; use the term"
      alias: field(String)
      path: field(String)
      | One of a term's [aliases](#language.data.values.alias), used where the term should be.
      | Reported as [language.specifications.quality_checks.unambiguous_wording] says.
    }

    @display("Two senses")
    @severity(warning)
    two_senses: error("Spec.TwoSenses") {
      title = "\"{phrase}\" is defined by two terms, here and {path}, so it's used in two senses"
      phrase: field(String)
      path: field(String)
      | A phrase two terms define, reported at each.
      | Reported as [language.specifications.quality_checks.unambiguous_wording] says.
    }

    @display("Unlinked node")
    @severity(warning)
    unlinked_node: error("Spec.UnlinkedNode") {
      title = "{name} names a node without linking it"
      name: field(String)
      | An identifier of the tree, with an underscore or an inner capital, written as plain text.
      | Reported as [language.specifications.quality_checks.nodes_linked] and [language.specifications.quality_checks.unlinked_node_fix] say.
    }

    @display("Dead link")
    @severity(warning)
    dead_link: error("Spec.DeadLink") {
      title = "the link's target {target} doesn't exist"
      target: field(String)
      | A link to a file that isn't there.
      | Reported as [language.markup.authored_pages.links.file_links_checked] and [language.specifications.quality_checks.nodes_linked] say.
    }

    @display("Weak modal")
    @severity(warning)
    weak_modal: error("Spec.MustSaysShould") {
      title = "a {strength} requirement says \"{word}\"; state it as {strength}"
      strength: field(String)
      word: field(String)
      | A weak modal verb under a mandatory strength.
      | Reported as [language.specifications.quality_checks.unambiguous_wording] says.
    }

    @display("Vague word")
    @severity(warning)
    vague_word: error("Spec.VagueWord") {
      title = "\"{word}\" is vague in a rule without a metric; measure it or say exactly"
      word: field(String)
      | A word that can't be checked, in a rule no quality bounds.
      | Reported as [language.specifications.quality_checks.unambiguous_wording] says.
    }

    @display("Compound rule")
    @severity(warning)
    compound_rule: error("Spec.CompoundRule") {
      title = "this rule joins two behaviours with \"{word}\"; split it into two rules"
      word: field(String)
      | Reported as [language.specifications.quality_checks.compound_rule] says.
    }

    @display("Negation without a condition")
    @severity(warning)
    bare_negation: error("Spec.BareNegation") {
      title = "\"{word}\" forbids without saying when; give a condition or what to do instead"
      word: field(String)
      | Reported as [language.specifications.quality_checks.bare_negation] says.
    }

    @display("Design word")
    @severity(warning)
    design_word: error("Spec.DesignWord") {
      title = "\"{word}\" is a design word in the {layer} layer; say what's observable, or write a constraint with its reason"
      word: field(String)
      layer: field(String)
      | Reported as [language.specifications.quality_checks.design_words] says.
    }

    @display("Measure missing")
    @severity(warning)
    measure_missing: error("Spec.MeasureMissing") {
      title = "quality {name} has no measure and no quality scenario"
      name: field(String)
      | Reported as [language.specifications.quality_checks.measure_missing] says.
    }

    @display("Long scenario")
    @severity(warning)
    long_scenario: error("Spec.LongScenario") {
      title = "scenario {name} has {count} clauses; keep it to about five, or split the rule"
      name: field(String)
      count: field(String)
      | Reported as [language.specifications.quality_checks.long_scenario] says.
    }

    @display("Scripted scenario")
    @severity(warning)
    scripted_scenario: error("Spec.ScriptedScenario") {
      title = "\"{word}\" scripts a screen; say what happens, not how it's driven"
      word: field(String)
      | Reported as [language.specifications.quality_checks.scripted_scenario] says.
    }

    @display("Delivery word")
    @severity(warning)
    delivery_word: error("Spec.DeliveryWord") {
      title = "\"{word}\" is delivery vocabulary; plan work in the project, not the spec"
      word: field(String)
      | Reported as [language.specifications.quality_checks.delivery_words] says.
    }

    @display("Negated condition")
    @severity(warning)
    negated_condition_found: error("Spec.NegatedCondition") {
      title = "\"{words}\" negates the condition; say the state the rule applies in, or write the exception as a rule of its own"
      words: field(String)
      | Reported as [negated_condition] says.
    }
  }
}
