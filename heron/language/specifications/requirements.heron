requirements: section {
  | The specification [layer](#heron.language.specifications.layers.layer) says what must hold of the product, from outside, in its own
  | words. A rule states one behaviour of one subject, a constraint limits the solution for a
  | stated reason, a part names a party inside the boundary that rules bind, and a scenario
  | illustrates a rule with a case or measures a quality. Use cases, with their own notation,
  | are [the next section](#language.specifications.usecases). Every one is a node,
  | `name: kind(args)`, and links up to what it serves.
  | [The refund window](#language.specifications.requirements.specifications_example) is a
  | complete area written this way.
  |
  | | Strength    | Polarity | Reads      |
  | | ----------- | -------- | ---------- |
  | | `must`      | positive | must       |
  | | `should`    | positive | should     |
  | | `may`       | positive | may        |
  | | `mustNot`   | negative | must not   |
  | | `shouldNot` | negative | should not |
  |
  | | Condition | Says                                                    | In one rule      |
  | | --------- | ------------------------------------------------------- | ---------------- |
  | | `where`   | the optional feature the rule applies with              | at most one      |
  | | `while`   | a state the rule applies in                             | any number       |
  | | `when`    | the trigger that makes the rule apply                   | at most one trigger, `when` or `if` |
  | | `if`      | the unwanted situation the rule answers                 | as above         |
  | | `then`    | the consequence guaranteed once the rule has applied    | at most one      |
  | | `instead` | under a negative strength only, the intended alternative | at most one     |
  |
  | A rule with no condition always holds. An exception is a state: `while` with the state in
  | which the rule applies, or a rule of its own for the exceptional case.

  rule_kind: term {{
    `rule(targets, by = subject, serves = [goals]) { … }`, one behaviour in one strength node
    and the conditions that say when it applies. Its targets are the nodes it binds, and a change
    to one of them finds the rule. `derives` names the rules it's derived from, `relies` the
    assumptions it depends on, `rationale` says in one line why it holds, and `rev` is its
    [revision](#heron.language.specifications.layers.revisions.revision).
  }}

  rule_strength: term {{
    The node that says what a requirement asks and holds the behaviour as text, as in
    ``must {{ reject the request with the refund window's error }}``. The renderer puts the
    strength's words in front of the text, so the text starts with the verb.
  }}

  rule_condition: term {{
    A child of a rule from `std/spec`'s `condition` category: one of the six in the [table](#heron.language.markup.components.table), or
    one another package adds to the category.
  }}

  rule_subject: term {{
    What a rule's `by` names: an actor or a part whose behaviour the rule states. A rule
    without `by` binds the system as a whole, or the instances of a type it targets.
  }}

  state_property: term {{
    A rule with no condition, such as `single_sale: rule { must {{ sell a pet at most once }} }`:
    it holds at every point the product can be observed. The type that holds the state names
    it with `@realizes`.
  }}

  constraint_kind: term {{
    `name: constraint(reason = "…") { must {{ … }} }`, a limit on the solution with a reason
    from outside it, such as a regulation or a platform the product must run on: the one
    requirement that needs no goal to serve.
  }}

  part_kind: term {{
    `name: part {{ … }}`, a party inside the boundary that rules bind, named by the role it
    plays as seen from outside: what it reads, answers and reports. It's no architecture: how a
    part is built, and whether it's a module, a process or a library, is the implementation's
    business.
  }}

  scenario_kind: term {{
    `name: scenario(illustrates = rule) { given {{ … }} when {{ … }} then {{ … }} }`, an
    outcome scenario: one case of one rule or one path of a use case, declarative and short; or,
    with `stimulus`, `environment`, `response` and `measure` and `serves` a quality, a quality
    scenario: the measurable form of that quality.
  }}

  spec_layer: rule(requirements, by = system.checker) {
    must {{ give `rule`, `constraint`, `part`, `term`, `scenario`, `usecase`, `states` and `transition` the `SPECIFICATION` [layer](#language.specifications.layers.layer) }}
  }

  one_strength: rule(rule_kind, by = system.checker) {
    if {{ a rule holds a second strength node }}
    must {{ report that it accepts at most one, at the second }}
    example {{ a rule with `must` and `should` reports "rule accepts at most 1 strength node" }}
  }

  conditions_once: rule(rule_condition, by = system.checker) {
    if {{ a rule holds a second `where`, `then` or `instead`, or a second trigger, `when` or `if` }}
    must {{ report that it accepts at most one, at the second }}
    then {{ `while` and the conditions of another package repeat freely, and a rule with no condition always holds }}
  }

  instead_only_negative: rule(rule_condition, by = system.checker) {
    if {{ `instead` stands in a rule whose strength is positive, or that has no strength }}
    must {{ report it as an error at the `instead` }}
  }

  subject_actor_or_part: rule(rule_subject, by = system.checker) {
    if {{ a rule's `by` names a node that is neither an actor nor a part, nor of a kind that extends one }}
    must {{ report it as an error at the reference }}
  }

  prose_only_rules: rule(rule_kind, by = system.checker) {
    may {{ hold only prose, as `rule(targets) {{ The system must … }}` }}
    then {{ it checks clean and renders as its text, with no sentence built from nodes }}
  }

  constraint_reason: rule(constraint_kind, by = system.checker) {
    if {{ a constraint has no `reason`, or an empty one }}
    must {{ report it as an error at the constraint }}
  }

  scenario_one_form: rule(scenario_kind, by = system.checker) {
    if {{ a scenario has both outcome clauses (`given`, `when`, `then`) and quality fields (`stimulus`, `environment`, `response`, `measure`), or neither }}
    must {{ report it as an error at the scenario }}
  }

  outcome_illustrates_one: rule(scenario_kind, by = system.checker) {
    if {{ an outcome scenario's `illustrates` is missing, or names something other than one rule or one path of a use case }}
    must {{ report it as an error at the scenario }}
  }

  quality_scenario_measured: rule(scenario_kind, by = system.checker) {
    if {{ a quality scenario has no `measure`, or serves no quality }}
    must {{ report it as an error at the scenario }}
  }

  ears_sentence: rule(rule_kind, by = system.docs_generator) {
    must {{ render a rule's strength, conditions and consequences as one sentence: `where`, each `while`, then `when` or `if`, in that order, then the subject and the strength's words with the behaviour, then each `then` after ", so", then `instead` after ", and must instead", the clauses of one condition joined with "and" }}
    example {{ "When a refund is requested, if the capture date is past, `desk` must reject the request, so the customer is told at once." }}
  }

  no_repeated_connective: rule(rule_kind, by = system.docs_generator) {
    where {{ the text of a rule's `then` or `instead` already holds the connective the [rule's sentence](#language.specifications.requirements.ears_sentence) would join it with, as a `then` that reads "the nearest declaration wins, so a section named `grammar` hides a kind of that name" }}
    must {{ end the sentence before that clause and render the clause as the next sentence of the paragraph, starting with a capital }}
    then {{ no sentence reads ", so … so" or "instead … instead" }}
  }

  subject_words: rule(rule_subject, by = system.docs_generator) {
    must {{ name a part, an actor or a term as "the" and its name in words, a targeted type as "a" or "an" and its name in words, and anything else as "the system" }}
  }

  rationale_shown: rule(rule_kind, by = system.docs_generator) {
    must {{ show a rule's or a constraint's rationale or reason after its sentence, and the goals it serves, the rules it derives from and the assumptions it relies on as links in its facts }}
  }

  examples_after_sentence: rule(rule_kind, by = system.docs_generator) {
    must {{ follow a rule's sentence, in the same paragraph, with each of its examples as a sentence of its own after the word the [string catalogue](#tools.frontend.writing.string_catalogue) holds for an example, and each condition another package adds as a sentence after its kind's [display name](#language.core_format.naming.display_name) }}
  }

  scenario_view: rule(scenario_kind, by = system.docs_generator) {
    must {{ render an outcome scenario as its given, when and then clauses under its name, with the rule or path it illustrates, and a quality scenario as its stimulus, environment, response and measure with the quality it serves }}
  }

  part_view: rule(part_kind, by = system.docs_generator) {
    must {{ show a part with its prose and the [derived list](#heron.language.specifications.layers.derived_list) of the rules that bind it }}
  }

  conditions_used_for_their_sense: rule(rule_condition, by = actors.author) {
    must {{ write a consequence as `then`; an exception as a positive state the rule applies in, as `while {{ the file is unsaved }}`, or, where the exception is a behaviour of its own, as a rule of its own with its own `when` or `while`; and a clarification as an `example` or prose }}
  }

  one_behaviour: rule(rule_kind, by = actors.author) {
    should {{ state one behaviour in a rule, and two obligations as two rules }}
  }

  rationale_in_place: rule(rule_kind, by = actors.author) {
    should {{ give a rule whose reason isn't plain from the goal it serves a `rationale` of one line, and edit it in place when the reason changes }}
    then {{ the spec keeps why a rule holds next to the rule, and no separate log of decisions is needed }}
  }

  part_not_architecture: rule(part_kind, by = actors.author) {
    must {{ name a part only where it's observable from outside or meaningful to an actor, such as something an operator configures, and bind every other rule to the system }}
    then {{ a part says whose behaviour a rule states and never how the product is divided into code }}
  }

  structural_strength: rule(rule_strength, by = system.generator) {
    must {{ list positive rules as what an implementer builds, ask negative rules of deciders as questions with `instead` as the expected answer, and turn examples into cases when verification is generated }}
  }

  errors: section {
    @realizes(instead_only_negative)
    @display("Instead under a positive strength")
    instead_positive: error("instead", by = system.checker) {
      title = "instead stands only under a negative strength, and {strength} is positive"
      strength: field(String)
      | An `instead` in a rule whose strength is `must`, `should` or `may`; with no strength, the title ends "`mustNot` or `shouldNot`".
    }

    @realizes(subject_actor_or_part)
    @display("Subject not an actor or a part")
    not_a_subject: error("type", by = system.checker) {
      title = "{name} is a {kind}; a rule's by names an actor or a part"
      name: field(String)
      kind: field(String)
    }

    @realizes(constraint_reason)
    @display("Constraint without a reason")
    constraint_without_reason: error("missing-argument", by = system.checker) {
      title = "constraint {name} needs a reason from outside the solution"
      name: field(String)
    }

    @realizes(scenario_one_form, outcome_illustrates_one, quality_scenario_measured)
    @display("Scenario of no form")
    scenario_form: error("scenario", by = system.checker) {
      title = "scenario {name} {problem}"
      name: field(String)
      problem: field(String)
      | "mixes outcome clauses and quality fields", "has neither outcome clauses nor quality fields", "illustrates nothing", "illustrates more than one rule or path", "has no measure" or "serves no quality".
    }
  }

  @display("The refund window")
  specifications_example: example {
    | ```heron
    | import = ["std/doc@1", "std/types@1", "std/spec@1", "std/apis@1", "std/http@1"]
    |
    | self_service: goal {{ Customers fix a wrong charge themselves. }}
    |
    | responsive: quality {{ Refunds feel instant. }}
    |
    | desk: part {{ The support console. }}
    |
    | capture_date: term {{
    |   The moment a payment was captured. Partial refunds don't change it.
    | }}
    |
    | refund_window: section {
    |   | Customers can request a refund for a captured payment within *30 days*
    |   | of its [capture date](#capture_date), without contacting support.
    |
    |   no_currency_change: nongoal {{ Refunds into a different currency than the capture. }}
    |
    |   @display("Reject late refunds")
    |   late_rejected: rule(by = desk, serves = [self_service], rationale = "Card networks dispute older refunds.") {
    |     while {{ the payment is under no chargeback or fraud review }}
    |     if {{ a refund arrives more than 30 days after the [capture date](#capture_date) }}
    |     must {{ reject the request }}
    |
    |     example {{ requested on day 30: accepted }}
    |     example {{ requested on day 31: rejected }}
    |   }
    |
    |   disputes_to_support: rule(by = desk, serves = [self_service]) {
    |     when {{ a refund is requested for a payment under a chargeback or fraud review }}
    |     must {{ hand the request to support }}
    |     then {{ the customer gets a ticket number }}
    |   }
    |
    |   late_on_day_31: scenario(illustrates = late_rejected) {
    |     given {{ a payment captured 31 days ago }}
    |     when {{ the customer asks for a refund }}
    |     then {{ the request is rejected and the payment is unchanged }}
    |   }
    |
    |   refund_speed: scenario(serves = [responsive]) {
    |     stimulus =| a customer asks for a refund
    |     environment =| normal load
    |     response =| the refund is answered
    |     measure =| within 200 ms at the 99th percentile
    |   }
    |
    |   card_rules: constraint(reason = "The card networks' rules for refunds.") {
    |     must {{ refund to the card the payment was captured from }}
    |   }
    | }
    |
    | payments: api {
    |   @realizes(refund_window.late_rejected)
    |   create_refund(amount: Int): op(Payment) {{
    |     Creates a refund for a captured payment, subject to the [refund window](#refund_window).
    |   }}
    | }
    | ```
  }
}
