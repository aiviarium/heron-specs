lifecycles: section {
  | A field whose value moves through states, such as a payment's status, is modelled once
  | as a [lifecycle](#language.specifications.lifecycles.lifecycle): its first state, its
  | last ones and every change allowed between them. Ops point at the changes they make, so
  | the model never names the surface and the dependency runs from the surface to the model.

  lifecycle: term {{
    `states(field) { … }`, the lifecycle of an enum field such as `Payment.status`, with
    `initial`, `terminal`, and one named `transition(from, to) { … }` per allowed change.
  }}

  transition_kind: term {{
    `name: transition(from, to) { … }`, one allowed change between two variants of the enum
    the [lifecycle](#language.specifications.lifecycles.lifecycle) models. Its body takes the conditions a rule takes, such as `when` for what
    causes it, but no strength: a transition is allowed, not required.
  }}

  performs_annotation: term {{
    `capture(id: String): op(Payment, payment_lifecycle.captured)`, an op's
    [hard reference](#language.specifications.layers.references.hard_reference) to a transition
    it may cause: an op that references a transition performs it.
  }}

  transition_variants: rule(system.checker) {
    must {{ resolve a transition's `from` and `to` as variants of their enum, and report an unknown one as unresolved }}
    example {{ `transition(Status.OPEN, Status.GONE)` reports "Status has no member GONE" }}
  }

  transition_body: rule(system.checker) {
    must {{ report doesn't accept at a strength in a transition's body }}
  }

  lifecycle_view: rule(system.docs_generator) {
    must {{ show a [lifecycle](#language.specifications.lifecycles.lifecycle) as a diagram of its states and transitions, with a [table](#heron.language.markup.components.table) beside it of each transition's name, its from and to states and the ops that perform it }}
    then {{ a transition no op performs shows "No op" in the [table](#heron.language.markup.components.table) }}
  }

  lifecycle_field_enum: rule(system.checker) {
    if {{ the field a [lifecycle](#language.specifications.lifecycles.lifecycle) names isn't of an enum type, or a transition's variants aren't of the field's enum }}
    must {{ report not an enum field at the field or the variant }}
  }

  closed_model: rule(system.interpreter) {
    when {{ a run observes a change of a modelled field }}
    must {{ fail the check of the run unless the change is a transition the op performing it references }}
  }

  lifecycle_lints: rule(system.linter) {
    should {{ report incomplete [lifecycle](#heron.language.specifications.lifecycles.lifecycle) for a state with no way in or out, a transition no op performs, and an op that changes the field without referencing a transition }}
  }

  errors: section {
    @display("Not an enum field")
    not_enum_field: error("lifecycle") {
      title = "{field} isn't of an enum type, so it has no states"
      field: field(String)
      | A [lifecycle](#language.specifications.lifecycles.lifecycle) on a field whose values aren't a closed set.
      | Reported as [language.specifications.lifecycles.lifecycle_field_enum] says.
    }

    @display("Incomplete lifecycle")
    @severity(warning)
    incomplete_lifecycle: error("lifecycle") {
      title = "{state} of {lifecycle} can't be reached"
      state: field(String)
      lifecycle: field(String)
      | A state, transition or op the [lifecycle](#language.specifications.lifecycles.lifecycle) doesn't connect; the message names which.
      | Reported as [language.specifications.lifecycles.lifecycle_lints] says.
    }
  }
}
