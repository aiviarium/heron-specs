@display("Verify, status and coverage")
traceability: section {
  | A requirement is proved by the test or script a `verify` names, and test links live
  | only on the implementation's side: a project that imports the spec names the
  | requirements each test proves, in a `proves` node of `std/project`, and the spec itself
  | never names a test. One written ahead of its code says so with the
  | [planned status](#language.specifications.traceability.status_flag). The two together
  | say what's built, what's proved and what's still to build, so a reader never has to
  | guess whether a rule describes the code or the plan.

  verify_kind: term {{
    `verify(path, test = …)`, `std/project`'s link from a `proves` node to the file that
    proves the requirements the node names, relative to the implementation repository's
    root, and the test or step in it. A `proves` takes any number of them, as do the
    project's own components and invariants; a spec names none.
  }}

  status_flag: term {{
    One of `std/product`'s flags in the group `"status"`: `<planned>`, `<started>`,
    `<delivered>` and `<deferred>` on an epic, a story, a use case, an increment or a
    milestone, and `<planned>` alone on a rule, a component or a diagnostic.
  }}

  coverage: term {{
    What a requirement, a section, a [passage](#language.specifications.context.passage)
    or an op is covered by: scenarios, reviews, [op examples](#language.apis.examples.op_example)
    and measurements, through `@covers`.
  }}

  verify_shown: rule(verify_kind, by = product.system.docs_generator) {
    must {{ list the `verify` links of the proofs that name a requirement under it as "Verified by", each its path and its test as code }}
  }

  status_shown: rule(status_flag, by = product.system.docs_generator) {
    must {{ show a node's [status flag](#language.specifications.traceability.status_flag) as a quiet mark beside its name }}
  }

  status_placement: rule(status_flag, by = product.system.linter) {
    should {{ report [flag placement](#language.schemas.flags.diagnostics.flag_misplaced) at a [status flag](#language.specifications.traceability.status_flag) outside its `on`, such as `<delivered>` on a rule }}
  }

  planned_has_no_verify: rule(status_flag, by = product.actors.author) {
    mustNot {{ name a `<planned>` rule, component or diagnostic in a `proves` that has a `verify` link }}
    instead {{ take the flag off in the change that builds the behaviour, and add its proof in that change }}
  }

  verify_paths_exist: rule(verify_kind, by = product.system.linter) {
    if {{ a `verify` names a file that doesn't exist, or a test the file doesn't declare }}
    should {{ report [missing proof](#language.specifications.traceability.diagnostics.missing_proof) at the `verify` }}
  }

  traceability_page: rule(verify_kind, by = product.system.docs_generator) {
    must {{ render a page that lists every requirement with its status and the `verify` links of its proofs, and the requirements nothing proves }}
  }

  uncovered_shown: rule(coverage, by = product.system.linter) {
    must {{ show the requirements nothing covers in editors and in CI }}
  }

  diagnostics: section {
    @display("Missing proof")
    missing_proof: diagnostic("verify", severity = warning, by = product.system.linter) {
      message = "verify names ‹path›, which doesn't exist"
      | A `verify` whose file or test is gone; the message names the test when the file is there and the test isn't.
    }
  }
}
