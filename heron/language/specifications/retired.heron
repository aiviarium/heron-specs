@display("Retired kinds")
retired: section {
  | Each concept has one kind. The kinds that duplicated another are retired: using one is an
  | error that names the kind to write instead, with a fix where the change is mechanical.
  | Delivery, the planning of work into increments, lives in the implementation's project.
  |
  | | Retired                                   | Write instead                                                       | Fix |
  | | ----------------------------------------- | ------------------------------------------------------------------- | --- |
  | | `invariant`                               | a `rule` with no condition                                           | yes |
  | | `obligation`                              | a `rule` whose `by` is a part                                        | yes |
  | | `criterion`                               | a `scenario` that illustrates one rule or path                       | yes |
  | | `component`, in a spec                    | a `part`                                             | yes |
  | | `unless`                                  | `while` with the state the rule applies in, said positively, or a rule of its own for the exception's behaviour | no  |
  | | `epic`                                    | the goals an area opens with                                         | no  |
  | | `raises`, `diagnostic`, `exit`            | an `error`, with its projection                                      | no  |
  | | `metric`, `quality` bounds                | a quality scenario with a `measure`                                  | no  |
  | | `outOfScope`                              | a `nongoal`                                                          | yes |
  | | `story`, `increment`, `milestone`, `done` | the same kinds of `std/project`, in the implementation's project     | no  |
  | | `std/product`, `std/tech`                 | `std/spec`, which holds their kinds                                  | yes |

  retired_kind: term {{
    A kind a standard package still declares, with `@retired(use = "…")`, so a tree that uses
    it gets the error that says what to write instead rather than "unknown kind".
  }}

  retired_reported: rule(retired_kind, by = system.checker) {
    if {{ a node is of a [retired kind](#language.specifications.retired.retired_kind) }}
    must {{ report it as an error at the kind's name, naming the kind to write instead }}
  }

  retired_fix: rule(retired_kind, by = system.checker) {
    where {{ the [table](#heron.language.markup.components.table) marks the change as mechanical }}
    must {{ offer the fix that rewrites the kind's name, and the condition-free form for `invariant` }}
    then {{ `heron lint -fix` migrates those nodes and leaves the others to their author }}
  }

  retired_packages: rule(retired_kind, by = system.checker) {
    if {{ a tree imports `std/product` or `std/tech` }}
    must {{ report it as an error at the import, with the fix that imports `std/spec` in its place }}
  }

  unless_rewritten: rule(retired, by = actors.author) {
    when {{ a rule with an `unless` is migrated }}
    must {{ state the condition positively, as `unless {{ a session is open }}` becomes `while {{ the server is idle }}`, or split the exception into a rule of its own with its own `when` or `while` where it has a behaviour of its own }}
  }

  unless_not_negated: rule(retired, by = actors.author) {
    when {{ a rule with an `unless` is migrated }}
    mustNot {{ write the old exception negated, as "it's not the case that" or a double negation }}
    instead {{ say the state the rule applies in, as the people who use the product would }}
  }

  delivery_in_project: rule(retired, by = actors.author) {
    must {{ plan the work in the implementation's project, as `story` nodes that list the spec items they add or change and `increment` and `milestone` nodes that deliver them, and keep no delivery in the spec }}
  }

  errors: section {
    @realizes(retired_reported, retired_fix)
    @display("Retired kind")
    retired_kind_used: error("retired", by = system.checker) {
      title = "{kind} is retired; {instead}"
      kind: field(String)
      instead: field(String)
      | As "invariant is retired; write a rule with no condition".
    }

    @realizes(retired_packages)
    @display("Retired package")
    retired_package: error("retired", by = system.checker) {
      title = "{package} is merged into std/spec; {instead}"
      package: field(String)
      instead: field(String)
    }
  }
}
