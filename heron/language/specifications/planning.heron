@display("Open questions")
planning: section {
  | While a spec takes shape it has questions still to answer. An answered question becomes
  | the requirement it asked about, so the question itself would only put an old doubt in
  | front of an implementer; open questions are kept apart, in a
  | [planning tree](#language.specifications.planning.planning_tree) that imports the spec.

  planning_tree: term {{
    A tree of its own, with an [entry point](#language.core_format.files.entry_point) such
    as `planning/index.heron`, that imports the spec tree so its questions can name real
    targets.
  }}

  open_kind: term {{
    `name: open(targets, owner = …) {{ … }}`, a question still to answer about its
    targets, asked in its text, with `owner` naming who answers it.
  }}

  open_view: rule(open_kind, by = product.system.docs_generator) {
    must {{ show an open question as a callout labelled "Open question", with its owner and its targets }}
  }

  open_beside_flag: rule(open_kind, by = product.actors.author) {
    where {{ a file imports `std/types` beside `std/spec` }}
    must {{ write an open question as `spec.open(…)` }}
    then {{ the name `open` can't resolve to the `<open>` flag `std/types` gives records, which "open is not a kind or a type" reports }}
  }

  spec_never_imports_planning: rule(planning_tree, by = product.actors.author) {
    mustNot {{ import the [planning tree](#language.specifications.planning.planning_tree) from the spec tree }}
    instead {{ let the [planning tree](#language.specifications.planning.planning_tree) import the spec, so the spec never loads its questions }}
  }

  resolving_translates: rule(open_kind, by = product.actors.author) {
    when {{ an open question is answered }}
    must {{ write the requirement or the `outOfScope` it was about, and delete the question }}
  }

  planning_checks: rule(planning_tree, by = product.system.linter) {
    should {{ report open questions on targets about to ship }}
  }

  @display("A planning file")
  specifications_planning: example {
    | ```heron
    | // planning/refunds.heron
    | import = ["std/spec@1", "../refunds/"]
    |
    | open(refunds.refund_window, owner = "cf") {{
    |   Do partial refunds reset the window?
    | }}
    | ```
  }
}
