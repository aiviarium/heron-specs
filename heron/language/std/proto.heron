@display("std/proto")
proto: component(path = "std/proto", lang = "heron") {
  | Binds apis to gRPC services and types to protobuf messages.
  |
  | Its surface is declared in `std/proto/package.heron`, whose types the API reference renders.
  | `@proto`, `@field` and `@reserved` are specified in [Encodings](#language.data.encodings) and [transports](#language.apis.transports).

  uses = [language.std.types]
}
