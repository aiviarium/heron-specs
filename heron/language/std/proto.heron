@display("std/proto")
proto: component(path = "std/proto", lang = "heron") {
  | Binds apis to gRPC services and types to protobuf messages.
  |
  | Its surface is declared in `std/proto/package.heron`, whose types the API
  | reference renders; each export is specified where its behaviour is:
  |
  | | Export                          | Specified in                                                                   |
  | | ------------------------------- | ------------------------------------------------------------------------------ |
  | | `@proto`, `@field`, `@reserved` | [Encodings](#language.data.encodings), [transports](#language.apis.transports) |

  uses = [language.std.types]
}
