// The standard packages: one file per package, its surface and its rules.
include = [
  "./core.heron",
  "./schema.heron",
  "./types.heron",
  "./doc.heron",
  "./docs.heron",
  "./spec.heron",
  "./grammar.heron",
  "./lint.heron",
  "./json.heron",
  "./http.heron",
  "./ws.heron",
  "./proto.heron",
  "./jsonrpc.heron",
  "./sparrow.heron",
  "./apis.heron",
  "./process.heron",
  "./files.heron",
  "./repo.heron",
  "./project.heron",
]

@lens(user, developer)
| The standard packages Heron ships. Each is Heron source under `std/` in the repository, a
| [feature](#language.specifications.context.feature_kind) here with its purpose and
| where each of its exports is specified.
| The package files are the one statement of the surface: the API reference renders their
| types, and this tree links to them rather than repeating them. Only the primitive types are
| built into `heron`, as the [prelude](#language.core_format.imports.packages.prelude) says.
| The core is `std/core` with `std/spec`; every other package, `std/project`, `std/grammar` and
| `std/http` among them, is optional and imported by the trees that need it. Standard packages
| import no package in a cycle, besides the ones
| [import cycles](#language.core_format.imports.packages.import_cycle) allow among the core and
| the packages it's written with.

embedded_copy: rule(system.checker) {
  must {{ resolve an import `std/<name>@<major>` to `<name>/package.heron` in the copy of `std/` embedded in the binary, with the files it includes, and identify each of them as `std:` and its path }}
  then {{ a tree checks with no standard package installed, and one file of a package has one identity however it's reached }}
}

checked_like_any: rule(system.checker) {
  must {{ read, resolve and type-check a standard package as the Heron source it is, by the same rules as any package, and report its problems as the importing tree's diagnostics }}
  then {{ no kind, type or annotation of a standard package is special to the checker, besides the primitive types }}
}

std_versions: rule(actors.implementer) {
  must {{ raise a standard package's major `version` when a change to its surface can break a tree that imports it, and its minor version when the change only adds to it }}
  example {{ adding `FileError` to `std/files` adds to it; renaming `read` breaks trees and makes it `std/files@2` }}
}

std_surface_reviewed: rule(actors.implementer) {
  must_not {{ add to a standard package surface that no spec node specifies }}
  instead {{ specify the export where its behaviour belongs and link it from the package's component here }}
}

newer_copy_wins: rule(system.checker) {
  when {{ a copy of a standard package with the same major version and a newer minor version is installed than the one built into the binary }}
  must {{ use the installed copy, keeping the embedded one as the fallback }}
}

batteries: goal(measure = "A tree checks with no package installed.") {{
  Every tree has the standard kinds it needs without installing anything.
}}
