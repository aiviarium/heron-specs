// The language: its format, grammar and packages.
include = [
  "./core_format/",
  "./grammar/",
  "./schemas/",
  "./markup/",
  "./data/",
  "./apis/",
  "./specifications/",
  "./scripting/",
  "./interop/",
  "./std/",
]

@display("APIs")
apis {}

@display("Standard packages")
std {}

@lens(user, developer)
| The Heron language: the core format and its grammar, the packages that give it kinds, and the standard packages.

one_format: goal(measure = "One parser reads every Heron file.") {{
  A team writes specs, the kinds its packages add, data, APIs and tasks in one plain-text format it reads, reviews and diffs like code.
}}
