@display("Funcs, macros and templates")
funcs_and_templates: section {
  | A func computes a value, a macro writes source, and a template is the string a macro
  | writes it from. [A func and a macro](#language.scripting.funcs_and_templates.scripting_example)
  | shows one of each.

  func_kind: term {{
    A logical function, the prelude's `func`, with the same signature shape as an op:
    parameters for its inputs and its [result type](#language.apis.responses.result_type)
    as the first argument, `func(Order)`. One expression is written with `=`; one that
    needs steps takes a `do` body, where `return` gives the result. It can also be bound to
    a [foreign func](#language.interop.declaring.foreign_func) with `= module.export`, or
    declared with no body for `heron` itself or an extension to implement by its path.
  }}

  pure_func: term(aliases = ["pure func"]) {{
    A func marked `<pure>`, as `shout(text: String): func<pure>(String)`: one whose result
    depends on its arguments alone, so it may run while the tree is evaluated and its
    results can be kept.
  }}

  macro_kind: term {{
    The prelude's `macro`: source produced from a [template](#language.scripting.funcs_and_templates.macro_template),
    `= (heron)"""…"""`. A macro that branches or loops takes a `do` body and calls
    `emit(…)` for each piece.
  }}

  macro_template: term {{
    A quoted string, usually a `heron` [embedded string](#language.grammar.strings.embedded.embedded_string),
    whose `$name` and `${expr}` inserts are filled from a macro's arguments.
  }}

  evaluation: term {{
    Working out a value the tree declares, as `a: String = shout(text = "hi")`, or the
    source a macro produces, rather than running code on purpose.
  }}

  funcs: section {
    @by(system.interpreter)
    @targets(func_kind)
    func_forms: rule {
      must {{ give a call the value of the func's `=` expression, or of the `return` that ends its `do` body, and null when the body ends without one }}
    }

    @by(system.interpreter)
    @targets(func_kind)
    bodiless_registered: rule {
      where {{ a func has no body and no value }}
      must {{ call what `heron` itself or an extension registered under its path in the declaring package, such as `process.run` or `repo.ensure_toolchain` }}
    }

    @by(system.interpreter)
    @targets(evaluation)
    values_once: rule {
      must {{ evaluate a node's value the first time code reads it, and keep it for the rest of the run }}
    }

    @by(system.interpreter)
    @targets(pure_func)
    pure_only_while_evaluating: rule {
      if {{ a [foreign func](#language.interop.declaring.foreign_func) that isn't `<pure>` is called during [evaluation](#language.scripting.funcs_and_templates.evaluation) }}
      must {{ fail with isn't pure }}
      then {{ a value of the tree never depends on a side effect }}
    }

    @by(system.interpreter)
    @targets(pure_func)
    pure_cache: rule {
      must {{ keep each result of a pure [foreign func](#language.interop.declaring.foreign_func) for the run, by a hash of its path and its arguments as plain data, and answer a call with equal arguments from it without calling the foreign code }}
      then {{ a value read twice, or by two nodes, costs one call }}
    }

    @by(system.interpreter)
    @targets(pure_func)
    pure_cache_misses: rule {
      mustNot {{ keep the outcome of a call that threw or failed, or of one that took a trailing block }}
      then {{ the next call with those arguments calls the foreign code again }}
    }

    @by(system.interpreter)
    @targets(evaluation)
    no_effects_while_evaluating: rule {
      mustNot {{ start a process, write a file or make a temporary one during [evaluation](#language.scripting.funcs_and_templates.evaluation) }}
      then {{ a value that `run(…)` or `write(…)` would compute fails as a [foreign func](#language.interop.declaring.foreign_func) that isn't pure does }}
    }

    @by(actors.author)
    @targets(language.scripting.funcs_and_templates)
    func_macro_foreign: rule {
      should {{ use a func for a value, a macro for repeated source, and a [foreign func](#language.interop.declaring.foreign_func) for anything that needs a real language }}
    }
  }

  macros: section {
    @by(system.interpreter)
    @targets(macro_kind)
    template_expansion: rule {
      must {{ produce a template macro's source by filling its template from the arguments, with the template's shared indentation removed as any multi-line string's is }}
      example {{ `resource_ops(name = "pet_category", path = "/categories")` writes `list_pet_categorys(@query cursor?: String): op(Page(PetCategory))` from `list_${name}s(…): op(Page(${name.pascal}))` }}
    }

    @by(system.interpreter)
    @targets(macro_kind)
    emit_expansion: rule {
      must {{ produce a `do` macro's source as the pieces its `emit(source)` calls add, in order, joined by line breaks }}
    }

    @by(system.interpreter)
    @targets(macro_kind)
    emit_outside_macro: rule {
      if {{ `emit` is called outside a macro's expansion }}
      must {{ fail with emit outside a macro }}
    }

    @by(system.interpreter)
    @targets(macro_kind)
    expansion_is_evaluation: rule {
      must {{ expand a macro as [evaluation](#language.scripting.funcs_and_templates.evaluation), so only pure [foreign funcs](#language.interop.declaring.foreign_func) run in it }}
    }

    @by(system.checker)
    @targets(macro_kind)
    macro_expansion: rule {
      when {{ a macro is invoked in a body, as `resource_ops(name = "category", path = "/categories")` inside an api }}
      must {{ add what it produces to that body, parsed as if it had been written there, before the body is checked }}
      then {{ a macro can add ops, cases or any other members, and a reference to one of them resolves }}
    }

    @by(system.checker)
    @targets(macro_kind)
    expansion_errors: rule {
      if {{ a macro's source doesn't parse or check where it lands }}
      must {{ report the error at the invocation, with the line of the produced source it came from }}
    }
  }

  errors: section {
    @display("Isn't pure")
    not_pure: error("fault") {
      title = "{path} is a foreign func that isn't <pure>, so it can't run while the tree is evaluated"
      path: field(String)
      | Reported as [language.scripting.funcs_and_templates.funcs.pure_only_while_evaluating] says.
    }

    @display("Emit outside a macro")
    emit_outside: error("fault") {
      title = "emit(…) adds source only inside a macro"
      | Reported as [language.scripting.funcs_and_templates.macros.emit_outside_macro] says.
    }
  }

  @display("A func and a macro")
  scripting_example: example {
    | ```heron
    | import = ["std/types@1", "std/http@1"]
    |
    | @throws(StoreError)
    | place(pet: Pet): func(Order) = store.place_order(request = OrderRequest(pet_id = pet.id))
    |
    | // Adds a list and a get op for a resource, wherever an api body invokes it.
    | resource_ops(name: String, path: String): macro = (heron)"""
    |   @http<get>("$path")
    |   list_${name}s(@query cursor?: String): op(Page(${name.pascal}))
    |
    |   @http<get>("$path/:id")
    |   get_$name(@path id: Int): op(${name.pascal})
    | """
    |
    | store: api {
    |   resource_ops(name = "category", path = "/categories")
    | }
    | ```
  }
}
