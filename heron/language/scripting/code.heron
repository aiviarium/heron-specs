@display("Code in do blocks")
code: section {
  | What code in a `do` block does when it runs: the values it computes with, how it binds
  | and branches, how it calls, and how a run fails. The statements themselves are the
  | grammar's, and [Code](#language.core_format.code_layer) says where code may stand; this
  | section is what `eval` makes of them. Code decides, combines and calls, and real work
  | runs elsewhere, as a [foreign func](#language.interop.declaring.foreign_func) or as a
  | process.

  hook: term {{
    A node that takes a code block directly, as in `setup do { … }`, `before do { … }` or
    `verification do { … }`. `name: task do { … }` and `name(…): func(T) do { … }` are
    nodes whose body is only code, and a node with other members writes `do { … }` among
    them.
  }}

  thrown_error: term {{
    A failure that code can catch: a value of an [error type](#language.data.types.error_type),
    raised by a func or op that declares it with `@throws`, such as `ProcessError` from a
    process that exits non-zero. It ends each enclosing call until an `attempt(…)` keeps
    it as a value.
  }}

  code_fault: term {{
    A mistake in the code itself that shows only as it runs: an operand of the wrong type,
    a division by zero, a missing argument, a func that calls itself. It names the file,
    line and [column](#heron.language.grammar.lexical.column) where it happened, fails the run and is never caught.
  }}

  values: section {
    | Code computes with the values of [Data](#language.data): `Int`, `Float`, `Bool`,
    | `String`, lists, maps, records and null, plus [typed strings](#language.data.typed_strings.typed_string), which carry their
    | language with their text, and references to nodes. A type is a value too, as the
    | first argument of `json.decode(List(Pet), text)`.

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    ints_stay_whole: rule {
      must {{ keep the result of `+`, `-`, `*`, `/` and `%` on two `Int` values an `Int`, dividing whole numbers toward zero, and give a `Float` when either operand is one }}
      example {{ `7 / 2` is `3`, `7 % 3` is `1` and `1.5 + 1` is `2.5` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    division_by_zero: rule {
      if {{ the right operand of `/` or `%` is zero }}
      must {{ fail with division by zero }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    int_overflow: rule {
      if {{ `+`, `-`, `*`, `/`, `%` or unary `-` on `Int` values gives a whole number outside the 64-bit range, or an `Int` literal is outside it }}
      must {{ fail with Int overflow rather than wrap around }}
      example {{ `9223372036854775807 + 1` fails with `9223372036854775807 + 1 overflows Int, a 64-bit integer` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    bools_only: rule {
      must {{ take only a `Bool` as the condition of `if` and the operand of `and`, `or` and `not`, and fail, saying it needs a `Bool`, for anything else }}
      then {{ there's no truthiness: `if items.size` fails, and `if not items.empty` is written instead }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    short_circuit: rule {
      must {{ skip the right operand of `and` when the left is `false`, and of `or` when the left is `true` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    operands: rule {
      must {{ define `+` on two numbers, two strings or two lists, which it joins, `<`, `<=`, `>` and `>=` on two numbers or two strings, and fail with operator not defined on any other pair }}
      example {{ `"a" + "b"` is `"ab"`, `[1] + [2]` is `[1, 2]`, `"a" < "b"` is `true` and `1 + "x"` fails }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    structural_equality: rule {
      must {{ compare with `==` and `!=` by structure, an `Int` equal to the `Float` of the same number and a [typed string](#language.data.typed_strings.typed_string) equal to its text }}
      then {{ `==` never fails, and values of different shapes are unequal }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    membership: rule {
      must {{ read `x in c` as an item of a list, a key of a map or a member of a record that's set, or a substring of a `String`, and as `false` when `c` is null }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    type_tests: rule {
      must {{ read `v is T` as true when `v`'s type is `T` or implements the interface `T`, when `T` is `Float` and `v` an `Int`, and when `T` is `Any` and `v` isn't null }}
      example {{ `result.error is ProcessError` and `result.error is Error` are both true for a failed process }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    enum_values: rule {
      must {{ give an enum variant as a value its name, as a `String` }}
      then {{ a variant compares equal to its name, prints as it and is passed to a process as it }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    clock_reading: rule {
      must {{ read `clock.now` from the run's clock alone, as an ISO 8601 time in UTC with milliseconds }}
      then {{ a run given a fixed clock is replayable }}
      example {{ `2026-01-02T03:04:05.000Z` }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.values)
    determinism: rule {
      must {{ reach processes, files, the environment and the time only through the capabilities a run is given }}
      then {{ a run is deterministic given its capabilities' answers, which a test fakes and the run record keeps }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    missing_capability: rule {
      if {{ code runs a process, reads, writes or makes a temporary file, or reads the clock where the run has no such capability }}
      must {{ fail with no capability }}
    }

    @by(system.interpreter)
    @targets(thrown_error)
    conversions: rule {
      must {{ convert one positional argument by calling its target type, `String(x)`, `Int(s)`, `Float(s)` and `Bool(x)`, and throw `ParseError` for text that isn't the number asked for }}
      example {{ `Int("3")` is `3`; `attempt(Int("three")).error.message` reads `"three" is no Int` }}
    }
  }

  members: section {
    | The members code reads on a value, besides a record's fields. A method that isn't one
    | of these is looked up as a func in scope that takes the value first, so
    | `items.total()` calls `total(items)`.
    |
    | | On            | Properties                                                                   | Methods                                                     |
    | | ------------- | ---------------------------------------------------------------------------- | ----------------------------------------------------------- |
    | | `String`      | `size`, `upper`, `lower`, `trimmed`, `pascal`, `camel`, `snake`, `kebab`, `lines` | `contains`, `starts_with`, `ends_with`, `split`, `trim`, `replace` |
    | | list          | `size`, `empty`, `first`, `last`                                             | `contains`, `join`, `get`                                    |
    | | map           | its keys                                                                     | `contains`, `get`                                            |

    @by(system.interpreter)
    @targets(language.scripting.code.members)
    string_case: rule {
      must {{ split a `String` into words at underscores, hyphens, spaces and each upper-case letter that follows a lower-case one, for `pascal`, `camel`, `snake` and `kebab` }}
      example {{ `"pet_category".pascal` is `PetCategory` }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.members)
    absent_members: rule {
      must {{ read a record field or map key that isn't set as null, and `first` and `last` of an empty list as null }}
      then {{ a map's members are its keys, so `counts.size` reads the key `size` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    no_member: rule {
      if {{ code reads a member of null, or a member or method that the value's type doesn't have and no func in scope supplies }}
      must {{ fail with no member }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.members)
    method_fallback: rule {
      where {{ a method isn't one of the value's own }}
      must {{ call the func its name resolves to in scope, with the value as the first positional argument }}
      example {{ `list.contains(x)` is the built-in; `orders.total()` is `total(orders)` }}
    }
  }

  bindings: section {
    | `let name = expr` binds a [local](#language.core_format.nodes.locals.local_term) once,
    | for the rest of its block and the blocks inside it.

    @by(system.interpreter)
    @targets(language.core_format.nodes.locals.local_term)
    bound_once: rule {
      if {{ a block binds a name its own earlier `let` already bound }}
      must {{ fail with already bound }}
      then {{ a nested block may bind the name again, which hides the outer one until the nested block ends }}
    }

    @by(system.interpreter)
    @targets(language.core_format.nodes.locals.local_term)
    fields_not_locals: rule {
      if {{ an assignment's path starts with a local, or is a single name }}
      must {{ fail with locals never change }}
    }

    @by(system.interpreter)
    @targets(hook)
    set_fields: rule {
      when {{ code runs `node.field = value` on a node that exists }}
      must {{ keep the value as that field's for the rest of the run, ahead of what the tree says, and record it }}
      example {{ after `db.ready = true`, `db.ready` reads `true` even where the tree writes `ready = false` }}
    }
  }

  control_flow: section {
    | `if` and `for` are statements and expressions alike: a block's value is the value of
    | its last expression statement.

    @by(system.interpreter)
    @targets(language.scripting.code.control_flow)
    if_value: rule {
      must {{ give `if` the value of the block it runs, and null when the condition is false and there's no `else` }}
      example {{ `let label = if refunds.size == 1 { "refund" } else { "refunds" }` }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.control_flow)
    for_collects: rule {
      must {{ give `for` a list of its block's value for each item, in order }}
      example {{ `let doubled = for amount in amounts { amount * 2 }` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    for_collections: rule {
      must {{ iterate a list or set by its items, a map by its keys in sorted order, and null as empty, and fail with not iterable for anything else }}
      then {{ every loop is finite, since every collection is }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.control_flow)
    return_ends_the_call: rule {
      must {{ end the func, task or [hook](#language.scripting.code.hook) with `return`'s value from any depth of `if` and `for` that stands as a statement or as a `let`'s value }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    return_in_expression: rule {
      if {{ a `return` runs inside an `if` or `for` that is an operand or an argument }}
      must {{ fail with return inside an expression }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    no_recursion: rule {
      if {{ a func or task is called while a call of it is still running, directly or through other calls }}
      must {{ fail with calls itself }}
      then {{ with `for` over finite collections and no `while`, every run of code ends }}
    }
  }

  calls: section {
    | Everything that isn't a binding, a branch or a loop is a call: of a func, a task, an
    | op, a type or a built-in.

    @by(system.interpreter)
    @targets(language.scripting.code.calls)
    argument_binding: rule {
      must {{ bind positional arguments to the parameters in order, a `<variadic>` parameter taking the rest or one list, named ones by name, then each parameter left out to its default, evaluated at the call, or null when it's optional }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    argument_mismatch: rule {
      if {{ a call gives more positional arguments than there are parameters, names a parameter that doesn't exist, or leaves out a required one }}
      must {{ fail with wrong arguments }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.calls)
    type_calls: rule {
      must {{ read a call of a type as a record of it when every argument is named, a conversion when there's one positional value, and a type with arguments when every argument is a type }}
      example {{ `OrderRequest(pet_id = 4)`, `String(42)` and `List(Pet)` }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    bodiless_funcs: rule {
      if {{ a func with no body, no value and no foreign binding is called and nothing is registered under its path }}
      must {{ fail with no implementation }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    uncallable: rule {
      if {{ code calls a node that isn't a func, task, op or type, or calls a macro }}
      must {{ fail with can't be called }}
      then {{ a macro is invoked in structure, where its source lands, never from code }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.calls)
    calls_recorded: rule {
      must {{ record each call of a func or task once it returns, with its arguments, its result or error and how deep it was }}
    }

    @by(system.interpreter)
    @targets(language.scripting.code.calls)
    log_lines: rule {
      must {{ record each `log(message)` as a line of the run and hand it to the run's log, which `heron run` prints on standard error }}
    }
  }

  failures: section {
    | A run fails in one of two ways. A [thrown error](#language.scripting.code.thrown_error)
    | is part of a func's contract and can be handled; a [fault](#language.scripting.code.code_fault)
    | is a bug in the code and can't.

    attempt_func: term {{
      `attempt(call)`, from the prelude, which runs one call and returns a `Result` whose
      `value` is the call's result, or whose `error` is what it threw:
      `let result = attempt(store.place_order(request = request))`.
    }}

    @by(system.interpreter)
    @targets(thrown_error)
    throws_propagate: rule {
      if {{ a call throws }}
      must {{ end each enclosing call and block with the same error, up to the nearest `attempt(…)` or the run }}
    }

    @by(system.interpreter)
    @targets(thrown_error)
    declared_errors: rule {
      must {{ throw only values of [error types](#language.data.types.error_type) a package declares, each implementing `Error` and named by the `@throws` of the func that throws it }}
      then {{ `result.error is FileError` checks where the package is imported, and is true at run time for the error `read` threw }}
      example {{ `std/process` declares `ProcessError`, `std/files` declares `FileError`, `std/json` declares `DecodeError` and `EncodeError`, and the prelude declares `ParseError` for conversions and `ForeignError` for foreign code }}
    }

    @by(system.interpreter)
    @targets(attempt_func)
    attempt_catches_throws: rule {
      must {{ return a `Result` with `error` set when its call throws, and with `value` set, null included, when it returns }}
    }

    @by(system.interpreter)
    @targets(attempt_func)
    attempt_passes_faults: rule {
      mustNot {{ catch a [fault](#language.scripting.code.code_fault) }}
      instead {{ let it fail the run, since retrying code that's wrong can't help }}
    }

    @by(system.interpreter)
    @targets(attempt_func)
    attempt_one_call: rule {
      if {{ `attempt` is given anything but one argument }}
      must {{ fail with attempt takes one call }}
    }

    @by(system.interpreter)
    @targets(code_fault)
    faults_located: rule {
      must {{ give a [code fault](#language.scripting.code.code_fault) the file, line and [column](#heron.language.grammar.lexical.column) of the code that caused it, as `index.heron:2:10: Int + String isn't defined` }}
    }
  }

  steps: section {
    | A call with a trailing block, `check("rejected") { … }`, makes the block a named step
    | of the run, so a test or a deployment reads as the steps it took.

    @by(system.interpreter)
    @targets(hook)
    trailing_block_step: rule {
      when {{ a call takes a trailing block }}
      must {{ run the block as a step named by the call's first positional argument, or by the called name when there is none, and record the step with its value or error once it ends }}
    }

    @by(system.interpreter)
    @targets(hook)
    registered_step_funcs: rule {
      where {{ the callee of a trailing block is a func built into `heron` or implemented in a foreign language }}
      must {{ call it with the block, which it runs as it chooses }}
      then {{ a test framework's `check` can run its block once, retry it or skip it }}
    }

    @by(system.interpreter)
    @targets(hook)
    return_in_step: rule {
      must {{ end only the step at a `return` inside its block, with the returned value as the step's }}
    }

    @by(system.interpreter)
    @targets(hook)
    hooks_in_order: rule {
      when {{ a node's code is run }}
      must {{ run each of its `do` blocks in reading order, with the given values as locals, and stop at the first `return` }}
    }
  }

  errors: section {
    | A [code fault](#language.scripting.code.code_fault) ends the run with its message after `heron run: ‹task› failed: ` and the
    | position, and the run record keeps it as the run's error.

    division_by_zero: error("fault") {
      title = "division by zero"
      | Reported as [language.scripting.code.values.division_by_zero] says.
    }

    @display("Int overflow")
    int_overflow: error("fault") {
      title = "{expression} overflows Int, a 64-bit integer"
      expression: field(String)
      | `9223372036854775807 + 1`, `-(-9223372036854775808)` or a literal such as `99999999999999999999`: the expression or literal is named as written.
      | Reported as [language.scripting.code.values.int_overflow] says.
    }

    @display("Needs a Bool")
    needs_bool: error("fault") {
      title = "{if_and_or_not} needs a Bool, got {type}"
      if_and_or_not: field(String)
      type: field(String)
      | Reported as [language.scripting.code.values.bools_only] says.
    }

    @display("Operator not defined")
    operator_undefined: error("fault") {
      title = "{type} {operator} {type} isn't defined"
      type: field(String)
      operator: field(String)
      | Reported as [language.scripting.code.values.operands] says.
    }

    @display("No capability")
    no_capability: error("fault") {
      title = "no processes can run here"
      | Or `no files can be read here`, `no files can be written here`, `no temporary files
      | can be made here` or `no clock is available to this run`.
      | Reported as [language.scripting.code.values.missing_capability] says.
    }

    @display("No member")
    no_member: error("fault") {
      title = "{type} has no member {name}"
      type: field(String)
      name: field(String)
      | Or `null has no member ‹name›`, or `‹type› has no method ‹name›` for a call.
      | Reported as [language.scripting.code.members.no_member] says.
    }

    @display("Already bound")
    already_bound: error("fault") {
      title = "{name} is already bound in this block; locals never change"
      name: field(String)
      | Reported as [language.scripting.code.bindings.bound_once] says.
    }

    @display("Locals never change")
    locals_never_change: error("fault") {
      title = "{name} is a local, and locals never change; only a node's field can be set"
      name: field(String)
      | Reported as [language.scripting.code.bindings.fields_not_locals] says.
    }

    @display("Not iterable")
    not_iterable: error("fault") {
      title = "for iterates a list, a set or a map, not {type}"
      type: field(String)
      | Reported as [language.scripting.code.control_flow.for_collections] says.
    }

    @display("Return inside an expression")
    return_in_expression: error("fault") {
      title = "return can't stand inside an expression"
      | Reported as [language.scripting.code.control_flow.return_in_expression] says.
    }

    @display("Calls itself")
    calls_itself: error("fault") {
      title = "{name} calls itself; code has no recursion"
      name: field(String)
      | Reported as [language.scripting.code.control_flow.no_recursion] says.
    }

    @display("Wrong arguments")
    wrong_arguments: error("fault") {
      title = "{name} needs the argument {param}"
      name: field(String)
      param: field(String)
      | Or `‹name› takes ‹n› positional arguments` and `‹name› takes no argument ‹param›`.
      | Reported as [language.scripting.code.calls.argument_mismatch] and [language.scripting.tasks.ordering.needed_without_args] say.
    }

    @display("No implementation")
    no_implementation: error("fault") {
      title = "{name} has no body and no implementation is registered for {path}"
      name: field(String)
      path: field(String)
      | Reported as [language.scripting.code.calls.bodiless_funcs] says.
    }

    @display("Can't be called")
    not_callable: error("fault") {
      title = "{path} can't be called: it is no func, task or type"
      path: field(String)
      | Or `macro ‹name› is invoked in structure, not called from code`.
      | Reported as [language.scripting.code.calls.uncallable] says.
    }

    @display("Attempt takes one call")
    attempt_arity: error("fault") {
      title = "attempt takes one call"
      | Reported as [language.scripting.code.failures.attempt_one_call] says.
    }
  }
}
