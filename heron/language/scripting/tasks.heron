tasks: section {
  | A task is something run on purpose: generate files, lint, set up a checkout, deploy,
  | roll back, fix a flaky test. The framework, DevOps and agent workflows declare them the
  | same way, so one command, `heron run`, runs all of them.
  | [Two tasks](#language.scripting.tasks.scripting_tasks) show `@needs` and a flag.

  task_kind: term {{
    `name(params): task do { … }`, the prelude's kind for code run by its path. Like a func
    it can return a value, `task(T)`. Its typed parameters become command-line options and
    form fields: types decide parsing, defaults prefill them and `///` lines explain them.
  }}

  task_flags: term {{
    What a task carries besides its parameters: `<confirm>` asks before it runs,
    `<command>` also exposes it to agent harnesses as a command, `@needs(a, b)` runs other
    tasks first and `@undo(t)` names the task that reverses it, such as a deploy's rollback.
  }}

  finding: section {
    @by(system.command_line)
    @targets(task_kind)
    run_by_path: rule {
      must {{ run a task by its path from the root, as in `heron run seed_local` or `heron run development.production.deploy` }}
    }

    @by(system.command_line)
    @targets(task_kind)
    repository_tasks: rule {
      where {{ no task has the path from the root, and the tree enters `std/repo`'s `repository` }}
      must {{ look the path up inside `repository` }}
      then {{ `heron run setup` runs `repository.setup` }}
    }

    @by(system.command_line)
    @targets(task_kind)
    no_such_task: rule {
      if {{ the path names nothing, or a node that isn't a task }}
      must {{ report no task and exit with status 2 }}
    }

    @by(system.command_line)
    @targets(task_kind)
    checked_first: rule {
      if {{ the tree has an error }}
      must {{ print its errors, run nothing and exit with status 1 }}
    }
  }

  @display("Parameters")
  params: section {
    | A task's parameters are given as `--name value` or `--name=value` after its path,
    | with a `-` in the name read as `_`.

    @by(system.command_line)
    @targets(task_kind)
    params_by_type: rule {
      must {{ parse each option by its parameter's type: an `Int` as a whole number, a `Float` or `Decimal` as a number, a `Bool` as `true` or `false`, an enum as one of its variants' names, a list or set from repeated options and comma-separated values, a record or map from JSON, and anything else as the text given }}
      example {{ `--count 50 --color=BLUE --tags a,b --tags c` gives `50`, `BLUE` and `["a", "b", "c"]` }}
    }

    @by(system.command_line)
    @targets(task_kind)
    bool_switch: rule {
      where {{ a `Bool` option is last or followed by another option }}
      must {{ read it as `true` }}
      example {{ `--dry` }}
    }

    @by(system.command_line)
    @targets(task_kind)
    bad_params: rule {
      if {{ an option names no parameter, has no value, doesn't parse as its type, is given twice for a parameter that isn't a list, or an argument isn't an option }}
      must {{ report bad parameter, run nothing and exit with status 2 }}
    }

    @by(system.command_line)
    @targets(task_kind)
    missing_params_asked: rule {
      when {{ a required parameter without a default isn't given and standard input is a terminal }}
      must {{ ask for it by name and type, as `color (Color): `, and ask again after an answer that doesn't parse, before anything runs }}
    }

    @by(system.command_line)
    @targets(task_kind)
    missing_params_fail: rule {
      if {{ a required parameter isn't given and there's no terminal to ask on, or the input ends before an answer }}
      must {{ report needs a parameter and exit with status 2 }}
    }

    @by(system.interpreter)
    @targets(task_kind)
    defaults_and_optionals: rule {
      must {{ give a parameter that isn't given its default, and an optional one without a default null }}
    }
  }

  ordering: section {
    @by(system.command_line)
    @targets(task_flags)
    needs_annotation: rule {
      where {{ a task has `@needs(…)` }}
      must {{ run each task it names, and theirs in turn, once and before it, in the order the annotations name them, and the asked task last }}
      example {{ `setup` needing `left` and `right`, which both need `base`, runs `base`, `left`, `right`, `setup` }}
    }

    @by(system.command_line)
    @targets(task_flags)
    one_at_a_time: rule {
      must {{ run the tasks of a run one at a time, in that order }}
      then {{ tasks with no path between them may later run in parallel without changing any result a run can rely on }}
    }

    @by(system.command_line)
    @targets(task_flags)
    needed_without_args: rule {
      must {{ run a needed task with its defaults, the options given belonging to the asked task alone }}
      then {{ a needed task with a required parameter fails with wrong arguments }}
    }

    @by(system.command_line)
    @targets(task_flags)
    needs_cycle: rule {
      if {{ `@needs` leads back to a task on the way to it }}
      must {{ report needs a cycle, run nothing and exit with status 2 }}
    }

    @by(system.command_line)
    @targets(task_flags)
    needs_non_task: rule {
      if {{ `@needs` names a node that isn't a task }}
      must {{ report needs no task, run nothing and exit with status 2 }}
    }

    @by(system.checker)
    @targets(task_flags)
    task_refs_checked: rule {
      if {{ `@needs` or `@undo` names a node that isn't a task }}
      must {{ report a type error at the argument, since both take a `Ref(task)` }}
      then {{ the mistake shows in `heron check` and the editor, not only when the task runs }}
    }

    @by(system.interpreter)
    @targets(task_kind)
    task_calls: rule {
      may {{ call another task like a func, in the same run record, and use its return value }}
      then {{ a task called this way runs each time it's called, unlike one it needs }}
    }
  }

  confirming: section {
    @by(system.command_line)
    @targets(task_flags)
    confirm_asks: rule {
      when {{ a task to run, or one it needs, is `<confirm>` }}
      must {{ ask `Run ‹task›? [y/N]` on a terminal before any task runs, and run only on `y` or `yes`, in any case }}
    }

    @by(system.command_line)
    @targets(task_flags)
    declined: rule {
      if {{ the answer is anything else }}
      must {{ report not confirmed, run nothing and exit with status 1 }}
    }

    @by(system.command_line)
    @targets(task_flags)
    confirm_without_terminal: rule {
      if {{ a `<confirm>` task would run, standard input isn't a terminal and `--yes` isn't given }}
      must {{ report asks before it runs, run nothing and exit with status 2 }}
    }

    @by(system.command_line)
    @targets(task_flags)
    yes_flag: rule {
      where {{ `--yes` is given }}
      must {{ run `<confirm>` tasks without asking }}
    }

    @by(system.command_line)
    @targets(task_flags)
    command_flag: rule {
      where {{ a task is `<command>` }}
      must {{ list it among the commands an agent harness is given, by its path, with its parameters and their `///` lines }}
    }
  }

  failing: section {
    @by(system.command_line)
    @targets(task_kind)
    uncaught_throw: rule {
      if {{ a task throws an error nothing catches, or faults }}
      must {{ print `‹task› failed: ‹error›`, run none of the tasks after it and exit with status 1 }}
    }

    @by(system.command_line)
    @targets(task_flags)
    undo_on_failure: rule {
      when {{ a run started with `--undo-on-failure` fails }}
      must {{ run the `@undo` task of every task that already finished in that run, newest first, printing `undoing ‹task› with ‹undo›` for each }}
    }

    @by(system.command_line)
    @targets(task_flags)
    undo_keeps_going: rule {
      if {{ an undo task fails }}
      must {{ print its failure and go on with the next undo }}
      then {{ the run still exits with status 1, for the task that failed first }}
    }

    @by(system.command_line)
    @targets(task_flags)
    no_undo_by_default: rule {
      mustNot {{ undo anything when `--undo-on-failure` isn't given }}
    }

    @by(system.command_line)
    @targets(task_flags)
    stage_undo: rule {
      when {{ a stage of a pipeline fails }}
      must {{ undo the tasks it finished, as `--undo-on-failure` does }}
    }
  }

  results: section {
    @by(system.command_line)
    @targets(task_kind)
    task_results: rule {
      must {{ print a task's return value on standard output once every task has finished: a `String` as it is, anything else as indented JSON, and nothing for null }}
    }

    @by(system.command_line)
    @targets(task_kind)
    json_results: rule {
      where {{ `--json` is given }}
      must {{ print the return value as indented JSON, a `String` and null included }}
    }

    @by(system.interpreter)
    @targets(task_kind)
    runs_recorded: rule {
      must {{ write a `run` record after every run that started, with the task, the entry file, its arguments, each task it ran with its role (needed, task or undo), status and timing, the steps, processes, logs and calls, and its result or error and exit status }}
    }

    @by(system.command_line)
    @targets(task_kind)
    record_failure_warns: rule {
      if {{ the record can't be written }}
      must {{ print `the run wasn't recorded: ‹reason›` and keep the run's own exit status }}
    }
  }

  | Packages contribute tasks, such as `generate`, `lint` and `setup`, and a repository
  | amends them like any node.

  errors: section {
    | `heron run` prints each of these on standard error after `heron run: `.

    @realizes(language.scripting.tasks.finding.no_such_task)
    @display("No task")
    @by(system.command_line)
    no_task: error("run") {
      title = "no task {path}"
      path: field(String)
    }

    @realizes(language.scripting.tasks.params.bad_params)
    @display("Bad parameter")
    @by(system.command_line)
    bad_param: error("run") {
      title = "--{param} takes an Int, not \"{text}\""
      param: field(String)
      text: field(String)
      | Or the message for the type, such as `takes one of RED, BLUE`, or `‹task› takes no
      | parameter --‹name›`, `--‹name› needs a value`, `--‹name› is given more than once` and
      | `unexpected argument ‹arg›; parameters are given as --name value`.
    }

    @realizes(language.scripting.tasks.params.missing_params_fail)
    @display("Needs a parameter")
    @by(system.command_line)
    needs_param: error("run") {
      title = "{task} needs --{param} ({type})"
      task: field(String)
      param: field(String)
      type: field(String)
    }

    @realizes(language.scripting.tasks.ordering.needs_cycle)
    @display("Needs a cycle")
    @by(system.command_line)
    needs_cycle: error("run") {
      title = "@needs forms a cycle: {task} → … → {task}"
      task: field(String)
    }

    @realizes(language.scripting.tasks.ordering.needs_non_task)
    @display("Needs no task")
    @by(system.command_line)
    needs_non_task: error("run") {
      title = "{task} needs {path}, which is no task"
      task: field(String)
      path: field(String)
    }

    @realizes(language.scripting.tasks.confirming.declined)
    @display("Not confirmed")
    @by(system.command_line)
    not_confirmed: error("run") {
      title = "{task} was not confirmed"
      task: field(String)
    }

    @realizes(language.scripting.tasks.confirming.confirm_without_terminal)
    @display("Asks before it runs")
    @by(system.command_line)
    needs_yes: error("run") {
      title = "{task} asks before it runs; pass --yes to run it without a terminal"
      task: field(String)
    }
  }

  @display("Two tasks")
  scripting_tasks: example {
    | ```heron
    | /// Seeds a local store with available pets.
    | seed_local(count: Int = 20): task do {
    |   run("./scripts/seed-pets", args = ["--count", count])
    | }
    |
    | @needs(seed_local)
    | demo: task<confirm> do {
    |   run("pnpm", args = ["dev"])
    | }
    | ```
  }
}
