values: section {
  | Every value has a type, from its literal or from what's expected where it's written.
  | The [core format](#language.core_format.values) says which literal reads as which type;
  | this section names the types and what [absence](#language.data.values.absence) means.
  |
  | | Type                      | Holds                                   | Written as                                   |
  | | ------------------------- | --------------------------------------- | -------------------------------------------- |
  | | `String`                  | text                                    | `"…"`, `"""…"""`, `` `…` ``                  |
  | | `Bool`                    | `true` or `false`                       | `true`                                       |
  | | `Int`                     | a whole number, arbitrary precision     | `30`, `-1`                                   |
  | | `Float`                   | a 64-bit binary float                   | `1.5`, `2e3`                                 |
  | | `Decimal`                 | an exact decimal fraction               | `40.00` where `Decimal` is expected          |
  | | `Bytes`                   | binary data                             | a value a func returns                       |
  | | `Prose`                   | markup text                             | `=\|` or `= {{ }}`                           |
  | | `List(T)`, `Set(T)`       | values in order, or without repeats     | `[a, b]`                                     |
  | | `Map(K, V)`               | values by key                           | `{ key = value }`                            |
  | | a declared type           | a [record value](#language.data.values.record_value)                          | `Refund(id = "r1")`, or `{ id = "r1" }` where it's expected |
  | | `Any`                     | any value                               | anything                                     |
  | | `Null`                    | only `null`                             | `null`                                       |

  scalar: term {{
    `String`, `Bool`, `Int`, `Float`, `Decimal` and `Bytes`. `Int(bits = 32, signed = false)`
    and `Float(bits = 32)` set a size; a plain `Int` has arbitrary precision and a plain
    `Float` is 64-bit.
  }}

  absence: term {{
    A member or parameter marked `name?:` may be absent. Absence belongs to the member,
    never to a value, while `T?` is shorthand for `T | Null`, so `note?: String?` is
    absent, null or a string.
  }}

  any_and_object: term {{
    `Any` holds any value, and `Object` is an untyped map.
  }}

  record_value: term {{
    A constructor call, `BranchPolicy(branch = "main", tests = all)`; an untyped record
    is a map, `{ key = value }`. An array of records of one type is a [table](#heron.language.markup.components.table), and
    renderers show it as one.
  }}

  alias: term {{
    A name for a type, `u8 = Int(bits = 8, signed = false)`. `std/types` predefines
    `u8` to `u64`, `i8` to `i64`, `f32` and `f64`.
  }}

  @by(system.checker)
  @targets(absence)
  required_members: rule {
    if {{ a [record value](#language.data.values.record_value) leaves out a member that has no `?` and no default }}
    must {{ report missing member }}
  }

  @by(system.interpreter)
  @targets(absence)
  absent_read: rule {
    if {{ code reads a member that is absent }}
    must {{ throw, naming the member }}
    example {{ code checks presence first with `payment.has(note)` }}
  }

  @by(system.interpreter)
  @targets(absence)
  defaults_present: rule {
    where {{ a member has a default, as in `currency: String = "EUR"` }}
    must {{ treat it as optional on input and present, with its default, on every value read }}
  }

  @by(system.checker)
  @targets(scalar)
  sized_numbers: rule {
    if {{ an integer literal doesn't fit the `bits` and `signed` of the `Int` expected }}
    must {{ report out of range }}
    example {{ `-1` where a `u8` is expected, and `256` where one is }}
  }

  errors: section {
    missing_member: error("missing-argument") {
      title = "{type} needs the member {name}"
      type: field(String)
      name: field(String)
      | Reported as [language.data.values.required_members] says.
    }

    out_of_range: error("type") {
      title = "{value} doesn't fit {type}, which holds {min} to {max}"
      value: field(String)
      type: field(String)
      min: field(String)
      max: field(String)
      | Reported as [language.data.values.sized_numbers] says.
    }
  }
}
