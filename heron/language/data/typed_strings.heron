typed_strings: section {
  | A few types read a string as their value: where one is expected, `"30d"` is a
  | `Duration` and `"40.00 EUR"` is `Money`. The checker parses the string by the expected
  | type, so a bad one is an error where it's written, not when it's used. Each type's
  | accepted form is exact, given below as a pattern.
  |
  | | Type        | Pattern                                                  | Valid                                         | Invalid                                    |
  | | ----------- | -------------------------------------------------------- | --------------------------------------------- | ------------------------------------------ |
  | | `Duration`  | `(digits ("." digits)? suffix)+`, suffix one of `ms s m h d w` | `30d`, `20m`, `200ms`, `1h30m`, `1.5h`, `2w`  | `thirty days`, `30`, `30 d`, `-5m`, `30D`, `1h 30m`, `P30D` |
  | | `Money`     | `"-"? digits ("." digits)? " " [A-Z]{3}`                 | `40.00 EUR`, `40 EUR`, `-1.5 USD`             | `40 euros`, `EUR 40`, `40.00EUR`, `40.00 eur`, `1,000.00 EUR`, `+40 EUR`, `.5 EUR` |
  | | `Timestamp` | a date, a local date and time, or an RFC 3339 time        | `2026-03-01`, `2026-03-01T09:30:00`, `2026-03-01T09:30:00Z`, `2026-03-01T09:30:00.250+02:00` | `yesterday`, `2026-3-1`, `2026-02-30`, `01.03.2026`, `2026-03-01 09:30:00`, `2026-03-01T09:30` |
  | | `Version`   | `digits "." digits ("." digits)? ("-" ident)?`            | `1.0`, `0.3`, `2.1.4`, `1.0.0-rc1`            | `v1.0`, `1`, `1.0.0.0`, `1.x`              |

  typed_string: term {{
    A string literal written where a type that parses strings is expected, read as that
    type's value. `Duration`, `Money` and `Timestamp` from `std/types` parse strings today; `Version` is
    planned, to be declared there too.
    A string with inserts isn't parsed, since its text is only known when it runs.
  }}

  parsed_where_expected: rule(typed_string, by = system.checker) {
    where {{ a string literal with no inserts, or a [cast](#language.grammar.code.expressions.cast) `(Duration)"30d"`, is written where `Duration`, `Money` or `Timestamp` is expected }}
    must {{ parse it by the expected type's form, and report the type's diagnostic, coded `typed-string`, at the string where it doesn't parse }}
  }

  parsers_by_path: rule(typed_string, by = system.checker) {
    must {{ hold one parser per [typed string](#language.data.typed_strings.typed_string) type, keyed by its type's path in `std/types`: `types.Duration`, `types.Money` and `types.Timestamp` }}
    then {{ a type declared outside `std/` never parses from a string }}
  }

  other_literals: rule(typed_string, by = system.checker) {
    if {{ a literal other than a string, such as `30`, is written where a typed-string type is expected }}
    must {{ report wrong type }}
    while {{ it's not the case that it's a [record value](#language.data.values.record_value) of the type, as `Duration(days = 30)`, which is checked as any record }}
  }

  duration_form: rule(language.data.typed_strings.typed_string, by = system.checker) {
    must {{ accept as a `Duration` one or more parts written together, each digits with an optional `.` and digits, followed by one suffix: `ms` milliseconds, `s` seconds, `m` minutes, `h` hours, `d` days or `w` weeks }}
    example {{ `1h30m` is ninety minutes, and `1.5h` is the same; a suffix is lower case and nothing separates the parts }}
  }

  money_form: rule(language.data.typed_strings.typed_string, by = system.checker) {
    must {{ accept as `Money` an optional `-`, digits, an optional `.` and digits, one space, and three upper-case letters naming the currency }}
  }

  currency_codes: rule(language.data.typed_strings.typed_string, by = system.checker) {
    must {{ accept only a currency code ISO 4217 assigns, and report not money for any other three letters, such as `XYZ` }}
  }

  timestamp_form: rule(language.data.typed_strings.typed_string, by = system.checker) {
    must {{ accept as a `Timestamp` a date `YYYY-MM-DD`, a local date and time `YYYY-MM-DDThh:mm:ss`, or an RFC 3339 time with fractional seconds and a `Z` or `±hh:mm` offset, each a real date on the calendar }}
    then {{ `2026-02-30` and `2026-03-01T09:30`, which has no seconds, are rejected }}
  }

  version_form: rule(language.data.typed_strings.typed_string, by = system.checker) {
    must {{ accept as a `Version` two or three dot-separated runs of digits, optionally followed by `-` and a pre-release name of letters, digits and dots, and order versions by their numbers, with a pre-release before its release }}
    example {{ `1.0` sorts before `1.0.1`, and `1.0.0-rc1` before `1.0.0` }}
  }

  errors: section {
    @realizes(language.core_format.values.strings_parsed_by_type)
    not_a_duration: error("typed-string", by = system.checker) {
      title = "\"{text}\" is not a duration; write a number and a unit, as in \"30d\", \"20m\" or \"200ms\""
      text: field(String)
    }

    @realizes(language.data.typed_strings.currency_codes)
    not_money: error("typed-string", by = system.checker) {
      title = "\"{text}\" is not an amount of money; write the amount and an ISO 4217 currency, as in \"40.00 EUR\""
      text: field(String)
    }

    not_a_timestamp: error("typed-string", by = system.checker) {
      title = "\"{text}\" is not a timestamp; write an RFC 3339 time or a date, as in \"2026-03-01\""
      text: field(String)
    }

    not_a_version: error("typed-string", by = system.checker) {
      title = "\"{text}\" is not a version; write two or three numbers, as in \"1.0\" or \"2.1.4\""
      text: field(String)
    }
  }
}
