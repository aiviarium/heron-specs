@display("Types, enums and unions")
types: section {
  | `std/types` declares the kinds data is modelled with: `type`, `enum`, `union` and
  | `interface`, with errors as types that implement `Error`. [The refunds model](#language.data.types.data_types) shows
  | each of them. How a package declares kinds of its own is under [schemas](#language.schemas.extending_types).

  type_kind: term {{
    A [record](#language.data.values.record_value) declared with `type`. Each member is `name<flags>?: Type = default`, and a
    member's documentation goes in `///` lines above it, since its body would belong to
    its type.
  }}

  enum_kind: term {{
    A closed set of values. Its parameters are the constructor for its values, and each
    variant is a named node of the enum's own type: `CAPTURED: Self(label = "Captured")`,
    or `NAME: Self` without values. `Self` is canonical, and the enum's own name is
    accepted too.
  }}

  error_type: term {{
    An ordinary type that implements `Error`, the interface from `std/types` that brings
    `message: String`. Groups of errors are interfaces that implement `Error`, such as
    `RefundError: interface(Error)`, and a concrete error implements one or more of them:
    `RefundWindowExpired: type(RefundError)`.
  }}

  generic_type: term {{
    A type with type parameters as ordinary parameters, guarded by the type after `:`:
    `Page(T: Any): type { … }`, used as `Page(Refund)`. A guard can intersect interfaces,
    `Sorted(T: Comparable & Listable)`, and types may be recursive, as in
    `replies: List(Comment)` inside `Comment`.
  }}

  union_kind: term {{
    A tagged union with named variants. Each variant name is the stable tag a format
    encodes: the `oneof` field, the JSON discriminator value or the XML element. A bare
    `A | B` stays untagged, for members a value already tells apart, like `String | Int`.
  }}

  interface_kind: term {{
    Shared members and behaviour, as in Kotlin. Its members become part of every type that
    implements it, a default fills a member the type doesn't set, and its funcs are shared
    behaviour that's never encoded. A type's positional arguments are the interfaces it
    implements: `Refund: type(Audited)` is short for `type(implements = [Audited])`.
  }}

  patch_type: term {{
    `Patch(T)`, which makes every member of `T` optional, for updates: an absent member
    stays unchanged and `null` clears it, as in
    `update_refund(id: String, changes: Patch(RefundRequest)): op(Refund)`.
  }}

  @by(system.checker)
  @targets(type_kind)
  closed_records: rule {
    if {{ a constructor call or a [record value](#language.data.values.record_value) sets a member its type doesn't declare }}
    must {{ report no member with the closest member }}
    while {{ the type is closed, as every type without `<open>` is }}
  }

  @by(system.checker)
  @targets(patch_type)
  patch_concretized: rule {
    must {{ read each use of `Patch(T)` as an ordinary record type with every member of `T` optional }}
    then {{ encodings and generated code see a normal type }}
  }

  @by(system.checker)
  @targets(generic_type)
  generics_checked: rule {
    must {{ check a type argument against its parameter's guard, and the members of `Page(Refund)` with `T` read as `Refund` }}
  }

  @by(system.checker)
  @targets(error_type)
  only_errors_thrown: rule {
    if {{ a type that doesn't implement `Error` is thrown or named in `@throws` }}
    must {{ report not an error }}
    then {{ `@throws(RefundError)` covers every type that implements it, and a caught error is matched by type, `result.error.is(RefundWindowExpired)` }}
  }

  @by(system.checker)
  @targets(error_type)
  errors_never_enums: rule {
    mustNot {{ accept an enum as an error, in `@throws` or a `throw` }}
    instead {{ report not an error, since an error carries a message and an enum variant doesn't }}
  }

  @by(system.checker)
  @targets(interface_kind)
  structural_satisfaction: rule {
    must {{ let any type with an interface's members satisfy it where it's expected, while only `implements` brings its members, defaults and funcs in }}
    then {{ satisfying an interface never changes what's encoded }}
  }

  @by(system.checker)
  @targets(interface_kind)
  restating_members: rule {
    if {{ two interfaces a type implements provide the same member with different types or defaults }}
    must {{ report member to restate unless the type restates the member }}
    example {{ a type may also restate a member with the same type to change its default, or a func to replace its body }}
  }

  @by(system.checker)
  @targets(interface_kind)
  interfaces_for_all_variants: rule {
    where {{ an enum or a union implements an interface }}
    must {{ check the interface against every variant }}
  }

  @by(system.checker)
  @targets(interface_kind)
  no_interface_fields: rule {
    mustNot {{ accept an interface as the type of a member of encoded data }}
    instead {{ require a `union` there; an interface can still be a parameter's type }}
  }

  @by(system.generator)
  @targets(type_kind)
  codegen: rule {
    must {{ generate each format from what its package defines: OpenAPI from `std/http`, [`JSON Schema`](https://json-schema.org) from the types alone }}
    then {{ scenarios use the same definitions, so an op call in a step is typed end to end }}
  }

  errors: section {
    @realizes(language.apis.responses.thrown_types_are_errors, language.data.types.errors_never_enums, language.data.types.only_errors_thrown)
    @by(system.checker)
    not_an_error: error("type") {
      title = "{type} can't be thrown: it doesn't implement Error"
      type: field(String)
    }

    @realizes(language.data.types.restating_members)
    @by(system.checker)
    restate_member: error("conflict") {
      title = "{type} gets {member} from both {a} and {b}; restate it"
      type: field(String)
      member: field(String)
      a: field(String)
      b: field(String)
    }
  }

  @display("Types, errors and unions")
  data_types: example {
    | ```heron
    | import = ["std/doc@1", "std/types@1", "std/http@1", "std/proto@1"]
    |
    | Audited: interface {
    |   created_at: Timestamp
    |   created_by: String = "system"
    |
    |   age(): func(Duration) do {
    |     return clock.now - created_at
    |   }
    | }
    |
    | Refund: type(Audited) {
    |   id: String
    |   payment_id: String
    |   /// What was refunded, never more than the payment's refundable amount.
    |   amount: Money
    | }
    |
    | /// Everything a refund request can be refused with.
    | RefundError: interface(Error)
    |
    | // One error, projected on each binding: an HTTP status and a gRPC code.
    | @status(422)
    | @code(FAILED_PRECONDITION)
    | RefundWindowExpired: type(RefundError) {
    |   message: String = "The 30-day refund window has passed."
    |   captured_at: Timestamp
    | }
    |
    | @status(404)
    | @code(NOT_FOUND)
    | PaymentNotFound: type(RefundError) {
    |   message: String = "No payment exists with this id."
    |   payment_id: String
    | }
    |
    | PaymentMethod: union {
    |   card: Card
    |   bank: BankTransfer
    |   /// Paid out of the customer's balance.
    |   wallet: Wallet
    | }
    |
    | Page(T: Any): type {
    |   items: List(T)
    |   next?: String
    | }
    | ```
  }
}
