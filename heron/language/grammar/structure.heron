structure: section {
  | Structure is what a file's root and every `{ … }` body hold: members, one to a line.
  | A member says what it is by its shape, read left to right, so the parser never needs
  | the kind a member is written in.

  modes: section {
    | A file is read in five modes, structure, code, prose, string text and raw text, and what opens a construct says which mode its inside is
    | read in. The opener and the closer are the only way in and out.
    |
    | | Opener                     | Mode inside                          | Closed by                         |
    | | -------------------------- | ------------------------------------ | --------------------------------- |
    | | `{`, where a member starts | structure                            | the matching `}`                  |
    | | `{{`                       | prose, without prefixes              | `}}` outside code, attributes and inserts |
    | | a pipe at a line start     | prose, to the end of the line        | the line end                      |
    | | `///`                      | prose, to the end of the line        | the line end                      |
    | | `do {`                     | code                                 | the matching `}`                  |
    | | `"`, `"""` or more         | string text                          | the same run of quotes            |
    | | `` ` `` or more            | raw text                             | the same run of backticks         |
    | | `${`, in prose or a string | an expression                        | the matching `}`                  |
    | | `{`, in a [tag attribute](#language.markup.tags.tag_attribute)    | an expression                        | the matching `}`                  |

    syntax_mode: term {{
      How the parser reads the characters of a construct: as structure, code, prose,
      string text or raw text. Each construct's opener sets the mode of its inside.
    }}

    @by(system.parser)
    body_by_opener: rule {
      must {{ read a body after a member's head by what opens it: `{` as structure, `{{` as prose and `do {` as code }}
      then {{ a body can't change its mode inside, so a `{{ }}` body is all prose and a `do` body all code }}
    }

    @by(system.parser)
    prose_after_eq: rule {
      must {{ read `=|` and a `=` followed by `|` lines or `{{` as a prose value, and anything else after `=` as an expression }}
      example {{ `message =| No pet exists with this id.`: a prose value with no quotes }}
    }

    @by(system.parser)
    code_only_in_do: rule {
      must {{ read statements only inside `do { … }`, and expressions only after `=`, `:`, in arguments, in annotations, in `${ }` and in [tag attributes](#language.markup.tags.tag_attribute) }}
      then {{ structure never holds a statement, and code never holds a member }}
    }

    @by(system.parser)
    inserts_switch_back: rule {
      must {{ read the inside of `${ … }` as an expression wherever prose or string text is read, up to its matching `}`, so brackets, strings and nested inserts inside it don't close what holds it }}
    }
  }

  member_shapes: section {
    | The parser reads a member's leading forms first, then its path, then what follows the
    | path. The first shape that fits is the member's.
    |
    | | Written                                 | Member       |
    | | --------------------------------------- | ------------ |
    | | a pipe and text                         | `ProseLines` |
    | | `{{ text }}`                            | `ProseBlock` |
    | | `.{ … }`                                | `Scope`, with no path: a group |
    | | `do { … }`                              | `Action`     |
    | | `let name = value`                      | `Let`        |
    | | `path<flags>(list)?: Type body`         | `Declare`    |
    | | `path<flags>(list)?: Type = value`      | `Value`      |
    | | `path<flags>(args) body` or `= value`   | `Invoke`     |
    | | `path.{ … }`                            | `Scope`      |
    | | `path = value`                          | `Set`        |
    | | `path {{ text }}`                       | `TextNode`   |
    | | `path { … }` or `path do { … }`         | `Enter`      |
    | | `path`                                  | `Invoke`     |

    @by(system.parser)
    declaration_shape: rule {
      must {{ read a member as a declaration when its path, with optional flags, an optional list and an optional `?`, is followed by `:`; as a `Value` when `=` follows the type, and as a `Declare` otherwise }}
    }

    @by(system.parser)
    params_or_args: rule {
      must {{ read a list after a name as `Params` when an entry is `name: Type`, starts with `///` or `@`, or the list is followed by `:`, and as `Args` otherwise }}
      example {{ `f(x: Int): func` declares a parameter, while `case(days_ago = 31)` and `code("sh")` pass arguments }}
    }

    @by(system.parser)
    named_or_positional: rule {
      must {{ read an argument as named when it's a name followed by `=` and not `==`, and as positional otherwise }}
    }

    @by(system.parser)
    invoke_shape: rule {
      must {{ read a path with flags or arguments and no `:` as an `Invoke`, with an optional body or `=` and a value, and a bare path alone on its line as an `Invoke` with nothing after it }}
      example {{ `verification<generate>`, `requires.add(checks.e2e)` and `marker(color = Color.RED)`: invokes }}
    }

    @by(system.parser)
    enter_shape: rule {
      must {{ read a bare path by what follows it: `.{` as a `Scope`, `=` as a `Set`, `{{` as a `TextNode`, and `{` or `do {` as an `Enter` }}
    }

    @by(system.parser)
    let_shape: rule {
      must {{ read `let` as a local's binding only when a space and a name follow it, with an optional `: Type`, then `=` and a value }}
      example {{ `let: Int = 1` declares a field named `let` }}
    }

    @by(system.parser)
    paths: rule {
      must {{ read a path as names joined by `.`, where in structure a segment can also be a string, and end it at a `.` that no name or string follows }}
      example {{ `packages."std/ci" = { … }` sets a key that isn't a name; `a.{` ends the path `a` before the scope }}
    }

    @by(system.parser)
    step_segments: rule {
      must {{ read a segment after a dot that is a number with at most one lower-case letter after it, as the `3` of `request_refund.3` and the `2a` of `request_refund.2a`, as a segment of the path, in code, in arguments and in [short links](#heron.language.markup.links.short_link) }}
      then {{ a [step reference](#language.specifications.usecases.step_reference) is a path like any other }}
    }

    @by(system.parser)
    flag_lists: rule {
      must {{ read `<` directly after a name or a kind as a flag list only when names separated by commas, then `>`, follow it }}
      then {{ a `<` followed by anything else is the comparison operator }}
      example {{ `a<b` and `a < b` compare, while `task<confirm>` flags }}
    }

    @by(system.parser)
    optional_marker: rule {
      must {{ read a `?` between a name and its `:` as marking the declaration or parameter optional }}
      example {{ `note?: String`: an optional field; `lang?: String` in a list: an optional parameter }}
    }
  }

  lines: section {
    | Members are separated by line ends, never by punctuation.

    @by(system.parser)
    newlines_end_members: rule {
      must {{ end a member at the end of its line, so that nothing but a trailing comment or a closing `}` follows it on that line }}
      while {{ the line closes every bracket it opens and ends on a complete value }}
      example {{ `x =` with `1` on the next line, and an argument list wrapped one entry per line with a trailing comma: one member each }}
    }

    @by(system.parser)
    newlines_end_members_otherwise: rule {
      when {{ a line ends inside an open bracket, after a trailing operator, or before the value after `=` }}
      must {{ continue the member onto the next line }}
    }

    @by(system.parser)
    doc_lines_attach: rule {
      must {{ join consecutive [doc lines](#language.core_format.prose_layer.doc_lines) into one `Doc` and attach it to the member on the next line }}
      while {{ a member follows the [doc lines](#heron.language.core_format.prose_layer.doc_lines) on the next line }}
    }

    @by(system.parser)
    doc_lines_attach_otherwise: rule {
      when {{ a blank line, a comment or a `}` follows [doc lines](#heron.language.core_format.prose_layer.doc_lines) }}
      must {{ read them as a `Doc` member of their own }}
    }

    @by(system.parser)
    annotation_lines: rule {
      must {{ attach `@name(args)` annotations to the member they stand in front of, on the same line or on lines of their own directly above it, with comments allowed between }}
    }
  }

  /// The productions of members, their heads and their bodies.
  @display("Structure productions")
  @source("grammar/heron.ungram")
  tree: grammar(notation = "ungrammar") {
    start = language.grammar.structure.tree.File

    /// A file of structure: its implicit root's members.
    File: production {{ Member* }}
    /// One member of a body.
    @realizes(language.grammar.structure.lines.newlines_end_members)
    Member: production {{
      Declare | Value | Enter | TextNode | Scope | Invoke | Set | Let | Action
      | ProseLines | ProseBlock | CommentLine | Doc | ErrorNode
    }}
    /// A node of a stated kind or type, with an optional body.
    @realizes(language.grammar.structure.member_shapes.optional_marker, language.grammar.structure.member_shapes.declaration_shape)
    Declare: production {{ Doc? Annotation* Path Flags? Params? Question? Colon Type Body? }}
    /// A typed value, or a func of one expression.
    @realizes(language.grammar.structure.member_shapes.declaration_shape)
    Value: production {{ Doc? Annotation* Path Flags? Params? Question? Colon Type Eq Expr }}
    /// Amends a node that exists.
    @realizes(language.grammar.structure.member_shapes.enter_shape)
    Enter: production {{ Doc? Annotation* Path Body }}
    /// A node of the path's kind holding only text, or an entered node's text.
    @realizes(language.grammar.structure.member_shapes.enter_shape)
    TextNode: production {{ Doc? Annotation* Path ProseBlock }}
    /// Amends a path, creating it if it's missing; with no path, a group.
    @realizes(language.grammar.structure.member_shapes.enter_shape)
    Scope: production {{ Doc? Annotation* Path? Dot StructBody }}
    /// A call: of a kind, a macro or a func.
    @realizes(language.grammar.structure.member_shapes.invoke_shape)
    Invoke: production {{ Doc? Annotation* Path Flags? Args? Body? Eq? Expr? }}
    /// Sets a field that exists.
    @realizes(language.grammar.structure.member_shapes.enter_shape, language.grammar.structure.modes.prose_after_eq)
    Set: production {{ Doc? Annotation* Path Eq Expr }}
    /// Binds a local.
    @realizes(language.grammar.structure.member_shapes.let_shape)
    Let: production {{ Doc? KwLet Ident Colon? Type? Eq Expr }}
    /// The node's code.
    Action: production {{ Doc? Annotation* DoBlock }}
    /// A comment on a line of its own.
    @realizes(language.grammar.lexical.comment_members)
    CommentLine: production {{ Comment }}
    /// What the parser skipped to recover.
    ErrorNode: production {{ Error* }}
    /// `///` lines, joined into the next member's `@doc`.
    @realizes(language.grammar.structure.lines.doc_lines_attach)
    Doc: production {{ DocLine* }}
    DocLine: production {{ DocPrefix Inline* }}
    @realizes(language.grammar.structure.lines.annotation_lines)
    Annotation: production {{ At Path Flags? Args? }}
    @realizes(language.grammar.structure.member_shapes.paths)
    Path: production {{ Ident* StringLit* }}
    @realizes(language.grammar.structure.member_shapes.flag_lists)
    Flags: production {{ FlagOpen Ident* Comma* FlagClose }}
    /// Inputs that callers and cases supply.
    @realizes(language.grammar.structure.member_shapes.params_or_args)
    Params: production {{ LParen Param* Comma* RParen }}
    @realizes(language.grammar.structure.member_shapes.optional_marker)
    Param: production {{ Doc? Annotation* Ident Flags? Question? Colon Type Eq? default:Expr? }}
    /// Arguments that configure a kind or call.
    @realizes(language.grammar.structure.member_shapes.params_or_args)
    Args: production {{ LParen Arg* Comma* RParen }}
    @realizes(language.grammar.structure.member_shapes.named_or_positional)
    Arg: production {{ PositionalArg | NamedArg }}
    PositionalArg: production {{ Expr }}
    NamedArg: production {{ Ident Eq Expr }}
    @realizes(language.grammar.structure.modes.body_by_opener)
    Body: production {{ StructBody | ProseBlock | DoBlock }}
    StructBody: production {{ LBrace Member* RBrace }}
    @realizes(language.grammar.structure.modes.code_only_in_do)
    DoBlock: production {{ KwDo Code }}
  }
}
