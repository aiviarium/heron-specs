recovery: section {
  | The parser never stops at an error. It reports what it expected, keeps what it
  | couldn't place in an `ErrorNode`, and carries on from a point where the input makes
  | sense again, so a half-written file still has a tree that the checker, the
  | formatter and the language server can use.

  lossless_tree: term {{
    A syntax tree whose tokens hold every byte of the input exactly once, in order,
    [trivia](#language.grammar.lexical.trivia) and errors included, so printing its
    tokens reproduces the file.
  }}

  lossless: rule(lossless_tree, by = product.system.parser) {
    must {{ build a [lossless tree](#language.grammar.recovery.lossless_tree) for every input, valid or not, with every token's text equal to the source at its span and the tokens contiguous }}
    then {{ formatting, fixes and the language server edit tokens in place, and no parse loses text }}
  }

  never_fails: rule(lossless_tree, by = product.system.parser) {
    must {{ return a tree and a list of diagnostics for any input, without failing, and in time linear in its length }}
  }

  syntax_errors: rule(lossless_tree, by = product.system.parser) {
    must {{ report every syntax error as an error coded `syntax` at the offset where the parser expected something else, with a message saying what it expected }}
    unless {{ the message repeats the one before it at the same offset, which is dropped so one position gets one diagnostic }}
  }

  checking_goes_on: rule(lossless_tree, by = product.system.checker) {
    must {{ check a file with syntax errors as far as its tree goes, reading each `ErrorNode` as nothing }}
    then {{ a typo on one line doesn't hide the diagnostics of the rest of the file }}
  }

  lines: section {
    | Structure and code recover at line ends: a member or statement whose line has more
    | on it than it can read ends there.

    rest_of_line: rule(language.grammar.structure.tree.Member, by = product.system.parser) {
      if {{ a member or statement is complete but its line goes on }}
      must {{ report [end of line](#language.grammar.recovery.diagnostics.end_of_line) and keep the rest of the line in an `ErrorNode` }}
      example {{ `a = 1 b`: the set `a = 1`, then an error at `b` }}
    }

    no_member: rule(language.grammar.structure.tree.Member, by = product.system.parser) {
      if {{ a line in structure starts with none of the forms a member starts with }}
      must {{ report [no member](#language.grammar.recovery.diagnostics.no_member) and keep the line in an `ErrorNode` }}
      example {{ `= 1`; a `}` with no body open }}
    }

    progress: rule(language.grammar.structure.tree.Member, by = product.system.parser) {
      if {{ a member or statement consumed nothing }}
      must {{ keep one character in an `ErrorNode` and go on after it }}
      then {{ every pass of the loop moves forward, so the parse ends }}
    }
  }

  missing: section {
    | A missing part is reported where it should stand, and the node is built without it.
    | The [diagnostics](#language.grammar.recovery.diagnostics) list each part's message.

    missing_parts: rule(lossless_tree, by = product.system.parser) {
      if {{ a construct lacks a part one of the [diagnostics](#language.grammar.recovery.diagnostics) names }}
      must {{ report that diagnostic at the offset where the part belongs, and build the construct without it }}
    }
  }

  lists: section {
    list_entries: rule(language.grammar.structure.tree.Args, language.grammar.code.tree.ArrayExpr, by = product.system.parser) {
      if {{ an entry of an argument, parameter or array list isn't followed by `,` or the closing bracket }}
      must {{ report [argument list](#language.grammar.recovery.diagnostics.argument_list), or [array list](#language.grammar.recovery.diagnostics.array_list) in an array, and skip to the next `,` or closing bracket, keeping nested brackets and strings balanced }}
      example {{ `f(a b)`: the argument `a`, then an error holding `b` }}
    }

    map_entries: rule(language.grammar.code.tree.MapEntry, by = product.system.parser) {
      if {{ a map entry doesn't start with a path, or its path isn't followed by `=` }}
      must {{ report [map entry](#language.grammar.recovery.diagnostics.map_entry) or [map equals](#language.grammar.recovery.diagnostics.map_equals), and skip to the next `,` or the closing brace }}
    }
  }

  depth: section {
    nesting_limit: rule(lossless_tree, by = product.system.parser) {
      if {{ members, expressions, statements or tags nest more than 256 deep }}
      must {{ report [too deep](#language.grammar.recovery.diagnostics.too_deep) and keep the rest of that line, or that expression, in an `ErrorNode` }}
      then {{ a hostile input can't exhaust the stack }}
    }
  }

  diagnostics: section {
    | Every syntax error is coded `syntax` and reported by [the parser](#product.system.parser) at the offset where the parser expected something else.

    end_of_line: diagnostic("syntax", by = product.system.parser) {
      message = "expected the end of the line"
      | A member or statement is complete, but its line goes on.
    }

    no_member: diagnostic("syntax", by = product.system.parser) {
      message = "expected a member"
      | A line in structure starts with none of the forms a member starts with.
    }

    missing_brace: diagnostic("syntax", by = product.system.parser) {
      message = "expected `}`"
      | A body, a map, a code block or an insert lacks its `}`; at the end of the input when nothing closes it.
    }

    missing_double_brace: diagnostic("syntax", by = product.system.parser) {
      message = "expected `}}`"
      | A `{{ }}` body lacks its `}}`, reported at the end of the input.
    }

    missing_set_value: diagnostic("syntax", by = product.system.parser) {
      message = "expected a value after `=`"
      | A set has `=` and nothing after it.
    }

    missing_let_equals: diagnostic("syntax", by = product.system.parser) {
      message = "expected `=`"
      | A `let` lacks its `=`.
    }

    missing_value: diagnostic("syntax", by = product.system.parser) {
      message = "expected a value"
      | An expression lacks a value where one must stand.
    }

    missing_type: diagnostic("syntax", by = product.system.parser) {
      message = "expected a type"
      | A `:` isn't followed by a type.
    }

    missing_name: diagnostic("syntax", by = product.system.parser) {
      message = "expected a name"
      | A path or a `for` lacks a name.
    }

    missing_in: diagnostic("syntax", by = product.system.parser) {
      message = "expected `in`"
      | A `for` lacks its `in`.
    }

    missing_block: diagnostic("syntax", by = product.system.parser) {
      message = "expected `{`"
      | An `if` or a `for` lacks its code block.
    }

    missing_param_name: diagnostic("syntax", by = product.system.parser) {
      message = "expected a parameter name"
      | A parameter list holds an entry that doesn't start with a name.
    }

    missing_param_type: diagnostic("syntax", by = product.system.parser) {
      message = "expected `:` and a type"
      | A parameter's name isn't followed by `:` and a type.
    }

    missing_paren: diagnostic("syntax", by = product.system.parser) {
      message = "expected `)`"
      | A group, an argument list or a type lacks its `)`.
    }

    missing_bracket: diagnostic("syntax", by = product.system.parser) {
      message = "expected `]`"
      | An array lacks its `]`.
    }

    missing_angle: diagnostic("syntax", by = product.system.parser) {
      message = "expected `>`"
      | A flag list or a tag lacks its `>`.
    }

    unterminated_string: diagnostic("syntax", by = product.system.parser) {
      message = "unterminated string"
      | A string lacks its closing quote: at the line end for a one-quote string, at the end of the input for a triple-quoted one.
    }

    unterminated_raw: diagnostic("syntax", by = product.system.parser) {
      message = "unterminated raw string"
      | A raw string lacks the backtick run that closes it.
    }

    missing_fence: diagnostic("syntax", by = product.system.parser) {
      message = "expected the closing fence"
      | A heron fence in prose lacks its closing line.
    }

    argument_list: diagnostic("syntax", by = product.system.parser) {
      message = "expected `,` or `)`"
      | An entry of an argument or parameter list isn't followed by `,` or `)`.
    }

    array_list: diagnostic("syntax", by = product.system.parser) {
      message = "expected `,` or `]`"
      | An entry of an array isn't followed by `,` or `]`.
    }

    map_entry: diagnostic("syntax", by = product.system.parser) {
      message = "expected a map entry"
      | A map entry doesn't start with a path.
    }

    map_equals: diagnostic("syntax", by = product.system.parser) {
      message = "expected `=` in a map entry"
      | A map entry's path isn't followed by `=`.
    }

    map_separator: diagnostic("syntax", by = product.system.parser) {
      message = "expected `,`, a new line or `}`"
      | A map entry is followed by something other than `,`, a line end or `}`.
    }

    tag_mismatch: diagnostic("syntax", by = product.system.parser) {
      message = "`</‹other›>` closes `<‹name›>`"
      | A closing tag names another tag than the one open, reported at the closing name.
    }

    tag_unclosed: diagnostic("syntax", by = product.system.parser) {
      message = "`<‹name›>` is never closed"
      | An opening tag has no closing tag, reported at the opening tag.
    }

    too_deep: diagnostic("syntax", by = product.system.parser) {
      message = "nesting is too deep"
      | Members, expressions, statements or tags nest more than 256 deep.
    }
  }
}
