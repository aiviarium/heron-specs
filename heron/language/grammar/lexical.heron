lexical: section {
  | The parser reads characters directly: there's no separate lexer, and what a run of
  | characters means depends on the [syntax mode](#language.grammar.structure.modes.syntax_mode) it's read in. This section gives the
  | characters every mode shares, how a line says what it is, and the token kinds the
  | [lossless tree](#language.grammar.recovery.lossless_tree) holds.

  column: term {{
    A position within a line of a file, counted from 1 at its first character, as a diagnostic and an editor report it.
  }}

  trivia: term {{
    The tokens that carry layout rather than meaning: `Whitespace`, `Newline` and
    `Comment`. They stay in the tree, so the text can be printed back, but no production
    reads them.
  }}

  line_kinds: rule(system.parser) {
    must {{ tell what a line is from how it starts, after its indentation: `|` starts a prose line, `///` a doc line, `//` a comment, and anything else structure }}
    while {{ the line stands outside multi-line strings, fenced blocks and `{{ }}` bodies, which read their lines as their own text }}
    then {{ no line's meaning depends on the kind it's written in or on the lines after it }}
  }

  meaning_is_local: rule(system.parser) {
    must_not {{ change how a construct parses with the kind it's written in, the imports or anything a checker knows }}
    then {{ a file parses the same alone as in its tree, and an editor can parse it on every keystroke }}
  }

  line_ends: rule(system.parser) {
    must {{ end a line at `\n` or at `\r\n`, and keep the line end as one `Newline` token }}
    then {{ a `\r` on its own isn't a line end: in structure it's an unexpected character }}
  }

  layout_whitespace: rule(system.parser) {
    must {{ read spaces and tabs between tokens as layout, never as indentation that groups members }}
    then {{ nesting is always written with brackets, and the formatter alone decides indentation }}
  }

  identifiers: rule(system.parser) {
    must {{ read a name as a Unicode letter or `_` followed by letters, digits and `_` }}
    then {{ a hyphen ends a name, so `max-items` is `max - items` in an expression and an error in a path }}
    example {{ `größe`, `_draft` and `v2`: names }}
  }

  numbers: rule(system.parser) {
    must {{ read a number as decimal digits with optional `_` separators, an optional fraction of `.` and at least one digit, and an optional exponent of `e` or `E`, a sign and digits }}
    then {{ a number has no sign of its own, so `-1` is a negation, and there are no hexadecimal or binary literals: an [embedded string](#language.grammar.strings.embedded.embedded_string) such as `(hex)"ff"` writes those }}
    example {{ `1_000`, `0.25` and `6.02e23`: numbers; `1.` is the number `1` followed by a stray `.` }}
  }

  comments: rule(system.parser) {
    must {{ read `//` that isn't `///` as a comment running to the end of its line, wherever structure, code or a bracketed list is read }}
    then {{ a comment always stands on a line of its own or at the end of a line of structure or code }}
  }

  no_comments_in_text: rule(system.parser) {
    must_not {{ read `//` as a comment inside a prose line, a doc line, a `{{ }}` body or a string }}
    then {{ a URL in prose or in a string needs no escape }}
  }

  comment_members: rule(system.parser) {
    must {{ keep a comment on a line of its own as a `CommentLine` member of its body, or a statement of its code block, and a comment at the end of a line as [trivia](#language.grammar.lexical.trivia) of that line }}
    then {{ the formatter keeps every comment, attached to the member after it }}
  }

  reserved_words: term {{
    `do`, `let`, `if`, `else`, `for`, `in`, `return`, `not`, `and`, `or`, `is`, `true` and
    `false`: the words code and expressions read as keywords. In structure they're
    names, so a rule's `if {{ … }}` and a field named `for` need no escape.
  }}

  words_in_structure: rule(system.parser) {
    must {{ read a reserved word as a keyword only where code or an expression is read, and as a name in structure }}
    example {{ `if {{ a refund is late }}`: a node named `if`; `do: rule`: a declaration named `do` }}
  }

  words_in_structure_otherwise: rule(system.parser) {
    while {{ a reserved word is `do` followed by `{`, or `let` followed by a space and a name, in structure }}
    must {{ read `do {` as opening code and `let name` as binding a local }}
  }

  word_boundaries: rule(system.parser) {
    must {{ read a word operator or keyword only when no letter, digit or `_` follows it }}
    example {{ `order` and `origin`: names, not `or` followed by a name }}
  }

  /// The token kinds of the tree. Every character of a file is in exactly one token.
  @display("Token kinds")
  tokens: grammar(language.grammar.lexical.line_kinds, language.grammar.lexical.meaning_is_local, notation = "ungrammar", source = "grammar/heron.ungram") {
    | Each token is given by the characters it matches, in the notation of the productions:
    | quoted literals, character classes in brackets, and `*`, `+`, `?` and `|`. Tokens of
    | prose and strings are matched only in their modes, as their sections say.

    /// Spaces and tabs.
    Whitespace: token(language.grammar.lexical.layout_whitespace) {{ [ \t]+ }}
    /// A line end.
    Newline: token(language.grammar.lexical.line_ends) {{ "\n" | "\r\n" }}
    /// A comment, to the end of its line.
    Comment: token(language.grammar.lexical.comments, language.grammar.lexical.no_comments_in_text) {{ "//" [^/\r\n] [^\r\n]* | "//" }}
    /// A run of characters the parser couldn't place, kept so the tree stays lossless.
    Error: token {{ any character }}
    /// A name.
    Ident: token(language.grammar.lexical.identifiers) {{ [\p{L}_] [\p{L}\p{N}_]* }}
    /// A decimal number.
    Number: token(language.grammar.lexical.numbers) {{ [0-9] [0-9_]* ("." [0-9] [0-9_]*)? ([eE] [+-]? [0-9] [0-9_]*)? }}
    KwLet: token {{ "let" }}
    KwDo: token {{ "do" }}
    KwIf: token {{ "if" }}
    KwElse: token {{ "else" }}
    KwFor: token {{ "for" }}
    KwIn: token {{ "in" }}
    KwReturn: token {{ "return" }}
    KwNot: token {{ "not" }}
    KwAnd: token {{ "and" }}
    KwOr: token {{ "or" }}
    KwIs: token {{ "is" }}
    KwTrue: token {{ "true" }}
    KwFalse: token {{ "false" }}
    LBrace: token {{ "{" }}
    RBrace: token {{ "}" }}
    /// Opens a `{{ }}` body.
    LBrace2: token {{ "{" "{" }}
    /// Closes a `{{ }}` body.
    RBrace2: token =| "}" "}"
    LParen: token {{ "(" }}
    RParen: token {{ ")" }}
    LBracket: token {{ "[" }}
    RBracket: token {{ "]" }}
    /// A `<` directly after a name or a kind, opening a flag list.
    FlagOpen: token {{ "<" }}
    FlagClose: token {{ ">" }}
    Comma: token {{ "," }}
    Colon: token {{ ":" }}
    Dot: token {{ "." }}
    Question: token {{ "?" }}
    Eq: token {{ "=" }}
    At: token {{ "@" }}
    EqEq: token {{ "==" }}
    NotEq: token {{ "!=" }}
    Lt: token {{ "<" }}
    LtEq: token {{ "<=" }}
    Gt: token {{ ">" }}
    GtEq: token {{ ">=" }}
    Plus: token {{ "+" }}
    Minus: token {{ "-" }}
    Star: token {{ "*" }}
    Slash: token {{ "/" }}
    Percent: token {{ "%" }}
    /// A union of types; followed by a space.
    Bar: token {{ "|" }}
    /// An intersection of types.
    Amp: token {{ "&" }}
    /// A run of one, or three or more, double quotes.
    Quote: token {{ "\"" | "\"\"\"" "\""* }}
    /// The literal text of a string.
    StringText: token {{ [^"\\$]+ | "\"" | "$" }}
    /// A backslash and the character after it.
    Escape: token {{ "\\" any character }}
    /// Starts an insert of a path.
    Dollar: token {{ "$" }}
    /// Starts an insert of an expression.
    DollarBrace: token {{ "$" "{" }}
    /// A raw string, backticks included.
    Raw: token(language.grammar.strings.raw.one_line_raw, language.grammar.strings.raw.raw_runs) {{ "`"+ any text "`"+ }}
    /// The prefix of a prose line.
    Pipe: token {{ "|" }}
    /// The prefix of a doc line.
    DocPrefix: token {{ "///" }}
    /// [Prose text](#language.markup.writing.prose_text).
    Text: token {{ any text }}
    /// Inline code, backticks included.
    CodeSpan: token {{ "`"+ any text "`"+ }}
    /// One line of a fenced block, its marker lines included.
    FenceLine: token {{ any text to the line end }}
    LinkOpen: token {{ "[" }}
    LinkMid: token {{ "](" }}
    LinkClose: token {{ ")" }}
    /// A backtick around a [short link](#language.markup.links.short_link)'s path, as in ``[`refund_window`]``.
    LinkTick: token {{ "`" }}
    /// Closes a [short link](#language.markup.links.short_link).
    ShortLinkEnd: token {{ "]" }}
    /// Starts a link's [node path](#language.core_format.naming.node_path).
    Hash: token {{ "#" }}
    /// One character of a link's URL.
    Url: token {{ [^ \t\r\n)] }}
    TagOpen: token {{ "<" }}
    TagCloseOpen: token {{ "</" }}
    TagEnd: token {{ ">" }}
    TagSelfEnd: token {{ "/>" }}
    /// One to six `#` at the start of a line of a `.heron.md` file, followed by a space or a tab.
    HeadingMark: token {{ "#" "#"? "#"? "#"? "#"? "#"? }}
    /// A heading's name, as `{#refund_limits}`.
    HeadingId: token {{ "{#" any text "}" }}
  }
}
