generics: section {
  | A type can take types as parameters, as `Page(T: Any): type`, and its members are read
  | through the arguments it's used with. `Patch(T)` from `std/types` is the one generic the
  | checker knows by name: every member of `T`, each optional.

  generic_members: rule(language.schemas.generics, by = product.system.checker) {
    must {{ check a value of a [generic type](#language.data.types.generic_type) against its members with each type parameter replaced by the argument in its place }}
    example {{ in a `Page(Refund)`, `first` is checked as a `Refund` and `items` as a `List(Refund)` }}
  }

  patch: rule(language.schemas.generics, by = product.system.checker) {
    must {{ check a value of `Patch(T)` as a map whose keys are members of `T`, each optional, of its member's type or `null` to clear it }}
    example {{ `Patch(Refund) = { amount = 3 }` and `{ id = null }` check; `{ amout = 3 }` reports "Refund has no member amout" }}
  }

  patch_needs_map: rule(language.schemas.generics, by = product.system.checker) {
    if {{ a value of `Patch(T)` isn't a map }}
    must {{ report "expected Patch, got ‹what the value is›", coded `type` }}
    example {{ `p: Patch(Refund) = 3` reports "expected Patch, got a number" }}
  }
}
