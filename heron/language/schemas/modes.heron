modes: section {
  | Every declaration belongs to a mode, and a name is looked up among the declarations of
  | the mode it stands in, so one name can be a kind in structure and a func in code.
  | Prose takes the kinds a body accepts as tags, and a kind can keep out of prose.

  parse_mode: term {{
    One of the three modes declarations live in, structure, prose or code, the variants of
    `std/schema`'s `Mode`. Kinds live in structure and, as tags, in prose; funcs, tasks,
    ops and statement keywords live in code. The
    [syntax modes](#language.grammar.structure.modes.syntax_mode) also read string and raw text,
    where nothing is declared.
  }}

  lookup_by_mode: rule(system.checker) {
    must {{ look a name up only among the declarations of the mode it stands in }}
    example {{ `if` is a rule's condition in structure and a statement in code, and `example` is a kind in a rule's body and a func in a `do` block }}
  }

  accepted_kind_wins: rule(system.checker) {
    when {{ a member's name could mean two or more kinds visible where it stands }}
    must {{ take the kind the enclosing node's kind accepts, and otherwise the innermost declaration }}
    example {{ a spec imports `std/doc`'s `if` tag and sees the core's `if` condition, and the `if` in a rule's body is the condition, because rules accept it }}
  }

  wrong_mode: rule(system.linter) {
    if {{ a name is used in a mode where nothing declares it, and something in another mode does }}
    should {{ report wrong mode, naming the mode where it's declared }}
  }

  prose_tags: rule(system.checker) {
    must {{ read a tag in a node's prose as an instance of the kind it names, valid where the node's kind accepts that kind or its category, as a child would be }}
    example {{ `<note kind="tip">Text</note>` in a section's prose is a `note`, since sections accept `block` }}
  }

  structure_only: rule(system.linter) {
    where {{ a kind is declared with `modes = [structure]` }}
    should {{ report a tag that names it as structure-only tag }}
    example {{ `std/types` declares `example: kind(fields_from = op, modes = [structure])`, so `<example>` in prose is reported }}
  }

  tag_names_kind: rule(system.linter) {
    if {{ a tag names something in scope that isn't a kind }}
    should {{ report tag not a kind }}
  }

  inline_only_as_tags: rule(system.checker) {
    where {{ a kind is only in the `inline` category of `std/doc` }}
    must {{ admit it only as a tag in prose, since no body accepts `inline` children }}
    example {{ `<link>` and `<code>` stand in a sentence, never on a line of their own in structure }}
  }

  errors: section {
    @severity(warning)
    wrong_mode_name: error("wrong-mode") {
      title = "{name} isn't declared in {here}; it's declared in {mode}"
      name: field(String)
      here: field(String)
      mode: field(String)
      | A name used in prose that only code declares, or the other way round.
      | Reported as [language.schemas.modes.wrong_mode] says.
    }

    @severity(warning)
    structure_only_tag: error("tag-kind") {
      title = "<{kind}> is a kind that stands only in structure, not as a tag"
      kind: field(String)
      | Reported as [language.markup.tags.tag_names_a_kind] and [language.schemas.modes.structure_only] say.
    }

    @severity(warning)
    tag_not_a_kind: error("tag-kind") {
      title = "<{path}> names {name}, which isn't a kind; a tag must name a kind in scope"
      path: field(String)
      name: field(String)
      | Reported as [language.markup.tags.tag_names_a_kind] and [language.schemas.modes.tag_names_kind] say.
    }
  }
}
