accept: section {
  | What a body may hold is its kind's [schema](#language.schemas.kinds.schema): each `accept(…)` entry in a kind's body admits
  | one thing, and a kind that accepts nothing takes no body. The [schema](#language.schemas.kinds.schema) decides only what's
  | valid, never how a body parses.
  |
  | | Entry                          | Admits                                                                              |
  | | ------------------------------ | ----------------------------------------------------------------------------------- |
  | | `accept(kind = k)`             | children of kind `k`                                                                |
  | | `accept(category = c)`         | children of any kind in category `c`, from any package in `import`                  |
  | | `accept(prose)`                | pipe lines, a `{{ }}` body and a prose value, with tags of the kinds the body accepts |
  | | `accept(code)`                 | a `do` block                                                                        |
  | | `accept(text = T)`             | prose read as text of type `T`, such as `Verbatim`, which takes it exactly as written |
  | | `accept(binding = b)`          | a child bound to `b`, a parameter or result of the kind's `fields_from` node         |
  | | `max = n` on any entry         | at most `n` of what the entry admits                                                |

  child_kinds: rule(system.checker) {
    must {{ admit a child of a node when an entry of the node's kind names the child's kind, or a category the child's kind is in }}
  }

  not_children: rule(system.checker) {
    must {{ leave out of the count fields, typed members and calls, and accept every member of a package's body }}
  }

  first_entry_counts: rule(system.checker) {
    must {{ count each child against the first entry, in declaration order, that admits it }}
    example {{ `rule` accepts `kind = when, max = 1` before `category = condition`, so a second `when` reports "rule accepts at most 1 when", though `when` is also a condition }}
  }

  max_bound: rule(system.checker) {
    where {{ an entry has `max = n` }}
    must {{ report accepts at most once, at the first child past the bound, counting every kind of a category entry together }}
    example {{ `rule` accepts `category = strength, max = 1`, so a rule with `must` and `should` reports "rule accepts at most 1 strength node" }}
  }

  unaccepted_child: rule(system.checker) {
    if {{ no entry admits a child }}
    must {{ report doesn't accept at the child, listing the kinds and categories the kind does accept }}
  }

  prose_and_code: rule(system.checker) {
    if {{ a node has prose its kind doesn't accept with `accept(prose)` or `accept(text = …)`, or a `do` block it doesn't accept with `accept(code)` }}
    must {{ report takes no prose or takes no do block at the node's name }}
  }

  verbatim_text: rule(system.checker) {
    where {{ a kind accepts `text = Verbatim` }}
    must {{ keep its prose exactly as written, with no inserts, links, tags or emphasis read in it }}
    example {{ a grammar's `production` and a component's `surface` hold their text verbatim }}
  }

  errors: section {
    @display("Doesn't accept")
    doesnt_accept: error("accept") {
      title = "{kind} doesn't accept {child_kind}; it accepts {kinds}"
      kind: field(String)
      child_kind: field(String)
      kinds: field(String)
      | The tail reads "; it accepts no child kinds" when the kind accepts none.
      | Reported as [language.schemas.accept.unaccepted_child] and [language.specifications.lifecycles.transition_body] say.
    }

    accepts_at_most: error("accept") {
      title = "{kind} accepts at most {n} {child_kind}"
      kind: field(String)
      n: field(String)
      child_kind: field(String)
      | For a category entry the child kind reads as the category, as "1 strength node" or "2
      | block nodes".
      | Reported as [language.schemas.accept.max_bound] says.
    }

    takes_no_prose: error("accept") {
      title = "{kind} takes no prose"
      kind: field(String)
      | Reported as [language.core_format.prose_layer.prose_needs_a_kind] and [language.schemas.accept.prose_and_code] say.
    }

    takes_no_do_block: error("accept") {
      title = "{kind} takes no do block"
      kind: field(String)
      | Reported as [language.schemas.accept.prose_and_code] says.
    }
  }
}
