categories: section {
  | A category is an open set of kinds. A body that accepts a category accepts every kind
  | in it, whichever package declares the kind, so a package adds blocks that `std/doc`'s
  | sections take without touching `std/doc`.

  @display("Category")
  category_term: term {{
    A node of kind `category`, as `block: category`, that kinds join with `in` and bodies
    accept with `accept(category = …)`.
  }}

  joining: rule(category_term, by = product.system.checker) {
    must {{ put a kind in each category its `in` argument names, and in no other }}
    example {{ `note(kind: NoteKind = NoteKind.NOTE): kind(in = [block])` is a block wherever `std/doc` is imported }}
  }

  open_sets: rule(category_term, by = product.system.checker) {
    must {{ admit, through a category entry, a kind of any package in `import` that joins the category, the importing tree's own kinds included }}
  }

  | `std/doc` declares the categories prose and documentation are built from: `block`, for
  | what stands on a line of its own or as a block tag, and `inline`, for what stands inside
  | a sentence. `std/spec` adds `strength` and `condition`. `std/schema` declares `flow` and
  | `phrasing`, the sketch's names for the same two sets, which no standard kind joins.

  builtin_categories: rule(category_term, by = product.actors.author) {
    shouldNot {{ put a kind in `schema.flow` or `schema.phrasing` }}
    instead {{ put block kinds in `doc.block` and inline kinds in `doc.inline`, which every documentation body accepts }}
  }

  | An excerpt of `std/doc`: the categories, a block kind with an enum parameter, and an
  | inline kind with [overloads](#language.schemas.overloads.overload).

  @display("Example: std/doc")
  std_doc_schema: example {
    | ```heron
    | import = ["std/schema@1"]
    |
    | // An excerpt: the full component list is on the Markup tab.
    | doc: package(version = "1.0") {
    |   block: category
    |   inline: category
    |
    |   section: kind(in = [block], heading = true) {
    |     accept(prose)
    |     accept(category = block)
    |     accept(category = inline)
    |   }
    |
    |   /// A code block. Triple backticks in prose are its shorthand.
    |   code(lang?: String, title?: String): kind(in = [block, inline]) {
    |     accept(text = Verbatim)
    |   }
    |
    |   note(kind: NoteKind = NoteKind.NOTE): kind(in = [block]) {
    |     accept(prose)
    |     accept(category = inline)
    |   }
    |
    |   kbd: kind(in = [inline]) {
    |     accept(prose)
    |   }
    |
    |   term: kind(in = [block]) {
    |     accept(prose)
    |   }
    |
    |   @highlight(token = "comment.doc")
    |   doc: annotation {
    |     accept(prose)
    |   }
    | }
    | ```
  }
}
