extensions: section {
  | Anything a project or organization adds is loaded at run time, in one of two ways: as
  | Heron source in a package, or by an [extension process](#language.schemas.extensions.extension_process) that implements what a package
  | declares. The declaration is the extension's manifest: its command, its limits and its
  | pin, read before it ever runs.

  heron_packages_first: rule(language.schemas.extensions, by = product.actors.author) {
    should {{ add kinds, types, flags, defaults, lints, tasks, funcs and macros as Heron source in a package }}
    unless {{ the behaviour needs code Heron's own `do` blocks can't express, such as a library of another language }}
  }

  extension_process: term {{
    An external program that `heron` starts and talks to over the versioned CBOR-RPC
    protocol on stdio, the way editors talk to language servers. It can be written in any
    language, with JS and TS supported first, and implements what a package declares with
    `@extern(…)`.
  }}

  manifest: section {
    | | Argument   | Type           | Default | Means                                                         |
    | | ---------- | -------------- | ------- | ------------------------------------------------------------- |
    | | `command`  | `List(String)` | needed  | The program and its arguments, run from the package's folder  |
    | | `files`    | `List(String)` | `[]`    | The paths it may write, beside the run's temp directory       |
    | | `network`  | `List(String)` | `[]`    | The hosts it may reach; empty cuts it off the network         |
    | | `commands` | `List(String)` | `[]`    | The programs it may run                                       |
    | | `version`  | `String`       | none    | The version `heron run setup` installs and `heron.lock` pins  |
    | | `checksum` | `String`       | none    | The checksum of what's installed, pinned with the version     |

    one_declaration: rule(extension_process, by = product.system.extension_host) {
      must {{ start an extension only from an `extension(…)` declaration, and bind `@extern(e)` only to such a declaration }}
      then {{ every external program has one declaration with its limits and pin, whatever language it's written in, and a TS module is an extension whose `command` runs it, as `extension(command = ["node", "compliance.js"])` }}
    }

    schema_keeps_types: rule(extension_process, by = product.system.checker) {
      must {{ check, complete and document everything an extension implements against the package's declarations, as for built-in parts }}
    }

    pinned: rule(extension_process, by = product.system.interpreter) {
      must {{ install an extension at its declared `version`, check it against its `checksum`, and record both in `heron.lock` }}
    }
  }

  limits: section {
    | An extension runs with the files, network and commands it declares, as an agent's
    | environment does. What's enforced depends on the platform, and what isn't is said
    | each time, never silently allowed.

    sandboxed: rule(extension_process, by = product.system.extension_host) {
      where {{ Linux user, filesystem and network namespaces are available }}
      must {{ run each extension in new user and filesystem namespaces, with every file read-only but its declared `files` and the run's temp directory, with only its declared `commands` on PATH, and in a network namespace with no interfaces when it declares no `network` hosts }}
    }

    unsandboxed: rule(extension_process, by = product.system.extension_host) {
      where {{ namespaces aren't available }}
      must {{ run the extension without them and report [limits not enforced](#language.schemas.extensions.diagnostics.limits_not_enforced) }}
    }

    hosts_not_filtered: rule(extension_process, by = product.system.extension_host) {
      when {{ an extension that declares `network` hosts starts }}
      must {{ report [any host](#language.schemas.extensions.diagnostics.any_host), since declared hosts aren't filtered one by one }}
    }

    trust_first_run: rule(extension_process, by = product.system.extension_host) {
      when {{ an extension is about to run for the first time on a machine, keyed by a hash of its command and limits }}
      must {{ ask on the terminal, remember the answer in `.heron/trusted-extensions`, and refuse to run it with [not trusted](#language.schemas.extensions.diagnostics.not_trusted) where there's no terminal }}
      unless {{ `HERON_TRUST_EXTENSIONS=1` is set, which approves without asking }}
    }

    js_host_unlimited: rule(extension_process, by = product.system.extension_host) {
      mustNot {{ limit the [JS host](#language.interop.host.js_host), which runs the project's own modules }}
      instead {{ treat the project's modules as its own code, trusted as its build scripts are }}
    }
  }

  lifecycle: section {
    handshake: rule(extension_process, by = product.system.extension_host) {
      when {{ an extension starts }}
      must {{ negotiate the protocol version and what the extension implements, and report [doesn't implement](#language.schemas.extensions.diagnostics.not_implemented) for every declaration bound to it that it doesn't }}
      then {{ a mismatch with the [schema](#language.schemas.kinds.schema) is a check error, not a runtime surprise }}
    }

    start_failure: rule(extension_process, by = product.system.extension_host) {
      if {{ an extension's command can't start }}
      must {{ report [can't start](#language.schemas.extensions.diagnostics.cant_start) for each declaration bound to it }}
    }

    one_process: rule(extension_process, by = product.system.extension_host) {
      must {{ start one process per extension per tree, on first use, and restart it after a crash, failing the calls in flight }}
    }

    run_id_on_requests: rule(extension_process, by = product.system.extension_host) {
      must {{ carry the run id on every request, and count calls into an extension toward the gas and timeouts of the node that made them }}
    }

    builtins_same_contract: rule(extension_process, by = product.system.extension_host) {
      must {{ register built-in funcs, macros, transports, resource drivers and generation adapters by the path of the declaration they implement, the same way an extension's are }}
      then {{ a later registration under a path replaces an earlier one, so an external part can replace a built-in one }}
    }
  }

  @display("What an extension can provide")
  provides: section {
    | Funcs and macros, lints and their fixes, generators such as a harness or CI-host
    | adapter, resource drivers with setup, reset, snapshot and teardown, release-note and
    | version formats, and formatters for languages embedded in raw bodies. The messages
    | that carry them are the extension protocol's, under interop.
  }

  diagnostics: section {
    not_implemented: diagnostic("extension", by = product.system.extension_host) {
      message = "‹declaration›: ‹extension› doesn't implement it"
    }

    cant_start: diagnostic("extension", by = product.system.extension_host) {
      message = "‹declaration›: ‹extension› can't start: ‹error›"
    }

    any_host: diagnostic("extension", severity = warning, by = product.system.extension_host) {
      message = "‹extension›: it may reach any host: per-host network limits (‹hosts›) aren't enforced yet"
      | Printed on standard error each time the extension starts.
    }

    limits_not_enforced: diagnostic("extension", severity = warning, by = product.system.extension_host) {
      message = "‹extension›: its file and network limits aren't enforced: ‹why›"
      | Printed on standard error each time the extension starts.
    }

    not_trusted: diagnostic("extension", by = product.system.extension_host) {
      message = "‹extension› hasn't run on this machine before: run it once from a terminal to approve it, or set HERON_TRUST_EXTENSIONS=1"
      | Thrown as a `ForeignError` from the first call, where no terminal can ask.
    }
  }

  @display("Example: an extension")
  compliance_extension: example {
    | ```heron
    | // acme/compliance/package.heron
    | import = ["std/schema@1"]
    |
    | compliance: extension(command = ["acme-compliance", "serve"])
    |
    | @extern(compliance)
    | redact(text: String): func(String)
    |
    | @extern(compliance)
    | no_plain_secrets: lint
    |
    | @extern(compliance)
    | vault: resource(Secrets)
    | ```
  }
}
