overloads: section {
  | One kind can have several signatures, each declared with `<overload>` on its name. A call
  | takes the first that fits, so `link` takes a URL or a node.

  overload: term {{
    One of several signatures of a kind, each a declaration of the same name marked
    `<overload>`, as `link<overload>(uri: String)` and `link<overload>(target: Ref(Any))`.
  }}

  overload_selection: rule(overload, by = product.system.checker) {
    when {{ a kind with [overloads](#language.schemas.overloads.overload) is called }}
    must {{ check the arguments against each signature in declaration order without reporting, and take the first with no errors }}
    then {{ the instance's fields and children follow the chosen signature }}
    example {{ `link("https://example.com")` and `link(uri = "https://example.com")` take the first signature, `link(overview)` and `link(target = overview)` the second }}
  }

  paths_are_refs: rule(overload, by = product.system.checker) {
    while {{ signatures are tried }}
    must {{ read a path that names a declared node as a reference, never as a [scalar](#language.data.values.scalar) }}
    example {{ `link(overview)` takes the `Ref` signature although a path could pass for a string }}
  }

  no_overload_fits: rule(overload, by = product.system.checker) {
    if {{ no signature fits }}
    must {{ report the first signature's errors, as for a kind without [overloads](#language.schemas.overloads.overload) }}
    example {{ `link(href = "x")` reports "link takes no argument href" }}
  }

  overloads_together: rule(overload, by = product.actors.author) {
    must {{ flag every signature of an overloaded kind `<overload>`, and declare them in one package }}
    | A declaration without the flag is declared twice, which is a
    | [conflict](#language.core_format.conflicts.diagnostics.declared_twice).
  }
}
