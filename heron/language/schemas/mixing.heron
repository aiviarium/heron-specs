mixing: section {
  | Prose and structure mix in both directions, and packages mix with each other, through
  | one content model: what a body accepts is its kind's [schema](#language.schemas.kinds.schema), and the same kinds stand as
  | children in structure and as tags in prose.

  implied_kinds: term {{
    Kinds the [schema](#language.schemas.kinds.schema) implies where none is written. A kind with `heading = true` is what a
    heading in a [prose file](#language.core_format.prose_layer.prose_file) becomes; one
    with `typed = true` reads the expression after `:` as a type, so `amount: Money?` in a
    type's body is a `member`. A scope has no kind of its own: it amends what its path
    names.
  }}

  both_directions: rule(language.schemas.mixing, by = product.system.checker) {
    must {{ admit an accepted kind as a child in structure and as a tag in prose alike, with the same arguments and children }}
    example {{ `note(kind = tip) { | Text }` and `<note kind="tip">Text</note>`: the same node }}
  }

  heron_file_root: rule(language.schemas.mixing, by = product.system.checker) {
    must {{ let a [Heron file](#language.core_format.files.heron_file)'s root hold any member, of any kind of the packages in its `import` }}
  }

  prose_file_root: rule(language.schemas.mixing, by = product.system.checker) {
    must {{ let a [prose file](#language.core_format.prose_layer.prose_file)'s root hold prose, tags of `block` and `inline` kinds, headings and `heron` fences }}
  }

  extend_from_own_side: rule(language.schemas.mixing, by = product.system.checker) {
    must {{ let a package join another package's category with `in`, and attach its flags and annotations to another package's kinds with `on`, valid only where the extending package is in `import` }}
    example {{ `std/http` attaches `@body` and `@path` to `types.param` without touching `std/types` }}
  }
}
