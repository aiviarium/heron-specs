annotations: section {
  | A package declares an annotation with `annotation(on)`: its parameters are what the
  | annotation takes, and its body may `accept` children, as a kind's does. Like a flag, it
  | names the kinds it attaches to from its own side. A category in `on` keeps the set open: a
  | kind of another package that joins the category takes the annotation too, so a core
  | annotation such as `@rev`, `on = [rule, …, revised]`, reaches `std/project`'s `proves`,
  | declared `in = [block, revised]`, while the core never names `std/project`.

  declaring_annotations: rule(system.checker) {
    must {{ check an annotation's arguments against its declaration's parameters, as a call's are }}
    example {{ the core declares `status(code: Int): annotation(on = [error, types.type])`, which takes `@status(404)` }}
  }

  annotation_on: rule(system.linter) {
    while {{ an annotation is declared with `on`, a list of kinds and categories }}
    should {{ report annotation placement where it stands on a node whose kind fits none of them }}
    while {{ the annotation's `on` lists kinds or categories }}
  }

  annotation_on_params: rule(system.linter) {
    while {{ an annotation stands on a parameter, as `get_one(@path id: String): op` }}
    should {{ report annotation on a parameter unless its `on` names a kind of typed members that parameters are, such as `types.param` }}
  }

  repeatable: rule(system.linter) {
    if {{ an annotation stands twice on one node and its declaration isn't flagged `annotation<repeatable>` }}
    should {{ report annotation repeated at the second }}
  }

  errors: section {
    @status(422)
    @severity(warning)
    annotation_misplaced: error("annotation-placement") {
      title = "@{annotation} doesn't attach to {kind}; it attaches to {kinds}"
      annotation: String
      kind: String
      kinds: String
      | On a node with no kind, the kind reads "this node".
      | Reported as [language.apis.params.location_placement], [language.core_format.nodes.annotations.annotation_placement] and [language.schemas.annotations.annotation_on] say.
    }

    @status(422)
    @severity(warning)
    annotation_on_param: error("annotation-placement") {
      title = "@{annotation} doesn't attach to a parameter; it attaches to {kinds}"
      annotation: String
      kinds: String
      | Reported as [language.schemas.annotations.annotation_on_params] says.
    }

    @status(422)
    @severity(warning)
    annotation_repeated: error("annotation-placement") {
      title = "@{annotation} stands twice on one node, and it isn't <repeatable>"
      annotation: String
      | Reported as [language.schemas.annotations.repeatable] says.
    }
  }
}
