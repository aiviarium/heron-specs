files: section {
  | A tree is read from one file, its [entry point](#language.core_format.files.entry_point), and the files it reaches through
  | `include`. Packages and helper files reached through `import` are seen but aren't part
  | of the tree.

  heron_file: term {{
    A file in the core format, ending in `.heron`, whose root is structure. A file ending
    in `.heron.md` is a [prose file](#language.core_format.prose_layer.prose_file) instead.
  }}

  entry_point: term {{
    The file a tree starts from. It lists the tree's own files in `include`, in order, and
    the packages it uses in `import`. `index.heron` at the repository root is the default,
    and settings go in an adjacent `settings.heron` it includes at its end.
  }}

  implicit_root: term {{
    The node whose body a file is. The entry point's implicit root is the tree's root; an
    included file's root joins the root or the scope that includes it.
  }}

  @by(system.checker)
  @targets(language.core_format)
  no_core_kinds: rule {
    mustNot {{ define a kind of its own in the core format }}
    instead {{ leave every kind to the packages in `import`, with the core's own names declared in the prelude package `std/core` that every tree sees without importing it }}
  }

  @by(system.checker)
  @targets(heron_file)
  file_kinds: rule {
    must {{ read a file ending in `.heron.md` as a [prose file](#language.core_format.prose_layer.prose_file) and any other file as structure }}
  }

  @by(system.checker)
  @targets(entry_point)
  entry_from_folder: rule {
    must {{ read a folder given as the [entry point](#language.core_format.files.entry_point) as its `index.heron` }}
    then {{ `heron check spec` and `heron check spec/index.heron` check the same tree }}
  }

  @by(system.checker)
  @targets(heron_file)
  one_identity: rule {
    must {{ identify a file on disk by its cleaned absolute path with symbolic links resolved, and a file of a standard package by `std:` and its path, so every spelling of one file is one file }}
    then {{ a path that doesn't exist yet is identified through its nearest existing parent, so an editor's unsaved file has its identity before it's written }}
  }

  @by(system.checker)
  @targets(entry_point)
  one_tree: rule {
    must {{ resolve references within the entry point's tree and combine amends across its files }}
    then {{ [entry points](#language.core_format.files.entry_point) can share files, so one repository holds more than one tree, and a file checks differently in each tree that reaches it }}
  }

  @by(system.linter)
  @targets(entry_point)
  unreachable_file: rule {
    if {{ a `.heron` file in the project is reached by no [entry point](#language.core_format.files.entry_point) }}
    should {{ report unreachable file, since nothing checks it }}
  }

  @by(system.checker)
  @targets(entry_point)
  directives: rule {
    if {{ `include` or `import` is set to anything but a list of plain strings }}
    must {{ report not a list, or not a plain string at an entry that's interpolated or not a string, and skip the entry }}
  }

  @display("An entry point")
  entry_point_example: example {
    | ```heron
    | // payments/index.heron: the entry point
    | version = "0.3"
    |
    | import = ["std/doc@1", "std/types@1"]
    |
    | include = [
    |   "./model.heron",
    |   "./api.heron",
    |   "./disputes/",        // follows the folder: disputes/index.heron mounted as disputes
    | ]
    |
    | // The matched files are mounted under refunds and see its names.
    | // std/doc and std/types reach them from here, so they import neither.
    | refunds.{
    |   include = ["./refunds/*.heron"]
    | }
    | ```
  }

  errors: section {
    @realizes(language.core_format.files.directives)
    @by(system.checker)
    not_a_list: error("directive") {
      title = "{directive} takes a list of strings"
      directive: field(String)
      | ‹directive› is `include` or `import`.
    }

    @realizes(language.core_format.files.directives)
    @by(system.checker)
    not_plain: error("directive") {
      title = "{directive} entries are plain strings"
      directive: field(String)
    }

    @realizes(language.core_format.files.unreachable_file)
    @by(system.linter)
    @severity(warning)
    unreachable_file: error("unreachable-file") {
      title = "no entry point reaches {file}, so nothing checks it"
      file: field(String)
    }
  }
}
