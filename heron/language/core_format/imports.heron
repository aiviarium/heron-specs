imports: section {
  | `include` joins a tree's own files to it; `import` makes packages and helper files
  | visible without making them part of it. Both are set at a file's root or in a scope,
  | and both take a list of plain strings.

  include_term: term {{
    How a tree's own files join it. At a file's root an included file's nodes join that
    root flat; inside a scope, `refunds.{ include = […] }`, they're mounted under
    `refunds` and see its names. `include = ["./refunds/"]` [mounts](#language.core_format.mounts.mount) the folder's
    `index.heron` under a node named after the folder, and entries can be globs,
    `"./refunds/**/*.heron"`, with `"!./refunds/draft.heron"` excluding one.
  }}

  import_term: term {{
    How a tree uses packages and helper files without exporting them. Their nodes
    resolve in this scope and below but aren't part of the tree, so they aren't
    rendered, generated or reachable by path, except a package's nodes flagged
    `<export>`.
  }}

  includes: section {
    include_order: rule(system.checker) {
      must {{ use include order as the document order when rendering and as the layering order for amends }}
    }

    include_paths: rule(system.checker) {
      must {{ resolve an include entry relative to the file that writes it }}
    }

    missing_include: rule(system.checker) {
      if {{ no file or folder is at an include entry's path }}
      must {{ report no such include and include nothing for the entry }}
    }

    includes_are_guarded: rule(system.checker) {
      when {{ a file is included a second time, by any spelling }}
      must_not {{ copy it or declare anything twice }}
      instead {{ only let the file see that scope too }}
    }

    include_cycles: rule(system.checker) {
      must {{ accept includes that reach each other in a cycle, reading each file once }}
    }

    globs_are_deterministic: rule(system.checker) {
      must {{ use the matches of a glob in path order, include a file matched twice once, keep the place of a file listed explicitly, and drop the files a `!` entry matches }}
    }

    rounds: rule(system.checker) {
      must {{ resolve names declared further down or in a later include }}
      then {{ ordering matters only where two amends set the same path, and then the later one wins }}
    }
  }

  packages: section {
    | A package is named by its path and a major version, as `std/doc@1`. The
    | [standard packages](#language.std) are built into the binary; the registry, npm and git
    | are sources `heron run setup` installs from.

    imports_are_scoped: rule(system.checker) {
      must {{ make a package imported in a file visible there and in everything that file includes, and nowhere else }}
    }

    package_versions: rule(system.checker) {
      must {{ resolve a package by its name and major version, and report an entry it can't resolve with one of the import [diagnostics](#language.core_format.imports.errors) }}
      example {{ `std/ci@1`: the newest `1.x` }}
    }

    lock_pins: rule(system.interpreter) {
      must {{ write `heron.lock` with the exact version and checksum of every package `heron run setup` installs }}
    }

    branch_pins: rule(system.interpreter) {
      while {{ `heron.lock` pins a package from git at a branch with its commit, as a package is pinned before its first release }}
      must {{ install it from that commit and keep the pin, asking the remote for no tag }}
    }

    file_imports: rule(system.checker) {
      must {{ resolve an entry that starts with `./` or `../` as a file or folder relative to the importing file, and a folder import as its `index.heron`, visible both directly and under the folder's name }}
    }

    prelude: rule(system.checker) {
      must {{ make the core visible in every tree without an import: `std/core`, and `std/spec` in every tree but the packages the core is written with, `std/core`, `std/schema`, `std/types` and `std/doc`; and the primitive types `String`, `Bool`, `Int`, `Float`, `Decimal`, `Bytes`, `Any`, `Object`, `Null`, `Prose`, `List`, `Set`, `Map` and `Self` as the outermost scope }}
      then {{ a spec writes its rules, errors and their annotations with no import }}
    }

    import_cycle: rule(system.checker) {
      if {{ imports form a cycle, other than those among the core, `std/core` and `std/spec`, and the packages it's written with, `std/schema`, `std/types` and `std/doc`, which the format describes itself with }}
      must {{ report import cycle, naming each file of the cycle }}
    }

    repeated_import: rule(system.linter) {
      if {{ a file imports a package that the scope it's included in already imports }}
      should {{ report repeated import }}
    }
  }

  errors: section {
    @status(422)
    @severity(warning)
    repeated_import: error("repeated-import") {
      title = "{package} is already imported where this file is included, so it needs no import here"
      package: String
      | Reported as [language.core_format.imports.packages.repeated_import] says.
    }

    @status(422)
    unknown_package: error("import") {
      title = "unknown package {name}"
      name: String
      | `std/nosuch@1`: no package of that name is built in or installed.
      | Reported as [language.core_format.imports.packages.package_versions] says.
    }

    @status(422)
    no_major: error("import") {
      title = "{entry}: a package import names a major version, as in {entry}@1"
      entry: String
      | `std/doc`: the entry has no `@`.
      | Reported as [language.core_format.imports.packages.package_versions] says.
    }

    @status(422)
    bad_major: error("import") {
      title = "{entry}: the version after @ is a major version number"
      entry: String
      | `std/doc@x`: what follows `@` isn't a whole number.
      | Reported as [language.core_format.imports.packages.package_versions] says.
    }

    @status(422)
    wrong_major: error("import") {
      title = "{name}@{major}: the package is version {version}"
      name: String
      major: String
      version: String
      | `std/doc@2` when the package is version 1.0.
      | Reported as [language.core_format.imports.packages.package_versions] says.
    }

    @status(422)
    not_installed: error("import") {
      title = "{entry}: packages from {source} are installed by `heron run setup`, and this one isn't installed yet"
      entry: String
      source: String
      | `npm:foo@1`, or `git+https://host/repo//folder@v1`, before `heron run setup` has installed it; ‹source› is npm or git.
      | Reported as [language.core_format.imports.packages.lock_pins] says.
    }

    @status(422)
    no_such_import: error("import") {
      title = "cannot import {path}: no such file"
      path: String
      | `./nofile.heron`: a file import whose file doesn't exist.
      | Reported as [language.core_format.imports.packages.file_imports] says.
    }

    @status(422)
    no_such_include: error("include") {
      title = "cannot include {path}: no such file"
      path: String
      | An include entry whose file or folder doesn't exist.
      | Reported as [language.core_format.imports.includes.missing_include] says.
    }

    @status(422)
    import_cycle: error("import-cycle") {
      title = "import cycle: {a} → {b} → {a}"
      a: String
      b: String
      | Imports that form a cycle, standard packages' included, other than those among `std/core`, `std/spec`, `std/schema`, `std/types` and `std/doc`.
      | Reported as [language.core_format.imports.packages.import_cycle] says.
    }
  }
}
