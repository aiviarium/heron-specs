nodes: section {
  | Every member is a node, a value or a piece of text, and every node has a kind, given or
  | inferred, so no line is ever a loose fragment. What stands on the left or above decides
  | what's valid on the right or below.
  |
  | | Shape       | Syntax                                         | Used for                                       |
  | | ----------- | ---------------------------------------------- | ---------------------------------------------- |
  | | Declared    | `name<flags>(params): kind<flags>(args) { … }` | Anything referred to by name                   |
  | | Typed value | `name: Type = value`                           | A field or constant with its type              |
  | | Entered     | `name { … }`                                   | Amending a node that already exists            |
  | | Scope       | `name.{ … }`                                   | Amending a path, creating it if needed         |
  | | Created     | `kind(args) { … }`                             | Instances nobody refers to by name             |
  | | Set         | `path = value`                                 | Setting a field that exists                    |
  | | Local       | `let name = value`                             | A helper value that is never emitted           |
  | | Prose       | pipe lines, `{{ … }}`                          | The node's own text                            |

  kind_slot: term {{
    The place after `:` in a declaration. Kind and type share it: `limit: rule` and
    `amount: Money` are the same construct, and so are `case(…)` and
    `String(max = 500)`. The kind decides which arguments and children a node may have.
  }}

  left_to_right: rule(language.core_format.nodes, by = system.checker) {
    must {{ decide what's valid on the right or below from what stands on the left or above }}
    then {{ the parent scope decides a name's flags, the kind its arguments and children, and `import` which annotations exist }}
  }

  bodies_hold_members: rule(language.core_format.nodes, by = system.checker) {
    must {{ configure a node only through its kind's arguments, fields and accepted children, never through free text }}
    then {{ the kind decides which members of its body are valid }}
  }

  declaring: section {
    | `name: kind …` and `name: Type = value` declare a node. A name is declared once in its
    | scope; every other mention enters, sets or refers to it.

    declared_kinds: rule(language.core_format.nodes.kind_slot, by = system.checker) {
      if {{ the [kind slot](#language.core_format.nodes.kind_slot) names nothing in scope, or something that's neither a kind nor a type }}
      must {{ report unknown kind or type with the closest name in scope, or not a kind or a type }}
    }

    declared_once: rule(language.core_format.nodes.declaring, by = system.checker) {
      if {{ a name is declared a second time in the same scope }}
      must {{ report declared twice at the second declaration, with the first as its related site }}
    }
  }

  entering: section {
    | `name { … }` enters a node that already exists and amends it. Entering can be
    | repeated, so `development { … }` in the index and again in `settings.heron` amend the
    | same node, and a field a type declares is entered the same way.

    enter_never_creates: rule(language.core_format.nodes.entering, by = system.checker) {
      if {{ `name { … }` names no node that exists and no field its parent's type declares }}
      mustNot {{ create a node }}
      instead {{ report entering never creates with the closest field }}
      while {{ the parent is closed }}
    }

    enter_never_creates_otherwise: rule(language.core_format.nodes.entering, by = system.checker) {
      where {{ the parent is open: the file root, a map or an untyped node }}
      must {{ create the node it enters }}
    }

    enter_anywhere_in_order: rule(language.core_format.nodes.entering, by = system.checker) {
      must {{ let a node be entered before or after its declaration, in any file of the tree }}
    }
  }

  creating: section {
    | `kind(args)`, with an optional body, creates an anonymous node, as in
    | `case(days_ago = 31)`. A kind that only holds text needs no parentheses:
    | `example {{ requested on day 30: accepted }}` creates an example, because a `{{ }}`
    | body never enters an existing node. Naming it is only a prefix.

    calls_construct: rule(language.core_format.nodes.creating, by = system.checker) {
      when {{ a body calls a kind with parentheses, or names a kind with a `{{ }}` body and no node of that name exists }}
      must {{ construct a new node of that kind }}
      then {{ a bare name before `{` always means the node that exists, so a kind instance with a structure body and no arguments is written with a name }}
    }

    calls_yield: rule(language.core_format.nodes.creating, by = system.interpreter) {
      must {{ add to the body what a call in it yields: a kind call its node, a macro its members, and a func the nodes it returns }}
      then {{ a call that yields nothing just runs, at check time }}
    }

    arguments: rule(language.core_format.nodes.creating, by = system.checker) {
      must {{ fill a kind's or call's parameters from its arguments: positional ones in declaration order, named ones by name }}
    }

    argument_errors: rule(language.core_format.nodes.creating, by = system.checker) {
      if {{ there are more positional arguments than parameters, a named argument names no parameter, or a required parameter has no argument }}
      must {{ report an argument past the last parameter, an unknown argument with the closest parameter, or a missing argument }}
    }
  }

  params_and_args: term {{
    Two different lists. `(name: Type)` directly after the name declares inputs that
    callers and cases supply; `(name = value)` directly after the kind configures the kind.
    Both attach with no space. Positional arguments fill parameters in declaration order,
    so `code("sh", "Example File")` is `code(lang = "sh", title = "Example File")`, and a
    free-standing `( … )` in front of a value is a [cast](#language.grammar.code.expressions.cast), not a list.
  }}

  variadic_params: rule(params_and_args, by = system.checker) {
    when {{ a parameter is flagged `<variadic>` }}
    must {{ accept any number of positional arguments for it, each of the parameter's type, or one list of them }}
    example {{ `type(Audited, Owned)` and `type([Audited, Owned])`: the same }}
  }

  flags: section {
    flag_term: term {{
      A name in `< >` directly after a name or a kind, with no space. On the kind it
      qualifies the kind, as in `task<confirm>`; on the name it qualifies the name and is
      valid only where the parent scope declares it. `< >` holds flags only: type
      arguments are ordinary arguments, as in `List(Payment)`.
    }}

    known_flags: rule(flag_term, by = system.checker) {
      if {{ a flag names no flag declared in scope }}
      must {{ report unknown flag with the closest flag in scope }}
      while {{ the flag is outside the core set the prelude `std/core` declares everywhere, `variadic` and `export` }}
    }

    flag_placement: rule(flag_term, by = system.linter) {
      if {{ a flag declared with `on = […]` stands on a kind or annotation it doesn't attach to }}
      should {{ report flag placement }}
    }
  }

  annotations: section {
    annotation_term: term {{
      `@name(args)` on the lines above a node, or in front of it on the same line. It
      attaches package data to the node, so it's always visible where a field comes from.
      Text goes in `///` lines, which become `@doc`, never in arguments.
    }}

    annotations_resolve: rule(annotation_term, by = system.checker) {
      if {{ an annotation names nothing in scope, or something that isn't an annotation }}
      must {{ report unknown annotation with the closest annotation, or not an annotation }}
      while {{ the annotation is outside the prelude's, such as `@doc` and `@display`, which exist without an import }}
    }

    annotation_placement: rule(annotation_term, by = system.linter) {
      if {{ an annotation stands where its declaration's `on` doesn't allow it, or twice on one node without being `<repeatable>` }}
      should {{ report annotation placement, naming where it attaches }}
    }
  }

  locals: section {
    local_term: term {{
      A value bound with `let name = value`, or `let name: Type = value` for a typed one.
      It's visible from its line down in its own body and all nested ones.
    }}

    locals_visible_below: rule(local_term, by = system.checker) {
      must {{ make a local visible only below the line that binds it, in its body and the bodies nested in it }}
      example {{ a use above the line reports [unknown name](#language.core_format.naming.errors.unknown_name) }}
    }

    locals_stay_out: rule(local_term, by = system.checker) {
      mustNot {{ emit, encode or expose a local by path to another file }}
    }

    locals_never_change: rule(local_term, by = system.checker) {
      mustNot {{ let a local be set }}
      instead {{ read `name = value` below a `let name` as setting a field of the node }}
    }

    unused_locals: rule(local_term, by = system.linter) {
      if {{ nothing below a `let` uses it }}
      should {{ report unused let }}
    }
  }

  errors: section {
    @realizes(language.core_format.nodes.declaring.declared_kinds)
    unknown_kind: error("unresolved", by = system.checker) {
      title = "unknown kind or type {name}"
      name: field(String)
    }

    @realizes(language.core_format.nodes.declaring.declared_kinds)
    not_a_kind: error("not-a-kind", by = system.checker) {
      title = "{name} is not a kind or a type"
      name: field(String)
    }

    @realizes(language.core_format.nodes.entering.enter_never_creates)
    entered_missing: error("unresolved", by = system.checker) {
      title = "{path} doesn't exist, and entering never creates a node"
      path: field(String)
    }

    @realizes(language.core_format.nodes.creating.argument_errors)
    too_many_arguments: error("too-many-arguments", by = system.checker) {
      title = "{callee} takes {n} positional arguments"
      callee: field(String)
      n: field(String)
      | ‹callee› is the kind or type as `kind note` or `type Refund`, and the plural follows
      | ‹n›: "takes 1 positional argument".
    }

    @realizes(language.core_format.nodes.creating.argument_errors)
    unknown_argument: error("unknown-argument", by = system.checker) {
      title = "{callee} takes no argument {name}"
      callee: field(String)
      name: field(String)
    }

    @realizes(language.core_format.nodes.creating.argument_errors)
    missing_argument: error("missing-argument", by = system.checker) {
      title = "{callee} needs the argument {name}"
      callee: field(String)
      name: field(String)
    }

    @realizes(language.core_format.nodes.flags.known_flags)
    unknown_flag: error("unresolved", by = system.checker) {
      title = "unknown flag {name}"
      name: field(String)
    }

    @realizes(language.core_format.nodes.annotations.annotations_resolve)
    unknown_annotation: error("unresolved", by = system.checker) {
      title = "unknown annotation @{name}"
      name: field(String)
    }

    @realizes(language.core_format.nodes.annotations.annotations_resolve)
    not_an_annotation: error("not-an-annotation", by = system.checker) {
      title = "{name} is not an annotation"
      name: field(String)
    }

    @realizes(language.core_format.nodes.locals.unused_locals)
    unused_let: error("unused-let", severity = Severity.warning, by = system.linter) {
      title = "let {name} is never used"
      name: field(String)
    }
  }
}
