@display("Responses and errors")
responses: section {
  | An op's [result type](#language.apis.responses.result_type) is its success, and its errors are declared beside it with
  | `@throws`, so the [result type](#language.apis.responses.result_type) never has to wrap a failure. How each outcome travels is
  | the transport's: an HTTP status, a gRPC status or a WebSocket error frame.

  result_type: term {{
    The type an op returns on success, its first argument as in `op(Refund)`. A
    `Stream(T)` result is a [stream](#language.apis.streams.stream_type) of `T`.
  }}

  throws_annotation: term {{
    The annotation of `std/types` for the errors an op may throw, `@throws(RefundError)` above
    the op, or above an api for all of its ops. It takes any number of errors and may be
    written more than once.
  }}

  status_annotation: term {{
    `std/http`'s annotation for the status code an error is answered with over HTTP,
    `@status(422)` above a type that implements `Error`.
  }}

  @by(system.docs_generator)
  @targets(throws_annotation)
  api_errors_add: rule {
    must {{ add the errors of an api's `@throws` to each of its ops' own, the op's first }}
  }

  @by(system.docs_generator)
  @targets(throws_annotation)
  interface_errors: rule {
    where {{ `@throws` names an interface }}
    must {{ read it as every type that implements the interface }}
    example {{ `@throws(StoreError)` lists `NotFound` with 404 and `Conflict` with 409 when both implement `StoreError` }}
  }

  @by(system.docs_generator)
  @targets(result_type)
  responses_shown: rule {
    must {{ show an op's responses as its success, with status 200 when it's bound to HTTP, and then each error it declares, with its `@status` }}
    then {{ an op with no [result type](#language.apis.responses.result_type) shows no success body }}
  }

  @by(system.checker)
  @targets(throws_annotation)
  thrown_types_are_errors: rule {
    if {{ `@throws` names a type that doesn't implement `Error` }}
    must {{ report not an error at the name }}
  }

  @by(system.linter)
  @targets(status_annotation)
  status_on_errors: rule {
    if {{ `@status` stands on a type that doesn't implement `Error`, or gives a code outside 400 to 599 }}
    should {{ report status outside an error at the annotation }}
  }

  @by(system.interpreter)
  @targets(throws_annotation)
  transport_errors: rule {
    when {{ a transport answers a call with a declared error }}
    must {{ throw it in the caller as a Heron error of that type, with its fields }}
    then {{ `attempt(…)` catches it like any [thrown error](#language.scripting.code.thrown_error) }}
  }

  errors: section {
    @realizes(language.apis.responses.status_on_errors)
    @display("Status outside an error")
    @by(system.linter)
    @severity(warning)
    status_misplaced: error("status") {
      title = "@status({code}) stands on {type}, which isn't an error with a 4xx or 5xx code"
      code: field(String)
      type: field(String)
      | A status code on a type no op can throw, or one that doesn't signal an error.
    }
  }
}
