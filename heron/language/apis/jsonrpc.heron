@display("JSON-RPC")
jsonrpc: section {
  | `@jsonrpc` of `std/jsonrpc` binds ops to JSON-RPC 2.0 methods: on an api for every op of
  | it, or on one op alone, with the method's name as its first argument. A request is an
  | object with `jsonrpc`, `id`, `method` and `params`, and its response has the request's
  | `id` and a `result` or an `error`. An op with no [result type](#language.apis.responses.result_type)
  | is a [notification](#language.apis.jsonrpc.jsonrpc_notification), which is never answered. How the messages are framed, over HTTP, with
  | the language server protocol's `Content-Length` headers, length-prefixed or one per
  | WebSocket frame, and whether they're JSON or CBOR, is the api's.

  @display("JSON-RPC method")
  jsonrpc_method: term {{
    An op bound by `@jsonrpc`, named on the wire by `@jsonrpc("parcels.get")` or by the op's
    name, as `get_parcel`.
  }}

  @display("JSON-RPC notification")
  jsonrpc_notification: term {{
    A [JSON-RPC method](#language.apis.jsonrpc.jsonrpc_method) whose op has no [result type](#language.apis.responses.result_type): sent without an `id`, and never answered, not even with an error.
  }}

  params_structure: term {{
    How a method's `params` holds the op's parameters, from `std/jsonrpc`'s
    `ParamStructure`: `by_name`, an object of the parameters by name, or `by_position`, an
    array of them in the order written. A parameter marked `@params` is the whole of
    `params` instead, as the language server protocol's methods take theirs.
  }}

  @display("JSON-RPC framing")
  jsonrpc_framing: term {{
    How an api's messages travel, from `std/jsonrpc`'s `Framing`: `http`, each request
    sent with POST to the [server URL](#language.apis.rpc.server_url) and answered in the response;
    `content_length`, the language server protocol's `Content-Length` header and a blank
    line before each message; `length_prefixed`, a 4-byte big-endian length before each;
    and `websocket`, one message per frame.
  }}

  @display("JSON-RPC code")
  jsonrpc_code: term {{
    The [RPC code](#language.apis.rpc.rpc_code) of `std/jsonrpc`, `@code(-32004)`, an
    integer that the error object's `code` carries. JSON-RPC reserves -32768 to -32000: the
    predefined codes -32700 and -32600 to -32603, and -32099 to -32000 for servers' own.
  }}

  methods: section {
    method_names: rule {
      must {{ name a method by its op's `@jsonrpc(method)`, or else by the op's name }}
      example {{ `@jsonrpc("heron/source") source(…)` is `heron/source`, and `get_parcel` with a bare `@jsonrpc` is `get_parcel` }}
    }

    unique_methods: rule(system.checker) {
      if {{ two ops of one api have one method name }}
      must {{ report duplicate method at the second }}
    }

    jsonrpc_arguments: rule(system.checker) {
      must {{ report JSON-RPC argument misplaced at `method` in an api's `@jsonrpc`, and at `batch`, `framing` or `encoding` in an op's }}
    }

    no_streams: rule(system.checker) {
      if {{ an op bound by `@jsonrpc` takes or returns a `Stream` }}
      must {{ report stream over JSON-RPC at the stream }}
      then {{ a method answers once, and progress travels as [notifications](#language.apis.jsonrpc.jsonrpc_notification) of its own }}
    }

    null_results: rule {
      must {{ answer a method whose [result type](#language.apis.responses.result_type) is `Null` with a `result` of `null`, and every other with its result's JSON }}
      example {{ `shutdown(): op(Null)` is answered `{"jsonrpc": "2.0", "id": 1, "result": null}` }}
    }

    notifications_unanswered: rule {
      must {{ send a [notification](#language.apis.jsonrpc.jsonrpc_notification) without an `id`, and never answer one }}
    }

    notifications_throw_nothing: rule(system.checker) {
      if {{ an op with no [result type](#language.apis.responses.result_type) is bound by `@jsonrpc` and declares errors with `@throws`, its own or its api's }}
      must {{ report notification throws at the `@throws` }}
    }

    batches: rule {
      where {{ an api's `@jsonrpc` sets `batch = true` }}
      must {{ accept an array of requests as one message, and answer it with an array of their responses, [notifications](#language.apis.jsonrpc.jsonrpc_notification) left out }}
    }
  }

  params: section {
    by_name: rule {
      must {{ send an op's parameters as an object of its parameters by name, optional ones left out when unset, unless its or its api's `@jsonrpc` sets `params = by_position` }}
      example {{ `move(from: Position, to: Position)` takes `"params": {"from": …, "to": …}` }}
    }

    by_position: rule {
      where {{ an op's or its api's `@jsonrpc` sets `params = by_position` }}
      must {{ send its parameters as an array in the order written, leaving out only trailing optional ones that are unset }}
    }

    whole_params: rule {
      where {{ an op's parameter is marked `@params` }}
      must {{ send that parameter's value as the whole of `params` }}
      example {{ `hover(@params p: HoverParams)` takes `"params": {"textDocument": …, "position": …}`, the fields of `HoverParams` }}
    }

    wire_names: rule {
      must {{ name a method's params, by name, and the fields of its params and result by their names in JSON, where an api's `@keys(case)` sets the case of its ops' parameters and of every type they reach that sets none }}
      then {{ `@keys(camel)` on an api gives it the language server protocol's names, as `textDocument` for `text_document` }}
    }

    params_alone: rule(system.checker) {
      if {{ a parameter marked `@params` isn't its op's only parameter, or its type isn't a record }}
      must {{ report params not alone at it }}
    }
  }

  wire: section {
    framed_messages: rule {
      must {{ frame an api's messages by its `@jsonrpc(framing)`, `http` where it sets none, and encode them as its `encoding` says: JSON, or, for `cbor`, CBOR maps without the `jsonrpc` member }}
      then {{ the language server's api is this binding, `content_length` and JSON }}
    }
  }

  error_objects: section {
    error_object: rule {
      when {{ a method fails with an error it declares }}
      must {{ answer with an error object of the error's [code](#language.apis.jsonrpc.jsonrpc_code), its message, and as `data` its fields, with an `error` node's id first as `id` }}
    }

    reserved_codes: rule(system.linter) {
      if {{ a `@code` of `std/jsonrpc` is from -32768 to -32000, but neither a predefined code nor from -32099 to -32000 }}
      should {{ report reserved error code at it }}
    }

    uncoded_jsonrpc: rule(system.linter) {
      if {{ a [JSON-RPC method](#language.apis.jsonrpc.jsonrpc_method) throws an error with no `@code` of `std/jsonrpc` }}
      should {{ report uncoded JSON-RPC error at the error }}
    }
  }

  @display("A language server in JSON-RPC")
  jsonrpc_example: example {
    | ```heron
    | import = ["std/types@1", "std/jsonrpc@1", "std/json@1"]
    |
    | // The language server protocol's own framing, with each method's params as one
    | // record, its fields named in lower camel case, as textDocument.
    | @jsonrpc(framing = content_length)
    | @keys(camel)
    | language_server: api {
    |   @jsonrpc("textDocument/hover")
    |   @throws(ContentModified)
    |   hover(@params p: HoverParams): op(Hover)
    |
    |   // A request answered with null, and a notification, which is never answered.
    |   shutdown(): op(Null)
    |   @jsonrpc("textDocument/didOpen")
    |   did_open(@params p: DidOpenParams): op
    | }
    |
    | Position: type {
    |   line: Int
    |   character: Int
    | }
    |
    | HoverParams: type {
    |   text_document: String
    |   position: Position
    | }
    |
    | Hover: type {
    |   contents: String
    | }
    |
    | DidOpenParams: type {
    |   uri: String
    |   text: String
    | }
    |
    | @code(-32801)
    | ContentModified: type(Error) {
    |   message: String = "The document changed while the request ran."
    | }
    | ```
  }

  errors: section {
    @display("Duplicate method")
    duplicate_method: error("jsonrpc") {
      title = "{op} is the JSON-RPC method {method}, which {other} already is"
      related = "the op that has the name first"
      op: field(String)
      other: field(String)
      method: field(String)
      | Reported as [language.apis.jsonrpc.methods.unique_methods] says.
    }

    @display("JSON-RPC argument misplaced")
    jsonrpc_argument_misplaced: error("jsonrpc") {
      title = "@jsonrpc on {kind} doesn't take {argument}"
      kind: field(String)
      argument: field(String)
      | Reported as [language.apis.jsonrpc.methods.jsonrpc_arguments] says.
    }

    @display("Stream over JSON-RPC")
    jsonrpc_stream: error("jsonrpc") {
      title = "{op} streams, and a JSON-RPC method answers once"
      op: field(String)
      | Reported as [language.apis.jsonrpc.methods.no_streams] says.
    }

    @display("Notification throws")
    notification_throws: error("jsonrpc") {
      title = "{op} is a notification, which is never answered, so it can't throw {error}"
      op: field(String)
      error: field(String)
      | Reported as [language.apis.jsonrpc.methods.notifications_throw_nothing] says.
    }

    @display("Params not alone")
    params_not_alone: error("jsonrpc") {
      title = "@params {param} must be the only parameter of {op}, of a record type"
      op: field(String)
      param: field(String)
      | Reported as [language.apis.jsonrpc.params.params_alone] says.
    }

    @display("Reserved error code")
    @severity(warning)
    reserved_error_code: error("rpc-code") {
      title = "{code} is in JSON-RPC's reserved range: use a code outside -32768 to -32000, or a server code from -32099 to -32000"
      code: field(String)
      | Reported as [language.apis.jsonrpc.error_objects.reserved_codes] says.
    }

    @display("Uncoded JSON-RPC error")
    @severity(warning)
    uncoded_jsonrpc_error: error("rpc-code") {
      title = "{error} is thrown by {op}, a JSON-RPC method, and has no @code"
      error: field(String)
      op: field(String)
      | Reported as [language.apis.jsonrpc.error_objects.uncoded_jsonrpc] says.
    }
  }
}
