@display("Params and locations")
params: section {
  | An op's parameters are ordinary parameters: a name, a type, `?` when it may be left out
  | and a default. Where a value travels on the wire is the transport's business, so it's
  | written as an annotation of the transport's package on the parameter, never read from
  | the parameter's name: a parameter named `body` is just a parameter.
  |
  | | Annotation        | Package     | The value travels                                    |
  | | ----------------- | ----------- | ---------------------------------------------------- |
  | | `@path`           | `std/http`  | in the path, where the route writes `:name`           |
  | | `@query`          | `std/http`  | in the query string                                  |
  | | `@header(name)`   | `std/http`  | in the header `name`, or the parameter's own name     |
  | | `@body`           | `std/http`  | as the request body                                  |
  | | `@field(n)`       | `std/proto` | as field `n` of the request message                  |

  param_location: term {{
    Where a transport puts a parameter's value in a request: in the path, the query, a
    header or the body for HTTP, or a numbered field of the request message for gRPC. It's
    stated by an annotation on the parameter, or by the transport's default binding.
  }}

  path_parameter: term {{
    A parameter written into an HTTP route as `:name`, as in
    `@http<get>("/payments/:payment_id/refunds")`. The colon keeps braces free for
    interpolation, so a route is never read as an interpolated string.
  }}

  colon_path_params: rule(path_parameter, by = actors.author) {
    must {{ write a [path parameter](#language.apis.params.path_parameter) in a route as `:name`, with the parameter's name }}
  }

  location_annotations: rule(param_location, by = system.checker) {
    must {{ check a location annotation as an ordinary annotation of its package, with its arguments against its parameters }}
    example {{ `@header(name = 1)` reports "expected String, got a number" }}
  }

  location_placement: rule(param_location, by = system.linter) {
    if {{ a location annotation stands on an op or an api rather than a parameter }}
    should {{ report annotation placement, as for any annotation outside its `on` }}
    example {{ `@query` above an op reports "@query doesn't attach to op; it attaches to param" }}
  }

  names_carry_no_location: rule(param_location, by = system.docs_generator) {
    mustNot {{ read a parameter's [location](#language.apis.params.param_location) from its name }}
    instead {{ group an op's parameters by their annotations, showing a parameter with none among the plain parameters, or as the body when it's the record of an HTTP op }}
    example {{ `note(@path id: String, body: String)` shows `body` as a plain parameter, not as the request body }}
  }

  header_name_default: rule(param_location, by = system.docs_generator) {
    where {{ `@header` names no header }}
    must {{ show the parameter as the header named after it }}
    example {{ `@header("Idempotency-Key") key: String` travels as `Idempotency-Key`, and `@header key: String` as `key` }}
  }

  default_binding: rule(param_location, by = system.interpreter) {
    where {{ a parameter of an op bound to `std/http` has no location annotation }}
    must {{ bind it by the transport's default: a parameter the route names as `:name` is a [path parameter](#language.apis.params.path_parameter), and the one remaining parameter whose type is a record is the body }}
  }

  no_guessed_location: rule(param_location, by = system.checker) {
    if {{ the default binding can't place a parameter, or places two parameters in the body }}
    must {{ report unplaced parameter at the parameter }}
    then {{ a binding is never a guess }}
  }

  route_names_params: rule(path_parameter, by = system.checker) {
    if {{ a route's `:name` names no parameter of the op, or a `@path` parameter isn't named in the route }}
    must {{ report route and parameters disagree at the route }}
  }

  errors: section {
    @realizes(language.apis.params.no_guessed_location)
    @display("Unplaced parameter")
    unplaced_parameter: error("binding", by = system.checker) {
      title = "{op} binds {param} nowhere: annotate it with @path, @query, @header or @body"
      op: field(String)
      param: field(String)
      | A parameter of an HTTP-bound op that neither an annotation nor the default binding places.
    }

    @realizes(language.apis.params.route_names_params)
    @display("Route and parameters disagree")
    route_mismatch: error("binding", by = system.checker) {
      title = "the route of {op} names :{name}, which isn't a parameter of the op"
      related = "the op's parameters"
      op: field(String)
      name: field(String)
      | A route segment and the op's [path parameters](#language.apis.params.path_parameter) that don't match one to one.
    }
  }
}
