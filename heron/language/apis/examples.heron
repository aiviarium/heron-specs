@display("Examples on ops")
examples: section {
  | An op's examples are what a reader looks at first and what a check runs. Each one sets
  | the op's parameters and states the outcome next to them, so the same node serves as
  | documentation, a mock response and a contract check.

  op_example: term {{
    A named `example` node in an op's body. It sets the op's parameters as fields, such as
    `request = …`, and states the outcome beside them, `returns = …` or `throws = …`. An
    example may also be only prose, `told: example {{ … }}`.
  }}

  @by(system.checker)
  @targets(op_example)
  example_fields: rule {
    must {{ check an example's fields as the op's parameters, against their types }}
    example {{ `other = 1` in an example of `put(thing: Thing)` reports "store.put.e (a example) has no field other", and `thing = 1` reports "expected Thing, got a number" }}
  }

  @by(system.checker)
  @targets(op_example)
  one_outcome_each: rule {
    must {{ report set twice in one body at a second `returns` or a second `throws` in one example }}
  }

  @by(system.checker)
  @targets(op_example)
  one_outcome: rule {
    if {{ an example sets both `returns` and `throws` }}
    must {{ report two outcomes at the second }}
  }

  @by(system.checker)
  @targets(op_example)
  outcome_types: rule {
    must {{ check `returns` against the op's [result type](#language.apis.responses.result_type) and `throws` against the errors the op and its api declare with `@throws` }}
  }

  @by(system.docs_generator)
  @targets(op_example)
  examples_rendered: rule {
    must {{ show each example of an op as its request, written as a `curl` call, a Heron call and the raw HTTP request when the op is bound to HTTP, and its response with the status of its outcome }}
  }

  @by(system.generator)
  @targets(op_example)
  examples_checked: rule {
    must {{ put [op examples](#language.apis.examples.op_example) into generated OpenAPI, serve them as mock responses, and run them against a running service as contract checks }}
  }

  errors: section {
    @realizes(language.apis.examples.one_outcome)
    @display("Two outcomes")
    @by(system.checker)
    two_outcomes: error("example") {
      title = "{example} states both returns and throws; an example has one outcome"
      related = "the other outcome"
      example: field(String)
      | An [op example](#language.apis.examples.op_example) that both returns a value and throws an error.
    }
  }
}
