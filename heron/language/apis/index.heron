// APIs: apis and ops, their params, responses and streams, the annotations
// that cut across them, the transports that carry them, and examples.
include = [
  "./apis_and_ops.heron.md",
  "./params.heron",
  "./responses.heron",
  "./streams.heron",
  "./cross_cutting.heron.md",
  "./transports.heron.md",
  "./examples.heron",
]

@lens(user, developer)
| APIs and their ops, where their parameters travel, what they answer, how they stream, the annotations that cut across them, the transports that carry them and their examples.

apis_described: goal(measure = "An API is described once, for every transport.") {{
  Teams describe their APIs once and get types, docs and examples for every transport from that description.
}}
