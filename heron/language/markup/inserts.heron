inserts: section {
  | `$name`, `$a.b`, `$f(args)` and `${expr}` insert a value into the text, in the same
  | [forms](#language.grammar.strings.inserts) a string uses. The checker resolves them; the
  | docs show what they insert.

  insertion: term {{
    A `$` form in [prose text](#language.markup.writing.prose_text): a path, a call, or an expression in `${ }` where the end of a
    path would be unclear, as in `${days}-day`.
  }}

  inserts_resolve: rule(insertion, by = product.system.checker) {
    must {{ resolve an insertion's path, and the names of its arguments or expression, in the scope of the text it's written in, and report [unknown name](#language.core_format.naming.diagnostics.unknown_name) for one that resolves nowhere }}
  }

  insert_ends: rule(insertion, by = product.system.parser) {
    must {{ end a path [insertion](#language.markup.inserts.insertion) at the first character that can't continue the path, so a `.` that no name follows is text }}
    example {{ `$order.status.` at the end of a sentence inserts `order.status` and keeps the full stop }}
  }

  insert_prose: rule(insertion, by = product.system.docs_generator) {
    where {{ an insertion's path names a node whose value is prose }}
    must {{ render that prose in place, with its emphasis, links, tags and [insertions](#language.markup.inserts.insertion) }}
  }

  insert_value: rule(insertion, by = product.system.docs_generator) {
    where {{ an insertion's path names a node whose value is anything but prose }}
    must {{ render the value's expression as inline code, highlighted as code }}
    example {{ `$limit` with `limit = 30` renders `30` }}
  }

  insert_node: rule(insertion, by = product.system.docs_generator) {
    where {{ an insertion's path names a node with no value, such as a section }}
    must {{ render it as a link to the node, with its path as inline code }}
  }

  inserted_once: rule(insertion, by = product.system.docs_generator) {
    mustNot {{ read the text an inserted value renders to as markup again }}
    then {{ a value holding `$` or `<` shows those characters }}
  }

  insert_calls_not_run: rule(insertion, by = product.system.docs_generator) {
    where {{ an [insertion](#language.markup.inserts.insertion) is a call or an expression, as `$data(diff)` or `${n + 1}` }}
    must {{ render its result where the arguments are known at generation time, and its source as inline code where they aren't }}
  }
}
