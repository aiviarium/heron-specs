text: section {
  | Inside [prose text](#language.markup.writing.prose_text), emphasis is Markdown's, code is
  | verbatim, and a backslash keeps a character from starting a form. The docs render each;
  | the prose view keeps the words and masks the code.

  emphasis: rule(language.markup.writing.prose_text, by = product.system.docs_generator) {
    must {{ render `**text**` as strong, and `*text*` or `_text_` as emphasis where the markers don't touch a letter or digit on their outer side }}
    then {{ `snake_case_name` and `2*3*4` stay as written }}
  }

  strike: rule(language.markup.writing.prose_text, by = product.system.docs_generator) {
    must {{ render `~~text~~` as struck-through text }}
  }

  code_span_verbatim: rule(language.grammar.lexical.tokens.CodeSpan, by = product.system.docs_generator) {
    must {{ render a code span as inline code holding exactly the characters between its backticks }}
    then {{ `` `$limit` `` shows the dollar sign and the name, never the value }}
  }

  entities: rule(language.markup.writing.prose_text, by = product.system.docs_generator) {
    must {{ read `&amp;`, `&lt;`, `&gt;` and `&quot;` in [prose_text] and in quoted attributes as `&`, `<`, `>` and `"`, and any other `&` as itself }}
  }

  escapes_render: rule(language.grammar.prose.inline_forms.prose_escapes, by = product.system.docs_generator) {
    must {{ render an escape as the character it keeps, without its backslash }}
    example {{ `\$literal` renders as `$literal` }}
  }

  fenced_code_verbatim: rule(language.grammar.prose.inline_forms.fences, by = product.system.docs_generator) {
    must {{ render a fenced block as a code block titled by its info string, holding its lines with their common indentation, and the space after a `|` prefix, removed }}
    then {{ `$`, `<`, `[` and `}}` inside a fence are text, so a fence shows Heron, JSON or shell exactly as written }}
  }

  heron_fence_title: rule(language.grammar.prose.inline_forms.fences, by = product.actors.author) {
    should {{ fence code with three backticks, and use `~~~` only for a fence inside a fenced example whose own fence uses backticks }}
  }
}
