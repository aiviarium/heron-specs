@display("Lens marks")
lens_marks: section {
  | A [lens mark](#tools.docs.lenses.lens_mark), `@lens(names…)`, says which [lenses](#tools.docs.lenses.lens_kind) of the docs a node or a piece of prose
  | is for. On a node it's an annotation like any other; on prose it marks one [prose run](#language.markup.lens_marks.prose_run),
  | so a section can say one thing to its users and another to its implementers.
  | [A marked prose run](#language.markup.lens_marks.marked_prose_example) shows both.

  prose_run: term {{
    One run of a node's own text: consecutive `|` lines, up to the first member that isn't
    one, or one `{{ }}` body. A [lens mark](#tools.docs.lenses.lens_mark) on the line above a run applies to the whole run,
    its paragraphs included.
  }}

  mark_attaches: rule(prose_run, by = product.system.parser) {
    must {{ attach an annotation on the lines directly above a run of `|` lines, or on a `{{ }}` body, to that [prose run](#language.markup.lens_marks.prose_run), as the annotations of any member attach }}
  }

  mark_splits_run: rule(prose_run, by = product.system.parser) {
    must {{ end a run of `|` lines at an annotation line, and start a new [prose run](#language.markup.lens_marks.prose_run) with the `|` lines after it }}
    then {{ two marked blocks can follow each other with nothing between them but the second's mark }}
  }

  one_text_still: rule(prose_run, by = product.system.checker) {
    must {{ join a node's [prose runs](#language.markup.lens_marks.prose_run) into its one text, in the order written, as paragraphs }}
    then {{ a mark changes which lenses show a block, never what the node's text is }}
  }

  mark_checked_on_prose: rule(prose_run, by = product.system.checker) {
    must {{ check a [lens mark](#tools.docs.lenses.lens_mark) on a [prose run](#language.markup.lens_marks.prose_run) as one on a node, reporting [unknown lens](#tools.docs.lenses.diagnostics.unknown_lens) and [not a lens](#tools.docs.lenses.diagnostics.not_a_lens) at the name }}
  }

  only_lens_on_prose: rule(prose_run, by = product.system.linter) {
    if {{ a [prose run](#language.markup.lens_marks.prose_run) carries an annotation other than `@lens` }}
    should {{ report [annotation placement](#language.schemas.annotations.diagnostics.annotation_misplaced) at it }}
  }

  @display("A marked prose run")
  marked_prose_example: example {
    | ```heron
    | import = ["std/doc@1", "std/docs@1"]
    |
    | refunds: section {
    |   @lens(user)
    |   | Open the payment and press **Refund**. A refund can't be undone.
    |
    |   @lens(developer, explore)
    |   | A refund moves the payment from `captured` to `refunded`, and the ledger records
    |   | it once the provider confirms.
    | }
    |
    | docs {
    |   lenses = [user, developer, explore]
    | }
    | ```
  }
}
