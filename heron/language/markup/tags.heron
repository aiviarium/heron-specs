@display("Kind elements")
tags: section {
  | A kind element writes a node in text, in the form HTML writes an element:
  | `<warning>…</warning>`, `<kbd>R</kbd>`, `<toc depth="2" />`, or
  | `<step id="install">…</step>`, a named node with a page of its own. Its name is a kind,
  | its attributes are the kind's arguments, and its content is the kind's body. There's no
  | raw HTML: an element that names no kind is an error, never markup passed through, and a
  | `class`, a `style` or a `<script>` is an error like any other undeclared name.

  @display("Kind element")
  component_tag: term {{
    An element in [prose text](#language.markup.writing.prose_text) naming a kind in scope: `<kind attr="text" other={expr} flag>content</kind>`,
    or `<kind … />` with no content. On lines of its own it's a block; inside a sentence it's
    inline. Either may span several lines and nest.
  }}

  tag_attribute: term {{
    `name="text"`, `name={expr}` or a bare `name` in an element's head: an argument of the
    element's kind by name. A bare attribute is `true`. `id` names the element's node, and
    `@name` is an annotation on it.
  }}

  tags_are_kinds: rule(system.checker) {
    must {{ resolve an element's name as a name in code is resolved, and where that names nothing, by suffix as a [link path](#language.core_format.naming.link_path) is, to a kind; and report unknown tag with the closest kind where it names none }}
    then {{ prose holds no raw HTML: `<div>` is an error unless a package declares `div` }}
  }

  element_ids: rule(system.checker) {
    must {{ read an element with an `id` attribute as a node named by the `id`, of the element's kind, a child of the node whose text or body holds it, with a [node path](#language.core_format.naming.node_path), an anchor and, as the lens's depth says, a page of its own }}
    then {{ its [display name](#language.core_format.naming.display_name) comes from its `@display` or its name, never from its text, so rewording the text breaks no link }}
  }

  element_bodies: rule(system.checker) {
    must {{ read a named element's content as its kind's body: its text as the node's prose, and each element on lines of its own as a member, named by its `id` or anonymous, in the order written }}
    then {{ `<rule id="late" refs="desk"><must>refuse it</must></rule>` is the rule `late: rule(desk) { must {{ refuse it }} }` }}
  }

  anonymous_elements: rule(system.checker) {
    where {{ an element has no `id` and stands in a node's text or inside a sentence, rather than on lines of its own in a named element's body }}
    must {{ read it as content of that text, which renders in place and declares no node }}
  }

  element_needs_id: rule(system.checker) {
    if {{ an element whose kind has `heading = true`, or a term, has no `id` }}
    must {{ report element needs an id at it }}
  }

  annotation_attributes: rule(system.checker) {
    must {{ read an attribute `@name="args"` or `@name={args}` as the annotation `@name(args)` on the element's node, and a bare `@name` as `@name` with no arguments; a quoted value is one string where the annotation's first parameter takes one, and its arguments as written otherwise, each reference reaching what a [short link](#language.markup.links.short_link) of the same text reaches }}
    example {{ `<concept id="lenses" @lens="user, developer" @display="Lenses">` is `@lens(user, developer) @display("Lenses") lenses: concept`, and `<screen id="refunds" @touch="refunds.window">` is `@touch(refunds.window) refunds: screen` }}
  }

  code_stays_in_heron: rule(system.checker) {
    if {{ an element's kind has a code body, a `do` block, and no prose }}
    must {{ report code in an element at it }}
    then {{ tasks and funcs are written in a [Heron file](#language.core_format.files.heron_file) }}
  }

  quoted_attributes: rule(system.parser) {
    if {{ an attribute's value is written without quotes or braces, as `depth=2` }}
    must {{ report unquoted attribute at it and keep the element in the tree }}
    then {{ an element is never repaired as a browser repairs HTML: every element is closed and every value quoted or braced }}
  }

  forms_kept: rule(system.formatter) {
    mustNot {{ turn a Markdown form into an element, or an element into a Markdown form }}
    then {{ the tree records which form each node was written in, and `heron fmt` writes it back so }}
  }

  prose_kinds_render_alike: rule(system.docs_generator) {
    must {{ render an element of a kind a Markdown form builds as that form renders: `<p>`, `<em>`, `<strong>`, `<strike>`, `<code>`, `<quote>`, `<list>` with `<item>`s, `<table>` with `<row>`s and `<cell>`s, `<link>`, `<ref>` and `<divider>` }}
    example {{ `<em>now</em>` and `*now*` render the same, and so do ``<code>x</code>`` and `` `x` `` }}
  }

  tag_names_a_kind: rule(system.linter) {
    must {{ report tag not a kind where a tag's name resolves to something that isn't a kind, and structure-only tag where its kind is declared `modes = [structure]` }}
  }

  attributes_are_arguments: rule(system.checker) {
    must {{ match each attribute to the parameter of the tag's kind with its name, and report unknown attribute with the closest parameter where none has it }}
  }

  attribute_values: rule(system.checker) {
    must {{ read a quoted attribute as a literal of its parameter's type, a string, a number, a boolean, an enum member or a reference resolved as a [link path](#language.core_format.naming.link_path), and an attribute in braces as an expression of Heron's expression language, list literals included, checked against its parameter's type as an argument }}
    example {{ `<toc depth="2" />` and `<toc depth={2} />` both set `depth` to 2, `<rule refs="desk">` references `desk`, and `<toc depth={true} />` reports [wrong type](#language.core_format.values.errors.wrong_type) }}
  }

  variadic_attributes: rule(system.checker) {
    where {{ an attribute names a variadic parameter }}
    must {{ give its value as that parameter's arguments, in order and before the named ones: a quoted value as one, a braced list as one per item }}
    example {{ `<increment id="first" delivers="refund_story">` is `first: increment(refund_story)`, and `delivers={[refund_story, refund_window]}` gives two }}
  }

  required_attributes: rule(system.checker) {
    if {{ a tag leaves out an attribute whose parameter has no default and isn't optional }}
    must {{ report missing attribute }}
  }

  tag_closing: rule(system.parser) {
    must {{ close a tag at `</name>` with its own name, and report tag mismatch or tag unclosed otherwise }}
  }

  slots: rule(system.checker) {
    must {{ admit tags nested in a tag's content by its kind's `accept` entries, and report tag not accepted for one it doesn't take }}
    example {{ `<details><title>…</title>…</details>`, where `details` accepts one `title` }}
  }

  tags_render: rule(system.docs_generator) {
    must {{ render a tag through the renderer registered for its kind, with its content rendered as prose and its attributes as text, and as a span classed by the kind's name where none is registered }}
  }

  errors: section {
    missing_attribute: error("missing-argument") {
      title = "<{kind}> needs the attribute {name}"
      kind: field(String)
      name: field(String)
      | Reported as [language.markup.tags.required_attributes] says.
    }

    tag_not_accepted: error("accept") {
      title = "<{kind}> doesn't accept <{child}>; it accepts {kinds}"
      kind: field(String)
      child: field(String)
      kinds: field(String)
      | Reported as [language.markup.tags.slots] says.
    }

    @display("Element needs an id")
    element_needs_id: error("unnamed") {
      title = "<{kind}> declares a node and needs an id"
      kind: field(String)
      | A section, a step, a concept or another kind with a heading, or a term, written as an element without `id`.
      | Reported as [language.markup.tags.element_needs_id] says.
    }

    @display("Code in an element")
    code_in_element: error("element-code") {
      title = "<{kind}>'s body is code; write it in a .heron file"
      kind: field(String)
      | A kind whose body is a `do` block, written as an element; code has no element form.
      | Reported as [language.markup.tags.code_stays_in_heron] says.
    }

    @display("Unquoted attribute")
    unquoted_attribute: error("syntax") {
      title = "the value of {name} needs quotes or braces"
      name: field(String)
      | An attribute written `name=value`; write `name="value"`, or `name={expr}` for an expression.
      | Reported as [language.markup.tags.quoted_attributes] says.
    }
  }
}
