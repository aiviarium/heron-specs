@display("Authored pages")
authored_pages: section {
  | Most pages of a site are derived from the tree's structure. An [authored page](#language.markup.authored_pages.authored_page) is written
  | for a reader instead: a guide, a how-to, a concept or a tutorial, as `std/docs` declares
  | them. It stays true to the spec it explains because its examples are checked, its facts
  | are inserted from the nodes that state them, and its links resolve. [A how-to](#language.markup.authored_pages.howto_example)
  | shows the forms.

  authored_page: term {{
    A node of a kind in `std/docs`'s category `authored`: `guide`, `howto`, `concept` or
    `tutorial`. It holds prose, the blocks of `std/doc`, examples and, for a how-to or a
    tutorial, steps.
  }}

  guide_kind: term {{
    `name: guide { … }`, a page that explains how to get something done with the system,
    start to finish, in prose.
  }}

  howto_kind: term {{
    `name: howto { … }`, a page for one task: its prose says what the task achieves, and
    its `step` nodes say how, in the order they're done.
  }}

  step_kind: term {{
    `name: step { … }`, one step of a how-to or a tutorial: its [display name](#language.core_format.naming.display_name) says what to
    do, and its prose and examples how.
  }}

  concept_kind: term {{
    `name: concept { … }`, a page that explains an idea a reader needs before the
    reference makes sense.
  }}

  tutorial_kind: term {{
    `name: tutorial { … }`, a page that teaches by building one thing in steps, each
    building on the one before.
  }}

  pages: section {
    authored_are_pages: rule(system.docs_generator) {
      must {{ give every [authored page](#language.markup.authored_pages.authored_page) a page of its own, at any depth, titled by its [display name](#language.core_format.naming.display_name) }}
    }

    steps_numbered: rule(system.docs_generator) {
      must {{ number the steps of a how-to or a tutorial from 1 in the order written, and render each as its number and [display name](#language.core_format.naming.display_name) as a heading one level below the page's, with its prose and examples under it }}
    }

    step_anchors: rule(system.docs_generator) {
      must {{ give each step an anchor at its path }}
      then {{ a link can name the step a reader is at, as `#getting_started.check` }}
    }

    steps_only_in_tasks: rule(system.checker) {
      if {{ a `step` of `std/docs` stands anywhere but in a how-to or a tutorial }}
      must {{ report that the parent doesn't accept it, as for any kind its parent doesn't accept }}
    }

    unmarked_in_every_lens: rule(system.docs_generator) {
      where {{ an [authored page](#language.markup.authored_pages.authored_page) carries no [lens mark](#tools.docs.lenses.lens_mark) }}
      must {{ render it in every lens whose lists keep it }}
    }
  }

  checked_examples: section {
    | An example on an [authored page](#language.markup.authored_pages.authored_page) is a promise to its reader that the code works, so it
    | is checked as the tree it is. Code a reader shouldn't take as complete, such as one
    | line of a larger file, goes in a code block outside an example, which is shown and
    | not checked.

    examples_checked: rule(system.checker) {
      must {{ check each code block marked `heron` of an `example` that stands in an [authored page](#language.markup.authored_pages.authored_page) as the [entry point](#language.core_format.files.entry_point) of a tree of its own, in a folder with no other file, where only the standard packages resolve }}
    }

    example_errors: rule(system.checker) {
      if {{ a checked example's tree has an error }}
      must {{ report example doesn't check at the code block, with the first error's message and its line in the block }}
      then {{ `heron check` fails until the example is fixed, so a page can't show code that no longer works }}
    }

    other_blocks_shown: rule(system.checker) {
      mustNot {{ check a code block outside an `example`, or one marked with a language other than `heron` }}
    }
  }

  facts: section {
    | A page inserts a fact, such as a command's name or an option's default, from the node
    | that states it, rather than copying it: `${cli.serve.addr.default}` shows the
    | default as the spec has it, and stops the check when the spec no longer has it.

    insert_arguments: rule(system.checker) {
      must {{ resolve an [insertion](#language.markup.inserts.insertion) whose last name is a parameter of the kind of the node before it, as `${cli.serve.addr.default}`, to the argument the node passes for it, or to the parameter's default when it passes none }}
    }

    inserted_facts_required: rule(system.checker) {
      if {{ an [insertion](#language.markup.inserts.insertion) on an [authored page](#language.markup.authored_pages.authored_page) names a node, a field or an argument that isn't there, as after the node is renamed or removed }}
      must {{ report unknown name at the [insertion](#language.markup.inserts.insertion), as an error }}
      then {{ a page can't go on stating a fact the spec has dropped }}
    }

    inserted_strings: rule(system.docs_generator) {
      where {{ an [insertion](#language.markup.inserts.insertion) resolves to a string }}
      must {{ render the string's text without its quotes, as inline code }}
      example {{ `${cli.check.name}` renders `heron check` }}
    }
  }

  links: section {
    links_checked: rule(system.checker) {
      must {{ resolve every `#path` link of an [authored page](#language.markup.authored_pages.authored_page) in the tree, and report one that resolves nowhere as broken link, as an error }}
    }

    file_links_checked: rule(system.linter) {
      if {{ a link of an [authored page](#language.markup.authored_pages.authored_page) is a relative path to a file that doesn't exist }}
      should {{ report dead link at the link }}
    }
  }

  errors: section {
    @display("Example doesn't check")
    example_fails: error("example") {
      title = "the example {path} doesn't check: {message} (line {line})"
      path: field(String)
      message: field(String)
      line: field(String)
      | Fix the code in the example, or move code that isn't a whole file out of the example into a code block of the page.
      | Reported as [language.markup.authored_pages.checked_examples.example_errors] says.
    }
  }

  @display("A how-to")
  howto_example: example {
    | ```heron
    | import = ["std/doc@1", "std/docs@1"]
    |
    | cli: section {
    |   check: command("acme check") {
    |     verbose: option("--verbose", type = Bool, default = false)
    |   }
    | }
    |
    | @lens(user)
    | check_a_file: howto {
    |   | Check a file before you send it, so a mistake is caught on your machine.
    |
    |   run: step {
    |     | Run ${cli.check.name} in the folder that holds the file.
    |   }
    |
    |   read: step {
    |     | Read each line it prints. `--verbose`, ${cli.check.verbose.default} unless you pass it, lists every file it read.
    |   }
    | }
    | ```
  }
}
