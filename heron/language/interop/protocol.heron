@display("The protocol")
protocol: section {
  | heron speaks one protocol to the [JS host](#language.interop.host.js_host) and to every
  | [extension process](#language.schemas.extensions.extension_process): JSON-RPC's
  | requests, responses and notifications, sent as length-prefixed CBOR frames over the
  | process's standard input and output. Either side may send requests, so foreign code
  | calls back into Heron on the same connection. The messages are declared once, in
  | Heron, and [included below](#language.interop.protocol.messages) as they stand; both
  | sides' bindings are generated from them. A frame is a [Message](#language.interop.protocol.messages.Message); the methods each side
  | serves are the interfaces [Extension](#language.interop.protocol.messages.Extension), [Host](#language.interop.protocol.messages.Host) and
  | [Notifications](#language.interop.protocol.messages.Notifications), and each other type is the `params` or `result`
  | of one of them.

  cbor_rpc: term(aliases = ["CBOR-RPC"]) {{
    The protocol: a message is a map with `id`, `method`, `params`, `result`, `error` and
    `run`, without JSON-RPC's `jsonrpc` member. A request has an `id` and a `method`, a
    response the request's `id` and a `result` or an `error`, and a notification a `method`
    and no `id`.
  }}

  framing: section {
    frames: rule(cbor_rpc, by = system.extension_host) {
      must {{ send each message as one frame: its length as a 4-byte big-endian integer, then exactly that number of bytes of payload }}
    }

    frame_limit: rule(cbor_rpc, by = system.extension_host) {
      if {{ a frame is longer than the connection's `max_frame` }}
      must {{ refuse it without reading its payload: a request that would send one fails with the limit-exceeded code, a response is replaced by a limit-exceeded error, and a frame that arrives ends the connection }}
    }

    unreadable_message: rule(cbor_rpc, by = system.extension_host) {
      if {{ a frame's payload isn't a message }}
      must {{ answer it with a parse error, code `-32700`, and go on reading }}
    }

    @display("JSON wire")
    json_wire: rule(cbor_rpc, by = system.extension_host) {
      where {{ the [JS host](#language.interop.host.js_host) is started with `--wire json` }}
      must {{ encode the same messages as JSON in the same frames, so traffic can be read while debugging }}
    }

    @display("JSON wire option")
    json_wire_option: rule(cbor_rpc, by = system.command_line) {
      where {{ heron is run with `--wire json` }}
      must {{ speak the JSON wire to every process it starts, passing `--wire json` to the [JS host](#language.interop.host.js_host) }}
    }

    ids_per_side: rule(cbor_rpc, by = system.extension_host) {
      must {{ number each side's requests from 1 up, apart from the other side's }}
    }
  }

  handshake: section {
    initialize_first: rule(cbor_rpc, by = system.extension_host) {
      when {{ a process starts }}
      must {{ send `initialize` with the protocol version, heron's name and version, the project's root, the declarations the process serves, the limits, heron's capabilities and the folder for run-scoped files, and wait up to 30 seconds for the answer }}
    }

    version_match: rule(cbor_rpc, by = system.extension_host) {
      if {{ the protocol version the process answers with has another major number than heron's }}
      must {{ stop the process and fail with `‹process›: speaks protocol ‹version›, and heron speaks ‹version›` }}
      then {{ a minor version apart is accepted }}
    }

    implements_answered: rule(cbor_rpc, by = system.extension_host) {
      must {{ read the answer's `implements` as what the process serves, by path and point, and report every declaration it leaves out as doesn't implement }}
    }
  }

  limits: section {
    | | Limit           | Default    | Meaning                                       |
    | | --------------- | ---------- | --------------------------------------------- |
    | | `max_frame`     | 16 MiB     | the longest frame either side sends or reads  |
    | | `max_in_flight` | 64         | the requests a side serves at once            |
    | | `timeout_ms`    | 30 000     | how long a request waits for its response     |

    offered_limits: rule(cbor_rpc, by = system.extension_host) {
      must {{ offer the limits of the table in `initialize`, with an extension's `files`, `network` and `commands` beside them, and apply them on both sides }}
    }

    in_flight_limit: rule(cbor_rpc, by = system.extension_host) {
      if {{ a request arrives while `max_in_flight` requests are being served }}
      must {{ answer it at once with the limit-exceeded code }}
      then {{ a request stops counting once its response is ready, so the caller's next request is never refused for it }}
    }

    timeouts: rule(cbor_rpc, by = system.extension_host) {
      where {{ a request is sent without a deadline of its own }}
      must {{ give it `timeout_ms`, and when that passes, send `$/cancel` and fail it with the timeout code }}
    }
  }

  methods: section {
    | | From          | Methods                                                                                         |
    | | ------------- | ----------------------------------------------------------------------------------------------- |
    | | heron         | `initialize`, `call`, `lint`, `generate`, `render`, `resource/setup`, `resource/reset`, `resource/snapshot`, `resource/restore`, `resource/fork`, `resource/teardown`, `shutdown` |
    | | the process   | `node`, `call`, `resource`, `secret`, `temp`                                                    |
    | | either        | the notifications `$/cancel`, `$/stream`, `$/log` and `$/progress`                              |

    calls_by_target: rule(cbor_rpc, by = system.extension_host) {
      must {{ send a call of a [foreign func](#language.interop.declaring.foreign_func), macro or member of an implemented interface as `call` with the declaration's path as `target`, the member, as `send` of a transport, and the arguments by parameter name }}
    }

    unknown_method: rule(cbor_rpc, by = system.extension_host) {
      if {{ a request names a method the side doesn't serve }}
      must {{ answer it with the method-not-found code, `-32601` }}
    }

    cancel: rule(cbor_rpc, by = system.extension_host) {
      when {{ the caller cancels a request }}
      must {{ send `$/cancel` with its id, fail it on the caller's side with the cancelled code, and abort its handler on the other side, which answers with the cancelled code if it finishes anyway }}
    }

    stream: rule(cbor_rpc, by = system.extension_host) {
      where {{ a handler streams its result }}
      must {{ send each item as `$/stream` with the request's id before the response that ends the request }}
    }

    log_and_progress: rule(cbor_rpc, by = system.extension_host) {
      must {{ accept `$/log` with a level and a message, and `$/progress` with the request's id, a message and counts done and total, at any time }}
    }

    run_ids: rule(cbor_rpc, by = system.extension_host) {
      must {{ carry the [run](#language.interop.timing.run_scope)'s id as `run` on each request of a run, and hand it to the handler }}
    }

    closed_connection: rule(cbor_rpc, by = system.extension_host) {
      when {{ the connection ends }}
      must {{ fail every request in flight on both sides and cancel the handlers still running }}
    }
  }

  errors: section {
    | | Code      | Meaning                                                          |
    | | --------- | ---------------------------------------------------------------- |
    | | `-32700`  | a frame that isn't a message                                     |
    | | `-32600`  | a message that isn't a valid request                             |
    | | `-32601`  | a method the side doesn't serve                                  |
    | | `-32602`  | parameters the method can't take                                |
    | | `-32603`  | the handler failed                                               |
    | | `-32800`  | the request was cancelled, as in LSP                             |
    | | `-32000`  | foreign code broke: `ForeignError`                               |
    | | `-32001`  | a declared error was thrown, its type in `type`, its fields in `data` |
    | | `-32002`  | a limit was exceeded                                             |
    | | `-32003`  | the request timed out                                            |

    handler_failures: rule(cbor_rpc, by = system.extension_host) {
      if {{ a handler fails with anything but a protocol error }}
      must {{ answer with `-32603` and the failure's message }}
    }
  }

  generated_sides: rule(cbor_rpc, by = system.extension_host) {
    must {{ generate the host's and the JS runtime's bindings from the messages, with `@method` giving a wire name such as `resource/setup` and `<notification>` a method without a response, and fail CI when either is stale }}
  }

}

protocol.messages.{
  include = ["./protocol_messages.heron"]
}
