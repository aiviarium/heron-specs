@display("The protocol")
protocol: section {
  | heron speaks one protocol to the [JS host](#language.interop.host.js_host) and to every
  | [extension process](#language.schemas.extensions.extension_process): a
  | [Sparrow RPC](https://github.com/aiviarium/sparrow) session on Sparrow's pipe binding,
  | over the process's standard input and output. Each side publishes one facet and calls the
  | other's, so foreign code calls back into Heron on the same session. The messages are
  | declared once, in Heron, and [included below](#language.interop.protocol.messages) as
  | they stand; both sides' bindings and both facets are generated from them. The facets are
  | the apis [extension](#language.interop.protocol.messages.extension) and
  | [host](#language.interop.protocol.messages.host), each op one of the facet's methods, and
  | each other type is a facet type reached by the `params` or result of one of them.

  sparrow_session: term(aliases = ["extension session"]) {{
    The protocol: a Sparrow session on the pipe binding, its `Hello` from the
    [extension process](#language.schemas.extensions.extension_process), which publishes
    the facet `heron.extension` beside it, and its `Welcome` from heron, which publishes
    the facet `heron.host`. Calls, streams, cancellation, progress, time limits and
    errors are Sparrow's own messages.
  }}

  framing: section {
    frames: rule(sparrow_session, by = system.extension_host) {
      must {{ run the session on Sparrow's pipe binding: each message one CBOR item behind its length as a QUIC variable-length integer, with no stream header, and every call on the shared lane }}
    }

    facets: rule(sparrow_session, by = system.extension_host) {
      must {{ publish each side's facet with facet ID 16 under its name, `heron.extension` in the process's `Hello` and `heron.host` in heron's `Welcome`, with the protocol's major version as the facet's, every type, field and method numbered in the order the messages declare them, and the [Value](#language.interop.data_mapping.value_union) union for every `Any` }}
      then {{ a peer looks methods up by name in the other's facet, so either side can add methods in a minor version }}
    }

    frame_limit: rule(sparrow_session, by = system.extension_host) {
      if {{ a message is longer than the session's `max_message` }}
      must {{ refuse it as Sparrow's `maxMessageSize` says: a call that would send one fails with the limit-exceeded code, and a message that arrives ends the session with `GoAway(message_too_large)` }}
    }

    unreadable_message: rule(sparrow_session, by = system.extension_host) {
      if {{ a message isn't a Sparrow message, or its payload doesn't match its method's types }}
      must {{ end a call it belongs to with the invalid-params code, and otherwise close the session with `GoAway(protocol_error)` }}
    }

    ids_per_side: rule(sparrow_session, by = system.extension_host) {
      must {{ number calls as Sparrow does: the process's even, heron's odd, each side's strictly increasing }}
    }
  }

  handshake: section {
    initialize_first: rule(sparrow_session, by = system.extension_host) {
      when {{ a process starts }}
      must {{ answer its `Hello` with a `Welcome` within 30 seconds, then call `initialize` with the protocol version, heron's name and version, the project's root, the declarations the process serves, the limits and the folder for run-scoped files, and wait up to 30 seconds for the answer }}
      then {{ a process whose `Hello` doesn't publish `heron.extension` is refused with `GoAway(schema_mismatch)` }}
    }

    version_match: rule(sparrow_session, by = system.extension_host) {
      if {{ the protocol version the process answers with has another major number than heron's }}
      must {{ stop the process and fail with `‹process›: speaks protocol ‹version›, and heron speaks ‹version›` }}
      then {{ a minor version apart is accepted }}
    }

    implements_answered: rule(sparrow_session, by = system.extension_host) {
      must {{ read the answer's `implements` as what the process serves, by path and point, and report every declaration it leaves out as doesn't implement }}
    }
  }

  limits: section {
    | | Limit           | Default    | Sparrow                | Meaning                                       |
    | | --------------- | ---------- | ---------------------- | --------------------------------------------- |
    | | `max_message`   | 16 MiB     | `maxMessageSize`       | the longest message either side sends or reads |
    | | `max_in_flight` | 64         | `maxConcurrentCalls`   | the calls a side serves at once               |
    | | `timeout_ms`    | 30 000     | the `deadline` key     | how long a call waits for its answer          |

    offered_limits: rule(sparrow_session, by = system.extension_host) {
      must {{ offer the limits of the [table](#heron.language.markup.components.table) in `initialize`, with an extension's `files`, `network` and `commands` beside them, and apply them on both sides as the session's params }}
    }

    in_flight_limit: rule(sparrow_session, by = system.extension_host) {
      if {{ a call arrives while `max_in_flight` calls are being served }}
      must {{ answer it at once with `Error(resource_exhausted)` and the limit-exceeded code }}
      then {{ a call stops counting once its answer is sent, so the caller's next call is never refused for it }}
    }

    timeouts: rule(sparrow_session, by = system.extension_host) {
      where {{ a call is made without a time limit of its own }}
      must {{ give it `timeout_ms` as its `deadline`, and when that passes, send `Cancel(deadline_exceeded)` and fail it with the timeout code }}
    }
  }

  methods: section {
    | | Facet             | Methods                                                                                         |
    | | ----------------- | ----------------------------------------------------------------------------------------------- |
    | | `heron.extension` | `initialize`, `call`, `call_stream`, `lint`, `generate`, `render`, `resource_setup`, `resource_reset`, `resource_snapshot`, `resource_restore`, `resource_fork`, `resource_teardown`, `shutdown` |
    | | `heron.host`      | `node`, `call`, `resource`, `secret`, `temp`, and the notification `log`                        |

    calls_by_target: rule(sparrow_session, by = system.extension_host) {
      must {{ send a call of a [foreign func](#language.interop.declaring.foreign_func), macro or member of an implemented interface as `call` with the declaration's path as `target`, the member, as `send` of a transport, and the arguments by parameter name }}
    }

    unknown_method: rule(sparrow_session, by = system.extension_host) {
      if {{ a call names a method the side doesn't serve }}
      must {{ answer it with `Error(unimplemented)` and the method-not-found code, `-32601` }}
    }

    cancel: rule(sparrow_session, by = system.extension_host) {
      when {{ the caller cancels a call }}
      must {{ send Sparrow's `Cancel`, fail it on the caller's side with the cancelled code, and abort its handler on the other side, which answers with `Error(cancelled)` if it finishes anyway }}
    }

    stream: rule(sparrow_session, by = system.extension_host) {
      where {{ a handler streams its result }}
      must {{ serve it through `call_stream`, each item a Sparrow `Item` and the stream ended with `End`, and answer a plain `call` of it with its items as a list }}
    }

    log_and_progress: rule(sparrow_session, by = system.extension_host) {
      must {{ accept the notification `log` with a level and a message, and Sparrow's `Progress` on a call with counts done and total and a note, at any time }}
    }

    run_ids: rule(sparrow_session, by = system.extension_host) {
      must {{ carry the [run](#language.interop.timing.run_scope)'s id under the metadata key `heron.run` on each call of a run, and hand it to the handler }}
    }

    closed_connection: rule(sparrow_session, by = system.extension_host) {
      when {{ the session ends }}
      must {{ fail every call in flight on both sides and cancel the handlers still running }}
    }
  }

  errors: section {
    | | Code      | Sparrow status        | Meaning                                                          |
    | | --------- | --------------------- | ---------------------------------------------------------------- |
    | | `-32700`  | `protocol_error`      | a message that isn't a message                                   |
    | | `-32600`  | `invalid_argument`    | a call that isn't valid                                          |
    | | `-32601`  | `unimplemented`       | a method the side doesn't serve                                  |
    | | `-32602`  | `invalid_argument`    | parameters the method can't take                                |
    | | `-32603`  | `internal`            | the handler failed                                               |
    | | `-32800`  | `cancelled`           | the call was cancelled                                           |
    | | `-32000`  | `unknown`             | foreign code broke: `ForeignError`                               |
    | | `-32001`  | `aborted`             | a declared error was thrown, its type in `type`, its fields in `data` |
    | | `-32002`  | `resource_exhausted`  | a limit was exceeded                                             |
    | | `-32003`  | `deadline_exceeded`   | the call timed out                                               |

    handler_failures: rule(sparrow_session, by = system.extension_host) {
      must {{ end a failed call with Sparrow's `Error`: the status the [table](#heron.language.markup.components.table) gives its code, its message, and `ErrorDetails` with the code as details, `-32603` for a handler that fails with anything but a protocol error }}
      then {{ a status without details, as from a peer that isn't heron's, reads as the code the [table](#heron.language.markup.components.table) gives the status first }}
    }
  }

  generated_sides: rule(sparrow_session, by = system.extension_host) {
    must {{ generate the host's and the JS runtime's bindings and both facets from the messages, each api's ops as its methods, named as written, an op without a result as a [Sparrow notification](#language.apis.sparrow.sparrow_notification) and an op whose result is a `Stream` as a server stream, and fail CI when either is stale }}
  }

}

protocol.messages.{
  include = ["./protocol_messages.heron"]
}

// The messages' scope, as the docs' navigation names its types.
@display("Extension protocol messages")
protocol.messages {}
