// The extension protocol's messages: the methods of two Sparrow facets,
// heron.extension and heron.host, called over a Sparrow session on the pipe
// binding (the process's standard input and output). This file is the one
// description of them; every side's bindings and both facets are generated
// from it, so another runtime's SDK can be generated the same way. Each
// api is one facet; its ops are the facet's methods, in the order written,
// and each type is a facet type, its members the fields in the order
// written.
import = ["std/types@1"]

/// The protocol version both sides send in initialize.
version: String = "2.0"

/// The details of a Sparrow `Error` that ends a call: the protocol's code,
/// and for a value the declaration throws, its Heron type in `type` and the
/// value in `data`. The Sparrow status beside it follows from the code.
ErrorDetails: type {
  code: Int
  type?: String
  data?: Any
}

/// The protocol's error codes, kept from JSON-RPC's, each answered with
/// the Sparrow status the protocol's errors give it.
code_parse_error: Int = -32700
code_invalid_request: Int = -32600
code_method_not_found: Int = -32601
code_invalid_params: Int = -32602
code_internal_error: Int = -32603
/// The call was cancelled with a Sparrow `Cancel`.
code_cancelled: Int = -32800
/// The foreign code failed with something its declaration doesn't throw.
code_foreign_error: Int = -32000
/// The foreign code threw a value of a type its declaration throws.
code_thrown: Int = -32001
/// A declared limit was exceeded, such as the message size.
code_limit_exceeded: Int = -32002
code_timeout: Int = -32003

/// A program and its version.
PeerInfo: type {
  name: String
  version: String
}

/// The kinds of part a declaration can be.
Point: enum {
  func: Self
  macro: Self
  transport: Self
  lint: Self
  resource: Self
  generator: Self
  /// A module of docs renderers, named in a docs block's `renderers`.
  renderer: Self
}

/// A type as written in a Heron signature, such as List(String)?.
TypeRef: type {
  name: String
  args?: List(TypeRef)
  optional?: Bool
}

/// A parameter of a declaration.
ParamSig: type {
  name: String
  type: TypeRef
  optional?: Bool
  variadic?: Bool
}

/// A declaration that names an extension: an `@extern(…)` declaration, or a
/// binding to a module's export.
Declaration: type {
  /// The path of the declaration, such as `inventory.slugify`.
  path: String
  point: Point
  /// The module export that implements it, such as `slugify` or `default`.
  export?: String
  /// The module, for a binding through js(…).
  module?: String
  params?: List(ParamSig)
  returns?: TypeRef
  throws?: List(String)
  pure?: Bool
  /// For a generator, the generation target it serves.
  target?: String
}

/// What an extension implements of what it was sent.
Implemented: type {
  path: String
  point: Point
  /// For a renderer module, the kinds it renders, by declaration path.
  kinds?: List(String)
}

/// The limits a host applies. The message size and concurrency limits bind
/// both sides, as the session's `maxMessageSize` and `maxConcurrentCalls`;
/// files, network and commands are what the extension declared it needs.
Limits: type {
  max_message: Int
  max_in_flight: Int
  timeout_ms: Int
  files?: List(String)
  network?: List(String)
  commands?: List(String)
}

InitializeParams: type {
  protocol: String
  host: PeerInfo
  root: String
  declarations: List(Declaration)
  limits: Limits
  /// The directory run-scoped files go under, as `<temp>/<run>/<name>`.
  temp?: String
}

InitializeResult: type {
  protocol: String
  extension: PeerInfo
  implements: List(Implemented)
}

/// A call of a func or macro bound to foreign code, or of a member of an implemented
/// interface, such as a transport's send.
CallParams: type {
  target: String
  member?: String
  args: Map(String, Any)
}

/// A node of the resolved tree, as `heron check --json` prints it.
Node: type {
  path: String
  name?: String
  kind?: String
  type?: String
  value?: Any
  file?: String
  start?: Int
  end?: Int
  line?: Int
  flags?: List(String)
  prose?: List(String)
  children?: List(Node)
}

Severity: enum {
  error: Self
  warning: Self
  info: Self
}

/// A replacement of a byte range of a file.
TextEdit: type {
  /// The file, or the finding's file when left out.
  file?: String
  start: Int
  end: Int
  new: String
}

/// A change that resolves a finding: edits applied together, as
/// `heron lint --fix` applies the first fix of each finding.
Fix: type {
  title: String
  edits: List(TextEdit)
}

/// A lint finding, on a node by path, and at a byte range where it has one.
Finding: type {
  node: String
  message: String
  severity?: Severity
  file?: String
  start?: Int
  end?: Int
  fixes?: List(Fix)
}

LintParams: type {
  lint: String
  nodes: List(Node)
}

LintResult: type {
  findings: List(Finding)
}

GenerateParams: type {
  generator: String
  target: String
  tree: Node
}

GeneratedFile: type {
  path: String
  content: String
  /// A build output, which the managed ignore block lists.
  ignored?: Bool
}

GenerateResult: type {
  files: List(GeneratedFile)
}

/// A request in a resource's life: the resource, and the instance or
/// snapshot handle where there is one.
ResourceParams: type {
  resource: String
  handle?: Any
  snapshot?: Any
}

ResourceResult: type {
  handle?: Any
  snapshot?: Any
}

/// A node or markup tag for a docs renderer, as plain data: the generator
/// has rendered its prose and children already, so the renderer arranges
/// them and adds only markup.
RenderParams: type {
  /// The renderer module's declaration path.
  renderer: String
  /// The kind's declaration path, such as spec.rule.
  kind: String
  /// The node's path; left out for a markup tag.
  path?: String
  name?: String
  /// The node's title as the docs show it.
  title?: String
  /// The heading level the title takes, from 2.
  level?: Int
  /// The anchor the node's wrapper carries.
  anchor?: String
  /// The node's own prose, rendered.
  prose?: String
  /// The node's children, each rendered through its kind's renderer.
  children?: String
  /// The arguments of the node's kind, or a markup tag's attributes,
  /// typed by the kind's parameters.
  attrs?: Map(String, Any)
  /// A markup tag's rendered content.
  body?: String
  /// The components of the kind's slots other than before and after, by
  /// name, for the renderer to place.
  slots?: Map(String, String)
}

RenderResult: type {
  html: String
  /// For a markup tag, whether it renders as a block.
  block?: Bool
  /// The islands the HTML uses.
  islands?: List(String)
}

LogParams: type {
  level: Severity
  message: String
}

NodeParams: type {
  path: String
  depth?: Int
}

NameParams: type {
  name: String
}

Empty: type

/// What heron calls an extension on: the facet `heron.extension`, which the
/// extension publishes in its `Hello`.
@display("Extension protocol: extension")
extension: api {
  initialize(params: InitializeParams): op(InitializeResult, language.interop.protocol.handshake.initialize_first)
  call(params: CallParams): op(Any, language.interop.protocol.methods.calls_by_target)
  /// A call whose result streams: each item as a Sparrow `Item`.
  call_stream(params: CallParams): op(Stream(Any), language.interop.protocol.methods.stream)
  lint(params: LintParams): op(LintResult, language.interop.declaring.registered_by_path)
  generate(params: GenerateParams): op(GenerateResult, language.interop.declaring.registered_by_path)
  render(params: RenderParams): op(RenderResult, language.interop.declaring.registered_by_path)
  resource_setup(params: ResourceParams): op(ResourceResult, language.interop.timing.instance_per_run)
  resource_reset(params: ResourceParams): op(ResourceResult, language.interop.timing.instance_per_run)
  resource_snapshot(params: ResourceParams): op(ResourceResult, language.interop.timing.instance_per_run)
  resource_restore(params: ResourceParams): op(ResourceResult, language.interop.timing.instance_per_run)
  resource_fork(params: ResourceParams): op(ResourceResult, language.interop.timing.instance_per_run)
  resource_teardown(params: ResourceParams): op(ResourceResult, language.interop.timing.teardown_at_end)
  shutdown(params: Empty): op(Empty, language.interop.host.supervising.shutdown)
}

/// What an extension calls heron on, the way back into Heron, `ctx`: the
/// facet `heron.host`, which heron publishes in its `Welcome`.
@display("Extension protocol: heron")
host: api {
  /// The node at a path, or null when nothing is there.
  node(params: NodeParams): op(Node, language.interop.host.services.ctx_node)
  call(params: CallParams): op(Any, language.interop.host.services.ctx_call_in_run)
  resource(params: NameParams): op(Any, language.interop.timing.run_id_travels)
  secret(params: NameParams): op(String, language.interop.host.services.ctx_secret)
  temp(params: NameParams): op(String, language.interop.host.services.ctx_temp)
  /// A line for heron's log, sent without an answer.
  log(params: LogParams): op(language.interop.protocol.methods.log_and_progress)
}
