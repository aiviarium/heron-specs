// How this spec is laid out and how a change to it is written: the
// conventions the rest of the package follows.

guide: section {
  | This package is the specification of Heron, written in Heron. It's the source of truth:
  | an implementation that disagrees with it is a bug in one of the two. It's written so that
  | an implementer can build or change any part of the system from the part's subtree alone,
  | and it says what the system does, never how it's built.

  layout: section {
    | The tree is split by [spec domain](#guide.layout.spec_domain), then by concern. Each [spec domain](#guide.layout.spec_domain) is a folder at the top, each
    | folder holds an index file and one file per concern, and a concern with parts of its own
    | is a folder again.
    |
    | | Folder       | Holds                                                                                      |
    | | ------------ | ------------------------------------------------------------------------------------------ |
    | | `product/`   | The vision, the actors and personas, the shared glossary, and the backlog of epics         |
    | | `language/`  | The core format, the grammar, [schemas](#language.schemas.kinds.schema), markup, data, APIs, specifications, scripting, interop and the standard packages |
    | | `cli/`       | One command reference per subcommand of the `heron` command                                |
    | | `tools/`     | What the language server, prose linting, the docs, the server and the frontend do          |

    spec_domain: term(aliases = ["spec domain"]) {{
      A top-level folder of the spec: one area of the system with its own readers, such as the
      language or the command line.
    }}

    folder_scope: term(aliases = ["folder scope"]) {{
      The scope a folder becomes when it's included as `./name/`: its nodes' paths start with
      the folder's name, so `language/grammar/lexical.heron` declares nodes under
      `language.grammar`.
    }}

    concern_file: term(aliases = ["concern file"]) {{
      A file that holds one concern of its folder, as one section or one command.
    }}

    folder_index: rule(guide.layout, by = product.actors.author) {
      must {{ give every folder an `index.heron` that opens with one prose line saying what its scope specifies, and includes the folder's files and folders in reading order }}
    }

    one_concern_per_file: rule(guide.layout, by = product.actors.author) {
      must {{ keep one concern in a file, and split a file into a folder once it holds parts a reader would load apart }}
    }

    folders_included_as_folders: rule(guide.layout, by = product.actors.author) {
      must {{ include every folder as `./name/`, so its name is its [folder scope](#guide.layout.folder_scope) and its index is mounted under it }}
      then {{ a node's path says where its file is, as `language.grammar.lexical` }}
    }

    acronym_display_names: rule(guide.layout.folder_scope, by = product.actors.author) {
      where {{ a folder's name is an acronym, as `cli/` }}
      must {{ give its scope a [display name](#language.core_format.naming.display_name) with `@display` in the index that includes the folder, right after the include list, as `@display("CLI") cli {}` }}
    }

    page_depth: rule(guide.layout, by = product.actors.author) {
      must {{ set `docs { depth = 3 }` in the spec's [entry point](#language.core_format.files.entry_point), so the third level of sections gets pages of its own }}
    }

    folder_names: rule(guide.layout, by = product.actors.author) {
      must {{ name a folder with lower-case words joined by underscores }}
      then {{ the folder's name is a valid scope name, the start of every path below it }}
    }

    one_command_per_file: rule(guide.layout, by = product.actors.author) {
      must {{ specify each subcommand of the binary as one `command` in a file of its own under `cli/` }}
    }
  }

  kinds: section {
    | Everything is written in the kind that says it, so the checker, the lints and the
    | renderer can read it. Prose carries context and reasons, never a behaviour on its own.
    |
    | | To state                          | Write                                                               |
    | | --------------------------------- | ------------------------------------------------------------------- |
    | | A behaviour                       | a `rule` with one strength, its conditions and `by` for its subject |
    | | A bound on something measured     | a `metric` and a `quality`                                          |
    | | A [lifecycle](#language.specifications.lifecycles.lifecycle)                       | `states` and `transition`                                           |
    | | A word                            | a `term`, once, where its domain is                                 |
    | | A need                            | a `story` with `criterion` nodes in a product epic                  |
    | | An interaction                    | a `usecase` with numbered steps and its branches                    |
    | | A subcommand                      | a `command` with its usage, arguments, options and exit codes       |
    | | Syntax                            | a `grammar` of `production` and `token` nodes                       |
    | | A message a tool reports          | a `diagnostic` with its code, severity, message and `by`            |
    | | A screen                          | a `screen` of nested `region` nodes                                 |
    | | An example a reader can run       | an `example` with a complete code block                             |

    behaviour_in_kinds: rule(guide.kinds, by = product.actors.author) {
      mustNot {{ state a behaviour in prose alone }}
      instead {{ state it as a rule, a criterion, an invariant or a transition, with the prose around it giving the reasons }}
    }

    rules_name_subject: rule(guide.kinds, by = product.actors.author) {
      should {{ name the subject of a rule with `by`: an actor, a [system part](#product.system) or a term }}
      unless {{ the rule binds the system as a whole }}
    }

    diagnostics_section: rule(guide.kinds, by = product.actors.author) {
      must {{ write each message the system reports as a `diagnostic` node of its own, in a `diagnostics` section of the concern that reports it, with `by` naming the system part that reports it }}
      then {{ one code such as `conflict` can name more than one diagnostic, and the docs list them all in one index by code }}
    }

    examples_complete: rule(guide.kinds, by = product.actors.author) {
      must {{ write every code block of an `example` as a complete tree or file, so an implementation can extract the examples as its parser and checker fixtures }}
    }

    named_instances: guidance(guide.kinds) {{
      A kind instance with a body and no arguments is written with a name, as
      `saved: criterion { … }`: without one, `criterion { … }` enters a node that must
      already exist. Names also give each criterion and step an anchor to link and verify.
    }}
  }

  reading: section {
    | An [implementer](#product.actors.implementer) loads one subtree and the surface of what
    | its rules target; everything else is loaded when a link leads there. A subtree is
    | complete when that's enough to build it.

    subtree_is_enough: rule(guide.reading, by = product.actors.author) {
      must {{ write each section, command and epic so that its subtree, the terms it links and the surface of its targets are all an implementer needs }}
    }
  }

  changing: section {
    | The spec's authors design; an implementation builds what a version of the package states
    | and can't amend it. A behaviour the spec doesn't state is a finding for the authors, not a
    | choice for the implementer.

    unstated_behaviour_is_a_finding: rule(guide.changing, by = product.actors.implementer) {
      when {{ building needs a behaviour the spec doesn't state }}
      mustNot {{ decide that behaviour on the spec's behalf }}
      instead {{ report it to the spec's authors as a finding }}
    }

    versioned_changes: rule(guide.changing, by = product.actors.author) {
      must {{ change the package's version with every change an implementation would see: the patch for a correction, the minor for a new behaviour, the major for a behaviour removed or changed }}
    }

    tree_stays_green: rule(guide.changing, by = product.actors.author) {
      must {{ pass `heron check`, `heron lint` and `heron fmt --check`, and render as the documentation site, after every change }}
    }
  }
}
