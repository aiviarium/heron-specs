// The Heron system's spec: the language, the product and the command line,
// as a sealed package. Implementations import it at a version and can't
// amend it; the content moves here from the implementation's spec/ tree.
import = ["std/schema@1", "std/doc@1", "std/spec@1", "std/product@1", "std/tech@1"]

/// The Heron language and the system that reads, checks, runs and documents
/// it, as seen from outside.
heron: package(version = "0.1.0", sealed = true) {
  | What Heron is, who it's for and how each part of the system behaves. Nothing in this
  | package names how the system is built.
}
