// The Heron system's spec, as a sealed package: the language, the product,
// the command line and the tools' behaviour. Implementations import it at a
// version and add only their own project tree; they can't amend it. Every
// folder is mounted as the scope of its name, as the guide says.
import = [
  "std/schema@1",
  "std/doc@1",
  "std/spec@1",
  "std/grammar@1",
  "std/lint@1",
  "std/docs@1",
]

heron: package(version = "0.6.0", sealed = true) {
  include = [
    "./guide.heron.md",
    "./actors.heron",
    "./system.heron",
    "./language/",
    "./cli/",
    "./tools/",
    "./learn/",
  ]

  // A folder's scope is named after the folder, so a name that's an acronym
  // gets its display name here, where the folder is included.
  @display("CLI")
  cli {}

  // The lenses a folder is for are said where the folder is included, as
  // the guide says: the tools are for people who write trees of their own.
  @lens(developer)
  tools {}

  one_source: goal(measure = "Spec, tests and docs of a tree never disagree in CI.") {{
    A team writes down what its system does once, as plain text it reviews like code, and
    the checks, the tests and the docs all follow from it.
  }}

  agents_build_from_spec: goal(measure = "An implementer builds a part from its subtree alone.") {{
    An [implementer](#actors.implementer) builds or changes a part of a system from its spec
    alone, and knows when it's done because the tests that prove the spec pass.
  }}

  readers_served: goal(measure = "Each audience finds what it needs in its own lens.") {{
    Everyone who reads a tree's docs, its users, its authors and its implementers, gets pages
    written for them from the same tree.
  }}

  no_runtime: nongoal {{ Running the system a spec describes: Heron checks, runs tasks and documents, and leaves serving production traffic to the product. }}

  @lens(user)
  | Heron is a language for writing down what a system does: its terms, rules, APIs,
  | commands and tasks, as one tree of plain text files. One command, `heron`, checks the
  | tree, runs its tasks and builds documentation like this site from it, so the spec, the
  | tests and the docs never disagree.

  | Version 0.6.0 of the Heron spec: the language, its format, [schemas](#language.schemas.kinds.schema), markup,
  | data, APIs, specifications, interop and scripting, and the system that reads, checks, runs
  | and documents it, as seen from outside, with the pages for the people who use it. Nothing in this package names how the system is
  | built.
}

docs {
  depth = 3
  lenses = [user, developer, explore]
}
