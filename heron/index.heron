// The Heron system's spec, as a sealed package: the language, the product,
// the command line and the tools' behaviour. Implementations import it at a
// version and add only their own project tree; they can't amend it. Every
// folder is mounted as the scope of its name, as the guide says.
import = [
  "std/schema@1",
  "std/doc@1",
  "std/spec@1",
  "std/product@1",
  "std/tech@1",
  "std/lint@1",
  "std/docs@1",
]

heron: package(version = "0.2.0", sealed = true) {
  include = [
    "./guide.heron",
    "./product/",
    "./language/",
    "./cli/",
    "./tools/",
    "./learn/",
  ]

  // A folder's scope is named after the folder, so a name that's an acronym
  // gets its display name here, where the folder is included.
  @display("CLI")
  cli {}

  // The lenses a folder is for are said where the folder is included, as
  // the guide says: the product (Heron's own actors, parts and backlog) is
  // for the full view, and the tools for people who write trees of their own.
  @lens(explore)
  product {}

  @lens(developer)
  tools {}

  @lens(user)
  | Heron is a language for writing down what a system does: its terms, rules, APIs,
  | commands and tasks, as one tree of plain text files. One command, `heron`, checks the
  | tree, runs its tasks and builds documentation like this site from it, so the spec, the
  | tests and the docs never disagree.

  | Version 0.2.0 of the Heron spec: the language, its format, [schemas](#language.schemas.kinds.schema), markup,
  | data, APIs, specifications, interop and scripting, and the system that reads, checks, runs
  | and documents it, as seen from outside, with the pages for the people who use it. Nothing in this package names how the system is
  | built.
}

docs {
  depth = 3
  lenses = [user, developer, explore]
}
