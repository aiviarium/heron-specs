// The development tools' behaviour: the language server and its API, prose
// linting, the editor grammar, the docs, the server, the descriptions
// generated for outside tooling and the VS Code extension.
include = [
  "./lsp.heron.md",
  "./lsp_api/",
  "./prose.heron",
  "./tree_sitter.heron.md",
  "./docs/",
  "./server.heron.md",
  "./server_api/",
  "./asyncapi.heron.md",
  "./proto.heron.md",
  "./openrpc.heron.md",
  "./sparrow.heron.md",
  "./vscode/",
]

@display("Server API")
server_api {}

@display("Language server API")
lsp_api {}

// The docs, prose linting and the VS Code extension are features of their own.
docs: feature(readers_served, docs.tasks_first, docs.pages_stay_true, docs.write_for_readers, docs.read_by_topic, docs.own_lenses, docs.full_view, docs.agents_read_the_spec, docs.same_node_everywhere) {}

@display("VS Code extension")
vscode: feature(actors.author) {}

| What the development tools do, as their users see it: the language server, prose linting,
| the editor grammar, the docs, the server and the VS Code extension.

tools_agree: goal(measure = "Editor, CI and docs report the same problems.") {{
  Every tool around the tree, the editor, the linter, the docs and the server, answers from the same checked tree, so they never disagree.
}}
