// The development tools' behaviour: the language server and its API, prose
// linting, the editor grammar, the docs, the server, the descriptions
// generated for outside tooling and the frontend.
include = [
  "./lsp.heron.md",
  "./lsp_api/",
  "./prose.heron",
  "./tree_sitter.heron.md",
  "./docs/",
  "./server.heron.md",
  "./server_api/",
  "./asyncapi.heron.md",
  "./proto.heron.md",
  "./openrpc.heron.md",
  "./sparrow.heron.md",
  "./frontend/",
]

@display("Server API")
server_api {}

@display("Language server API")
lsp_api {}

| What the development tools do, as their users see it: the language server, prose linting,
| the editor grammar, the docs, the server and the frontend.

tools_agree: goal(measure = "Editor, CI and docs report the same problems.") {{
  Every tool around the tree, the editor, the linter, the docs and the server, answers from the same checked tree, so they never disagree.
}}
