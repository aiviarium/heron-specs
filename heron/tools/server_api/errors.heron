// The errors the server's ops answer: each with its HTTP status, the
// message its body carries as `error` and its id as `code`.

@status(400)
not_in_workspace: error("server.NOT_IN_WORKSPACE") {
  title = "{path} is not a path in the workspace"
  path: field(String)
  | A path that is absolute or leaves the workspace's folder.
  | Reported as [tools.server.ops.path_in_workspace] says.
}

@status(404)
no_such_file: error("server.NO_SUCH_FILE") {
  title = "{path}: no such file"
  path: field(String)
  | Reported as [tools.server.ops.agent_export_op] says.
}

@status(404)
no_op: error("server.NO_OP") {
  title = "no op at {method} {path}"
  method: field(String)
  path: field(String)
  | Reported as [tools.server.serving.unknown_op] says.
}

@status(403)
origin_not_allowed: error("server.ORIGIN_NOT_ALLOWED") {
  title = "{origin} may not call this server"
  origin: field(String)
  | A request from a page of another origin than the server's.
  | Reported as [tools.server.serving.same_origin] says.
}
