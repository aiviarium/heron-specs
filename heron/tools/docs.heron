docs: section {
  | What the docs generator makes of a checked tree: a documentation site of plain files that
  | work without a server, the same pages `heron serve` shows live as the spec browser, so
  | what people read and what they edit never look different.

  site: section {
    | A site is a home page, one page per [page node](#tools.docs.site.page_node), and the pages that gather one kind
    | across the tree. Every other node shows on the page of its nearest ancestor that has
    | one, at its own anchor.

    page_node: term {{
      A node that gets a page of its own: a section or a documented [folder scope](#guide.layout.folder_scope) less than
      `depth` levels down, `2` unless the [docs block](#tools.docs.extending.docs_block) sets it; at any depth, an api, an op, a type
      declaration of the tree, a component, a command, an epic, a use case and a screen.
    }}

    site_area: term {{
      A top-level part of the site, a tab in the top bar with its own navigation tree: Docs,
      Reference when the tree has an api or a type, and Glossary when it has a term.
    }}

    page_files: rule(tools.docs.site, by = product.system.docs_generator) {
      must {{ write each page as a file at the site's root named by its node's [path](#language.core_format.naming.node_path), as `orders.ordering.html`, the home page as `index.html`, the gathered pages as `_glossary.html` and `_diagnostics.html`, and the assets under `_assets/` }}
      then {{ every link is relative and the site opens from disk }}
    }

    page_nodes: rule(tools.docs.site, by = product.system.docs_generator) {
      must {{ give every [page node](#tools.docs.site.page_node) a page, and show every other node of the tree on the page of its nearest ancestor that has one }}
    }

    site_title: rule(tools.docs.site, by = product.system.docs_generator) {
      must {{ title the site with the root project's [display name](#language.core_format.naming.display_name), or the entry file's folder when the tree declares no project }}
    }

    gathered_pages: rule(tools.docs.site, by = product.system.docs_generator) {
      must {{ gather the tree's terms on a glossary page and its diagnostics by code on a diagnostics page, each only when the tree has one }}
    }

    pages_follow_tree: rule(tools.docs.site, by = product.system.docs_generator) {
      must {{ render features with their rules, terms with hover cards wherever a term is used, qualities with their metrics, and APIs and types as the [reference screens](#tools.frontend.screens) say, all cross-linked }}
    }

    sentences_from_spec: rule(tools.docs.site, by = product.system.docs_generator) {
      mustNot {{ add a sentence of its own to a page }}
      instead {{ add headings, labels, navigation and values from the [string catalogue](#tools.frontend.writing.string_catalogue), and show a kind with no prose as its structure alone }}
    }
  }

  page_layout: section {
    | Every page has the same frame, after Fumadocs: the top bar, the navigation, the page
    | and a right column.

    frame: rule(tools.docs.page_layout, by = product.system.docs_generator) {
      must {{ lay out a page as a top bar with the logo, the [site areas](#tools.docs.site.site_area), search with its shortcut, the version switch and the theme switch; the navigation tree of its [site area](#tools.docs.site.site_area) on the left; a breadcrumb and the page in the middle; and on the right the page's outline, or an op's examples, sticky as the page scrolls }}
    }

    narrow_screens: rule(tools.docs.page_layout, by = product.system.docs_generator) {
      when {{ the window is 1180 px wide or less }}
      must {{ drop the right column below the page, and at 820 px or less collapse to one column with the navigation behind a button }}
    }

    theme_before_paint: rule(tools.docs.page_layout, by = product.system.docs_generator) {
      must {{ apply the theme the reader chose, kept in `localStorage` as `heron-theme`, before the page paints, and follow the system's light or dark preference until one is chosen }}
    }
  }

  renderers: section {
    | Renderers per kind are an [extension point](#language.interop.declaring.extension_point) the docs and the live preview share:
    | a scenario or a prompt shows properly once its extension is installed, and as a plain node
    | before that.

    renderer_per_kind: rule(tools.docs.renderers, by = product.system.docs_generator) {
      must {{ render a node through the renderer registered for its kind's declaration path, such as `spec.rule`, with the latest registration winning }}
      unless {{ none is registered, and then the node shows as its title, prose, fields and children }}
    }

    tag_renderers: rule(language.markup.tags.component_tag, by = product.system.docs_generator) {
      must {{ render a markup tag through the renderer registered for its kind, with its attributes typed by the kind's parameters, or else through the built-in components of `std/doc` }}
    }

    ts_renderer: term {{
      A renderer written in TS: an export of a module the [docs block](#tools.docs.extending.docs_block) names in `renderers`,
      made with `defineRenderer(kind, render)` from `@heron/runtime`, run through the
      [JS host](#language.interop.host.js_host) when the docs are generated.
    }}

    ts_renderer_contract: rule(tools.docs.renderers.ts_renderer, by = product.system.docs_generator) {
      must {{ register one renderer per kind a module's handshake reports, and call its `render` with plain data: the node's path, name, kind, title, heading level, anchor, rendered prose and children, its kind's arguments as typed attributes, and the components of its kind's other slots by name; for a markup tag, its rendered body and its attributes instead of a path }}
      then {{ `render` returns HTML, or HTML with whether a tag is a block and which built-in islands it uses }}
    }

    ts_renderer_fallback: rule(tools.docs.renderers.ts_renderer, by = product.system.docs_generator) {
      must {{ keep the built-in renderer, or the generic view, for every kind a module doesn't render }}
    }

    heron_template_renderers: rule(tools.docs.renderers, by = product.system.docs_generator) {
      may {{ take renderers and islands written as Heron templates }}
    }
  }

  extending: section {
    | The generator is a set of parts a package can restyle, replace or add to, configured
    | once per tree by `std/docs`.

    docs_block: term {{
      A tree's `docs { … }` block from `std/docs`: its [theme package](#tools.docs.extending.theme_package), its renderer modules, its
      `depth`, a `layout` per group of sections and its `slot` nodes.
    }}

    theme_package: term {{
      A package of design tokens, fonts, logo and CSS, `npm:<name>@<major>` found in a
      `node_modules` folder at or above the file naming it, or a folder. Its
      `heron-theme.json` lists a token file in the format of the design system's `tokens.json`, its font faces, its
      logo and its stylesheets.
    }}

    theme_layer: rule(tools.docs.extending.theme_package, by = product.system.docs_generator) {
      must {{ compose a [theme package](#tools.docs.extending.theme_package) into `_assets/theme/theme.css` in `@layer theme`, after the built-in theme in `@layer heron`, copy its fonts and logo beside it, and show its logo in place of the top bar's mark }}
      then {{ a theme changes the look without touching structure }}
    }

    layouts_per_section: rule(tools.docs.extending, by = product.system.docs_generator) {
      must {{ give the sections a `layout` names, and the pages below them, that layout: `docs` (the default), `api` (the page joins the API reference), `changelog` (each child section is an entry on one page, in the order written) or `landing` (no sidebar, the prose as a lead and a tile per page below) }}
    }

    changelog_entries: rule(tools.docs.extending, by = product.system.docs_generator) {
      where {{ a section takes the `changelog` layout }}
      must {{ show each child section as an entry, its title in the margin and its notes beside it }}
    }

    release_notes: rule(tools.docs.extending, by = product.system.docs_generator) {
      when {{ the tree records releases }}
      must {{ render each project's release notes from its release records on the changelog page }}
    }

    slots: rule(tools.docs.extending, by = product.system.docs_generator) {
      must {{ show a `slot`'s prose and nodes, each through its kind's renderer, in the page `header`, the `sidebar`, or `before` and `after` the content; with `of = <kind>`, show `before` and `after` around every node of that kind, and hand its other names to the kind's renderer to place }}
    }

    docs_configuration: example {
      | ```heron
      | docs {
      |   theme = "npm:@acme/heron-theme@2"
      |
      |   layout("api") {
      |     sections = [store_api]
      |   }
      |
      |   renderers = [js("./docs/renderers.ts")]
      | }
      | ```
    }
  }

  islands: section {
    | A page reads fully before any script runs. The islands are one classic script and one
    | data script, `data.js`, which holds the search index, the hover cards and the
    | islands' strings, because browsers refuse module scripts and fetches from `file://`.

    | | Island         | What it adds                                                                        |
    | | -------------- | ----------------------------------------------------------------------------------- |
    | | search         | a palette over the search index, on ⌘K, Ctrl+K or `/`                               |
    | | hover cards    | a term's definition or a type's signature, on hovering or focusing a link to it     |
    | | Try it         | sends an op's request to a server                                                   |
    | | diagram        | pan and zoom, a node's neighbours highlighted on hover, and its page on click       |
    | | diagram view   | the switch between a diagram and its table                                          |
    | | tabs           | a union's variants and an example's languages, with arrow keys, Home and End        |
    | | examples       | the example picker of an op                                                         |
    | | copy           | the copy button of a code block                                                     |
    | | version switch | opens the same page in another released build                                       |
    | | theme          | switches between dark and light                                                     |

    islands_enhance: rule(tools.docs.islands, by = product.system.docs_generator) {
      must {{ mark each interactive part with `data-island`, and let the script enhance the markup in place, mounting Solid components only for the overlays: the search palette, the hover cards and Try it }}
      then {{ a page without its script still shows every part, and the overlays get the focus and dismissal behaviour of the UI SDK }}
    }

    islands_work: rule(tools.docs.islands, by = product.system.docs_generator) {
      must {{ make every island the table lists work from `file://`, with no script error }}
    }

    try_it: rule(tools.docs.islands, by = product.system.docs_generator) {
      may {{ send an op's request to the server its reader configures, kept in `localStorage` and the page's origin unless set, with parameters from the selected example and authentication from the API's security schemes }}
    }
  }

  search: section {
    search_index: rule(tools.docs.search, by = product.system.docs_generator) {
      must {{ build the search index when the docs are generated, over every documented node with an anchor: terms by their word, sections, kinds' nodes, tasks, projects, examples and the fields of the tree's types as `Type.field`, each with its kind, its path, its URL, its page's title and up to 240 characters of its text, a rule's or quality's sentence first }}
      then {{ an op, a type, a field or a rule is found by name and opens at its anchor }}
    }

    hover_cards: rule(tools.docs.search, by = product.system.docs_generator) {
      must {{ write a hover card for every term, with its definition, and for every type, with its signature }}
    }
  }

  diagrams: section {
    | Diagrams are laid out by the docs generator when the docs are generated and written as SVG coloured
    | from the theme's tokens, so they work without a script.

    svg_layout: rule(tools.docs.diagrams, by = product.system.docs_generator) {
      must {{ place a diagram's nodes in layers by their distance from the roots, rows in the order the tree writes them, draw forward edges as curves from right to left sides and edges back or within a layer as arcs below the boxes, behind a faint dot grid }}
    }

    diagram_style: rule(language.specifications.lifecycles.lifecycle, by = product.system.docs_generator) {
      must {{ draw states as bordered boxes on the raised colour, mark initial and final states by their shape, label transitions with their name and the op that performs them in the [project colour](#tools.frontend.design_system.project_colour), and mark a transition nothing performs in the warning colour }}
    }

    table_view: rule(tools.docs.diagrams, by = product.system.docs_generator) {
      must {{ give every diagram a table with the same information, and a switch between the two }}
    }

    task_graph: rule(tools.docs.diagrams, by = product.system.docs_generator) {
      where {{ a node holds tasks and one of them `@needs` another }}
      must {{ show its tasks and their needs as a dependency graph }}
    }

    package_graph: rule(tools.docs.diagrams, by = product.system.docs_generator) {
      where {{ a tree imports a local package }}
      must {{ show the packages the tree imports, with their own imports, as a dependency graph on the home page }}
    }

    coverage_graph: rule(tools.docs.diagrams, by = product.system.docs_generator) {
      when {{ the tree has proofs linking its rules to tests }}
      must {{ show what covers each rule as a graph }}
    }
  }

  versions: section {
    working_build: rule(tools.docs.versions, by = product.system.docs_generator) {
      must {{ write `heron generate docs` into `.heron/docs/` under the working directory, with `versions.json` listing the released builds under `.heron/docs/v/<version>/` }}
    }

    version_switch: rule(tools.docs.versions, by = product.system.docs_generator) {
      where {{ `versions.json` lists a released build }}
      must {{ offer it in the top bar's version switch, which opens the same page in that build }}
    }

    released_builds: rule(tools.docs.versions, by = product.system.docs_generator) {
      when {{ a version is released }}
      must {{ write that version's build under `.heron/docs/v/<version>/` }}
    }
  }
}
