// The language server's own methods, beyond the language server protocol's,
// described as JSON-RPC with std/jsonrpc: the api, its types and its errors.
import = ["std/types@1", "std/jsonrpc@1"]

| The requests [the language server](#system.language_server) answers beyond the language
| server protocol's own, described as the JSON-RPC methods they are, with the protocol's
| `Content-Length` framing. The [extensions](#tools.lsp.extensions) say what they do.

@display("Heron language server")
@jsonrpc(framing = content_length)
language_server: api {
  | The methods a client sends `heron lsp` beside the protocol's.

  @jsonrpc("heron/source")
  @throws(errors.no_file)
  source(@params request: SourceParams): op(SourceText, tools.lsp.extensions.source_request, tools.lsp.extensions.source_request_otherwise) {
    | A file's current text by its URI, such as a standard package's embedded file, which an
    | editor opens read-only.

    std_file: example {
      request = SourceParams(uri = "heron:/std/doc/package.heron")
      returns = SourceText(text = "// std/doc: the components prose places.")
    }

    missing: example {
      request = SourceParams(uri = "heron:/std/nothing.heron")
      throws = errors.no_file
    }
  }

  @jsonrpc("heron/preview")
  @throws(errors.no_file)
  preview(@params request: PreviewParams): op(PreviewPage, tools.lsp.extensions.preview_request, tools.lsp.extensions.preview_request_otherwise) {
    | The node at a position of an open document rendered as its docs page shows it, from the
    | text as typed, which an editor shows beside the code.

    on_a_rule: example {
      request = PreviewParams(uri = "file:///work/pets/index.heron", position = Position(line = 4, character = 2))
      returns = PreviewPage(path = "pets.adopt", html = "Adopt a pet once its owner signs.")
    }
  }
}

/// What `heron/preview` asks for.
PreviewParams: type {
  /// The document's `file:` URI.
  uri: String
  /// The cursor, as the protocol counts it.
  position: Position
  /// Whether to answer the docs' stylesheet too, which a client asks for once.
  styles?: Bool
}

/// A place in a document as the protocol counts it.
Position: type {
  /// 0-based.
  line: Int
  /// 0-based, in UTF-16 code units.
  character: Int
}

/// A node rendered as its docs page shows it.
PreviewPage: type {
  /// The node's path in the tree; empty for the file itself.
  path: String
  /// The rendered markup, styled by `styles`; empty when the render failed.
  html: String
  /// The error that stopped the render.
  error?: String
  /// The docs' stylesheet, when the request asked for it.
  styles?: String
}

/// What `heron/source` asks for.
SourceParams: type {
  /// A `file:` URI under the workspace's root, or a `heron:/std/` one.
  uri: String
}

/// A file's text, as the session holds it.
SourceText: type {
  text: String
}

errors: section {
  @status(404)
  @code(-32602)
  no_file: error("lsp.NO_FILE") {
    title = "no file {uri}"
    uri: String
    | An invalid-parameters error: the URI names no open document, loaded file or file on disk.
    | Reported as [tools.lsp.extensions.source_request_otherwise] says.
  }
}
