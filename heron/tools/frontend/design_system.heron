@display("Design")
design_system: section {
  | Compact and quietly polished: the density and calm of Linear in the tools, and the finish
  | of Fumadocs and Mintlify in the docs. One set of tokens, declared once in `tokens.json`, holds
  | the colours, type, sizes, radii, spacing and motion, generated to CSS variables
  | (`--h-<name>`) and the other languages the tools are built in, and used by the app, the editor and the docs alike.
  | The rules on the tokens bind [the editor](#product.system.editor) and the docs alike; the rules on
  | composing them bind whoever builds a view.

  surfaces: term {{
    The four neutral background colours, with no tint: `bg-page` for the page, `bg-raised`
    for bars and cards, `bg-soft` for table heads, code titles and fields, and
    `bg-highlight` for the selected item.
  }}

  text_levels: term {{
    The four levels of text: `text` for the body, `text-secondary`, `text-faint`, the
    faintest a person still reads, and `text-decor`, for decoration only.
  }}

  project_colour: term {{
    The one colour of a project, the `accent` token: used for links, references to other
    nodes, 1 px borders, small marks, the logo and the focus ring. The tools use their own
    accent the same way.
  }}

  status_colours: term {{
    The colours that carry meaning: `status-ok`, `status-warn`, `status-error` and
    `status-info` for HTTP methods and statuses, results and diagnostics, and `type` for a
    type's name wherever it appears.
  }}

  contrast_ratio: metric(Float) {{
    The WCAG contrast ratio of a text or mark colour on a surface, in one theme.
  }}

  tokens: section {
    one_source: rule(tools.frontend.design_system.tokens, by = product.system.editor) {
      must {{ generate `tokens.css` and every other language's tokens from `tokens.json` alone, and keep the committed outputs equal to what generation writes }}
    }

    readable_contrast: quality(text_levels, project_colour, status_colours) {
      metric = contrast_ratio
      at_least = 4.5
      must {{ give every text level a reader needs, and every mark colour, a contrast of at least 4.5:1 on each of the four [surfaces](#tools.frontend.design_system.surfaces) in both themes }}
      unless {{ a mark colour stands on `bg-highlight`, or the level is `text-decor` }}
    }

    untinted: rule(surfaces, by = product.system.editor) {
      must {{ keep every surface, text, border and `bg-` colour neutral, its red, green and blue equal, in both themes }}
    }

    compact_sizes: rule(tools.frontend.design_system.tokens, by = product.system.editor) {
      must {{ size controls at 24, 28 and 32 px, rows at 28 px, and the top bar at 44 px; give marks and inline code a radius of 4 px, controls 6 px, cards and code 8 px and overlays 10 px; and keep every spacing step on a 4 px grid }}
    }

    type_scale: rule(tools.frontend.design_system.tokens, by = product.system.editor) {
      must {{ set the interface at 13 px, docs prose at 15 px with lines of at most 72 characters, code, paths, identifiers, field names and numbers in the mono at 12.5 px, and group labels at 11 px }}
    }

    quiet_motion: rule(tools.frontend.design_system.tokens, by = product.system.editor) {
      must {{ keep every duration between 120 and 200 ms }}
    }
  }

  composing: section {
    | These bind whoever builds a view of the app or the docs, and the reviewer of it.

    dark_first: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      must {{ design the dark theme first, and the light theme alongside it rather than inverted from it }}
    }

    hairlines_not_shadows: rule(surfaces, by = product.actors.implementer) {
      mustNot {{ separate things with shadows }}
      instead {{ separate them with hairline borders in three strengths, `border-faint`, `border` and `border-strong` }}
    }

    overlays_cast_shadows: rule(surfaces, by = product.actors.implementer) {
      may {{ give an overlay the `shadow-overlay` shadow, such as a menu, a popover or the command palette }}
    }

    project_colour_never_fills: rule(project_colour, by = product.actors.implementer) {
      mustNot {{ fill a button, card, callout, code block or cell with the [project colour](#tools.frontend.design_system.project_colour) }}
    }

    status_colours_mean: rule(status_colours, by = product.actors.implementer) {
      mustNot {{ use a [status colour](#tools.frontend.design_system.status_colours) for anything but what it means }}
    }

    no_filled_pills: rule(status_colours, by = product.actors.implementer) {
      mustNot {{ show a status or kind colour as a filled pill }}
      instead {{ show it as coloured text or a 1 px outline }}
    }

    buttons: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      must {{ give buttons grey fills with no outline, one primary button per view filled with the text colour, and icon buttons a transparent fill until hovered }}
    }

    headings: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      must {{ set headings in semibold with the `tracking-heading` letter spacing, and group labels in the faintest readable level }}
    }

    polish_from_detail: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      mustNot {{ use gradients on text or [surfaces](#tools.frontend.design_system.surfaces), glow, emoji or illustrations }}
      instead {{ polish through detail: a translucent top bar with backdrop blur, a faint dot grid behind diagrams, focus rings on keyboard focus only, syntax colours from the same tokens, and code blocks with a title bar and a copy button }}
    }

    motion_explains: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      may {{ animate a change that motion explains, such as a panel opening, a row expanding or a result arriving }}
      unless {{ the reader asks for reduced motion }}
    }

    keyboard_first: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      must {{ offer a command palette on ⌘K in every tool and on the docs, shortcuts for every frequent action, and focus that's always visible }}
    }

    ui_sdk_base: rule(tools.frontend.design_system.composing, by = product.actors.implementer) {
      must {{ compose components from the [UI SDK](#tools.frontend.design_system.ui_sdk)'s behaviours in the shared component package, rather than writing popups, selection, typeahead, roving focus, reordering, resizing or virtual lists by hand }}
      then {{ accessibility comes with the behaviours rather than being added per component }}
    }
  }

  ui_sdk: term {{
    The base of the frontend: behaviours and primitives with Solid bindings, such as popups,
    selection, typeahead, roving focus, reordering, resizing and virtualized lists, which
    the shared component library composes into the app's components. Its skill is part of the
    repository's generated agent files, so an agent composes from the same behaviours.
  }}
}
