// The frontend: the design system, the shell, the editor and the preview.
include = [
  "./design_system.heron",
  "./writing.heron.md",
  "./screens/",
  "./shell.heron.md",
  "./editor.heron",
  "./preview.heron",
]

| The frontend `heron serve` serves: the design system, the shell, the editor and its preview.

edit_in_browser: goal(measure = "An author fixes a problem without leaving the browser.") {{
  Authors edit a tree in the browser with the same checks, previews and fixes the command line gives.
}}
