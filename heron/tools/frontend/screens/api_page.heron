@display("API page")
api_page: screen(route = "/<api>.html") {
  | An api's landing page in the API reference: what it is, how it travels on the wire, and
  | every op grouped by the surface it belongs to, one line each, so a reader finds an op
  | without opening each one. The top bar and the sidebar are the [op page](#tools.frontend.screens.op_page)'s.

  @realizes(tools.frontend.screens.api_page.lead.api_facts)
  lead: region {
    | The api's prose, its base path and its wire format.

    api_facts: rule(by = system.docs_generator) {
      must {{ show the api's prose, its base path, and its wire format: JSON bodies over HTTP, streams as server-sent events and sockets as websocket frames }}
    }
  }

  @realizes(tools.frontend.screens.api_page.service.service_lead, tools.frontend.screens.api_page.service.methods_grouped, tools.frontend.screens.api_page.service.signature_each, tools.frontend.screens.api_page.service.facts_by_binding)
  service: region {
    | An api bound to a gRPC service or to JSON-RPC reads as a service: its name, its
    | protocols, and its methods by their signatures.

    service_lead: rule(by = system.docs_generator) {
      where {{ an api is bound by `std/proto` or `std/jsonrpc` }}
      must {{ show the service's fully qualified name with a copy button, the [protocols](#language.apis.grpc.proto_protocol) it's served over, its JSON-RPC [framing](#language.apis.jsonrpc.jsonrpc_framing) and encoding, whether it takes batches, and its [server URLs](#language.apis.rpc.server_url) }}
    }

    facts_by_binding: rule(by = system.docs_generator) {
      must {{ show each fact as its label and its value, and under the [binding switch](#tools.frontend.screens.op_page.bindings.binding_switch) only the facts of the binding picked: the base path and the wire format for HTTP, the service and its protocols for gRPC and Connect, the framing, the encoding and batches for JSON-RPC, and the servers and the cross-cutting annotations for every binding }}
    }

    methods_grouped: rule(by = system.docs_generator) {
      where {{ an api is bound by `std/proto` or `std/jsonrpc` }}
      must {{ group a gRPC service's methods by [streaming kind](#language.apis.rpc.streaming_kind), unary first, and a JSON-RPC api's by the part of the method's name before its first `/` or `.`, [notifications](#language.apis.jsonrpc.jsonrpc_notification) last }}
    }

    signature_each: rule(by = system.docs_generator) {
      must {{ show each method on one line under its group's heading: its signature as `Method(Request) returns (stream Response)` or its JSON-RPC name, its [display name](#language.core_format.naming.display_name) linked to its page, and the first sentence of its prose }}
      then {{ the group's heading names the [streaming kind](#language.apis.rpc.streaming_kind) once, rather than a badge on each method }}
    }

    both_indexes: rule(by = system.docs_generator) {
      where {{ an api has more than one binding }}
      must {{ show each binding's index under the [binding switch](#tools.frontend.screens.op_page.bindings.binding_switch) }}
    }
  }

  @realizes(tools.frontend.screens.api_page.ops.ops_grouped, tools.frontend.screens.api_page.ops.one_line_each)
  ops: region {
    | The ops, grouped.

    ops_grouped: rule(by = system.docs_generator) {
      must {{ group the api's ops by the first segment of their path after the base path, each group in the order its first op is written }}
    }

    one_line_each: rule(by = system.docs_generator) {
      must {{ show each op on one row: its method, its path, its [display name](#language.core_format.naming.display_name) linked to its page, the first sentence of its prose, and a mark when it's deprecated }}
    }
  }

  @realizes(tools.frontend.screens.api_page.types.types_listed)
  types: region {
    | The types and errors the api's ops name.

    types_listed: rule(by = system.docs_generator) {
      must {{ list the types and the errors the api's ops name, directly or through the fields of other types, each linked to its page with the first sentence of its docs }}
    }
  }
}
