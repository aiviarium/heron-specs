@display("Editor")
editor_screen: screen(route = "/") {
  | The editor `heron serve` opens on: the source, the problems in it, and beside it what
  | the docs make of it and what running it produced. [The code editor](#tools.frontend.editor) gives its behaviour,
  | and [the shell](#tools.frontend.shell) the slots its parts fill.

  title_bar: region(tools.frontend.screens.editor_screen.title_bar.tabs_follow_files) {
    | The workspace's name, the open files as tabs with an unsaved mark and a close
    | button, and the main actions: search with ⌘K, format, save, the preview and the theme.

    tabs_follow_files: rule(system.editor) {
      must {{ show a tab per open file, named by its file name and by as much of its folder as tells two of one name apart, with the unsaved mark while its text differs from the disk }}
    }
  }

  sidebar: region {
    file_tree: region(tools.frontend.screens.editor_screen.sidebar.file_tree.problem_counts) {
      | The tree's files as folders, each file with its problem counts.

      problem_counts: rule(system.editor) {
        must {{ show beside each file the errors and warnings of its last analysis, equal to what `heron check` reports for it }}
      }
    }

    generated_files: region {
      | The files generation would write, each opening as a read-only preview.
    }

    outline: region(tools.frontend.screens.editor_screen.sidebar.outline.outline_follows) {
      | The current file's nodes, each with its kind, opening at its line.

      outline_follows: rule(system.editor) {
        must {{ list the current file's nodes with their kinds, and move the cursor to a node's line when it's chosen }}
        while {{ the file has nodes }}
      }

      outline_follows_otherwise: rule(system.editor) {
        when {{ the file has no nodes }}
        must {{ show the empty label }}
      }
    }
  }

  code: region {
    breadcrumb: region {
      | The file's path, then the nodes around the cursor, each opening at its line; a
      | generated file is marked read-only.
    }

    gutter: region(tools.frontend.screens.editor_screen.code.gutter.gutter_results) {
      | Results beside the nodes they belong to, from every gutter provider.

      gutter_results: rule(system.editor) {
        must {{ mark each node that has results with its latest status and summary, and start a run from a runnable node's mark, streaming its status into the same mark }}
      }
    }

    diagnostics_hover: region(tools.frontend.screens.editor_screen.code.diagnostics_hover.problem_hover) {
      | Each diagnostic is an underline; its hover shows the problem, its source, such as the
      | type checker or Vale, and its fixes as actions.

      problem_hover: rule(system.editor) {
        must {{ show the message of a diagnostic, its source by its name in the catalogue (the type checker, a lint, Vale or the spec lints) and its code in the hover, with each fix offered as a code action }}
      }
    }
  }

  preview: region {
    | The current node, or the current file, rendered as the docs render it, with its
    | results below; a generated file shows as it would be written.
  }

  bottom_panel: region {
    | The panels of the `bottom` slot as tabs; the problems panel lists every problem of
    | the tree, each opening at its place.
  }

  status_bar: region(tools.frontend.screens.editor_screen.status_bar.language_server_state, tools.frontend.screens.editor_screen.status_bar.status_counts) {
    | The branch, the problem counts, the language server's state and the cursor's line
    | and [column](#heron.language.grammar.lexical.column).

    status_counts: rule(system.editor) {
      must {{ show the tree's error and warning counts, opening the problems panel when chosen, and the cursor's line and [column](#heron.language.grammar.lexical.column) as it moves }}
    }

    language_server_state: rule(system.editor) {
      must {{ show the language client's state: connecting, connected, reconnecting with its reason, or failed with its reason and a retry action }}
    }
  }

  palette: region {
    | The command palette over the screen, on ⌘K: every command that shows now, with its
    | shortcut, filtered as one types.
  }
}
