@display("Writing in the interface")
writing: section {
  | Pages and tools carry labels, values and structure, not explanations. Every sentence a
  | reader meets comes from a spec; what the tools add is a label from [the catalogue](#tools.frontend.writing.string_catalogue).
  | Some rules bind the tools, which a reader can check on every page; the rest bind the
  | implementer who writes the view and the reviewer of it.

  string_catalogue: term(aliases = ["string catalogue"]) {{
    The catalogue of every string the tools show that doesn't come from a spec, in
    `strings.json`, keyed `<tool>.<group>.<name>`: the docs read `docs.*`, their islands
    `docs.island.*`, and the app `app.*`.
  }}

  visible_text: section {
    docs_text_sourced: rule(tools.frontend.writing.visible_text, by = product.system.docs_generator) {
      must {{ show on a docs page only words that come from the spec (its files, or the standard packages its kinds are declared in) or from the catalogue, besides numbers and punctuation }}
    }

    app_text_sourced: rule(tools.frontend.writing.visible_text, by = product.system.editor) {
      must {{ show on the [editor screen](#tools.frontend.screens.editor_screen) only text from the spec of the served tree and the standard packages it uses, or from the catalogue, in every label, input hint and title a person reads, the palette and the problems panel included }}
      unless {{ the text is the code in the editor, or what Monaco draws inside its own widgets, such as the find widget's labels }}
    }

    tools_text_in_widgets: rule(tools.frontend.writing.visible_text, by = product.system.editor) {
      must {{ take what the tools put into Monaco's widgets from the spec or the catalogue: hover contents, diagnostics, code action titles, completion items and the problem hover, with Monaco's extra links removed from it }}
    }
  }

  catalogue_wording: section {
    labels_not_sentences: rule(tools.frontend.writing.catalogue_wording, by = product.system.editor) {
      mustNot {{ hold an entry that ends with a full stop }}
      then {{ the tools show no helper sentences, no intro lines saying what a page or panel shows, and no paragraphs in empty states }}
    }

    no_generated_tells: rule(tools.frontend.writing.catalogue_wording, by = product.system.editor) {
      mustNot {{ hold "seamless", "powerful", "effortless", "Let's", "Note that", "Learn more", "Powered by", "Auto-generated", "New", an exclamation mark, a question mark, an emoji or a sparkle }}
    }

    interface_style: rule(tools.frontend.writing.catalogue_wording, by = product.system.prose_linter) {
      must {{ lint `strings.json` with a Vale style for interface text, as the prose lints lint the spec }}
    }
  }

  composing_text: section {
    | These bind whoever writes a view or a catalogue entry.

    empty_states: rule(tools.frontend.writing.composing_text, by = product.actors.implementer) {
      must {{ show an empty state as a short label and, if there is one, the action }}
    }

    meaningful_badges: rule(tools.frontend.writing.composing_text, by = product.actors.implementer) {
      must {{ show a badge only where it changes what the reader does: the HTTP method, required, deprecated, not yet stable, and the version something was added or removed in }}
      example {{ no "New", no "Auto-generated", no count of things already visible }}
    }

    nothing_redundant: rule(tools.frontend.writing.composing_text, by = product.actors.implementer) {
      mustNot {{ show a label that repeats its heading, an overview that restates the children, a tooltip that repeats the visible text, or a section for an empty field }}
      example {{ "Returns the order" under a return type of `Order` is redundant }}
    }

    labels: rule(tools.frontend.writing.composing_text, by = product.actors.implementer) {
      must {{ write labels short and in sentence case, buttons as verbs such as Run, Copy or Open, and an error as one line saying what's wrong and where, with the fix as an action when there is one }}
    }

    no_closing_summary: rule(tools.frontend.writing.composing_text, by = product.actors.implementer) {
      mustNot {{ close a page with a summary, ask a rhetorical question, or use a "Learn more" link that doesn't say where it goes }}
    }
  }
}
