@display("Live preview")
preview: section {
  | What matters beside the source is seeing the result: the rendered documentation and what
  | running it produced. The preview shows the node under the cursor, or the file, through
  | the same renderer as the generated docs: a section with its rules and terms, an api with
  | its operations and examples, a [lifecycle](#language.specifications.lifecycles.lifecycle) as a diagram.

  live_preview: rule(tools.frontend.preview, by = product.system.editor) {
    when {{ the text or the node under the cursor changes }}
    must {{ ask the server's `preview` with the unsaved texts on the next animation frame, and show the answer unless a newer one was asked for }}
  }

  same_as_docs: rule(tools.frontend.preview, by = product.system.docs_generator) {
    must {{ render the previewed node as its page in the docs shows it: the page's content when it has a page, its own view otherwise }}
  }

  error_in_place: rule(tools.frontend.preview, by = product.system.editor) {
    if {{ a render fails }}
    must {{ keep the last page and show the error in place above it }}
  }

  slow_analyses: rule(tools.frontend.preview, by = product.system.editor) {
    when {{ the text changes }}
    must {{ ask for the problems, the outline and the results 150 ms after the last change }}
  }

  results_in_place: rule(tools.frontend.preview, by = product.system.editor) {
    must {{ show below the preview and in the gutter the latest results of each node, from every result provider the server holds, and stream a run started from the gutter into the same place }}
  }

  generated_preview: rule(tools.frontend.preview, by = product.system.editor) {
    must {{ show a generated file, chosen from the file tree, as it would be written, before anything is generated }}
  }

  preview_speed: metric(Float) {{
    The time in seconds from a keystroke to the preview showing its effect.
  }}

  preview_done: quality(tools.frontend.preview) {
    metric = preview_speed
    at_most = 1.0
    must {{ show a change to a rule or api in the preview, rendered as in the docs, within a second of typing, with the latest records beside each node }}
  }
}
