@display("Design")
design_system: section {
  | Compact and quietly polished: the density and calm of Linear in the tools, and the finish
  | of Fumadocs and Mintlify in the docs. One set of tokens, declared once in `tokens.json`, holds
  | the colours, type, sizes, radii, spacing and motion, generated to CSS variables
  | (`--h-<name>`) and the other languages the tools are built in, and used by the docs and
  | their islands. The rules on the tokens bind [the docs generator](#system.docs_generator); the rules on
  | composing them bind whoever builds a view.

  surfaces: term {{
    The four neutral background colours, with no tint: `bg-page` for the page, `bg-raised`
    for bars and cards, `bg-soft` for [table](#heron.language.markup.components.table) heads, code titles and fields, and
    `bg-highlight` for the selected item.
  }}

  text_levels: term {{
    The four levels of text: `text` for the body, `text-secondary`, `text-faint`, the
    faintest a person still reads, and `text-decor`, for decoration only.
  }}

  project_colour: term {{
    The one colour of a project, the `accent` token: used for links, references to other
    nodes, 1 px borders, small marks, the logo and the focus ring. The tools use their own
    accent the same way.
  }}

  status_colours: term {{
    The colours that carry meaning: `status-ok`, `status-warn`, `status-error` and
    `status-info` for HTTP methods and statuses, results and diagnostics, and `type` for a
    type's name wherever it appears.
  }}

  readable: quality(measure = "A contrast of at least 4.5:1, as WCAG measures it.") {{
    Every text a reader needs, and every mark, reads on every surface in both themes.
  }}

  tokens: section {
    one_source: rule(system.docs_generator) {
      must {{ generate `tokens.css` and every other language's tokens from `tokens.json` alone, and keep the committed outputs equal to what generation writes }}
    }

    readable_contrast: scenario(tools.docs.design_system.readable) {
      stimulus =| a reader reads a text level or a mark colour, other than a mark colour on `bg-highlight` or the level `text-decor`
      environment =| each of the four [surfaces](#heron.tools.docs.design_system.surfaces), in both themes
      response =| the colour stands out from its surface
      measure =| a WCAG contrast ratio of at least 4.5:1
    }

    untinted: rule(system.docs_generator) {
      must {{ keep every surface, text, border and `bg-` colour neutral, its red, green and blue equal, in both themes }}
    }

    compact_sizes: rule(system.docs_generator) {
      must {{ size controls at 24, 28 and 32 px, rows at 28 px, and the top bar at 44 px; give marks and inline code a radius of 4 px, controls 6 px, cards and code 8 px and overlays 10 px; and keep every spacing step on a 4 px grid }}
    }

    type_scale: rule(system.docs_generator) {
      must {{ set the interface at 13 px, docs prose at 15 px growing with the window to 17 px with lines of about 72 to 90 characters, code, paths, identifiers, field names and numbers in the mono at 12.5 px, and group labels at 11 px }}
    }

    quiet_motion: rule(system.docs_generator) {
      must {{ keep every duration between 120 and 200 ms }}
    }
  }

  typography: section {
    | The docs are read, so their text is set to be read: the sentences of the spec in the
    | body face at full strength, and the small and faint levels kept for what a reader
    | scans past.

    sentences_at_full_strength: rule(system.docs_generator) {
      must {{ set every sentence that comes from the spec, a rule's, the sentences of steps, [summary lines](#tools.docs.lenses.what_a_lens_shows.summary_line) and diagnostic messages included, in the body face at the docs prose size of the type scale of the [design tokens](#tools.docs.design_system.tokens) and the `text` level }}
    }

    prose_in_code: rule(system.docs_generator) {
      must {{ colour the text of a `{{ }}` body and of a `|` line in a code block at the `text` level, as prose outside code is, and keep the faint levels for comments alone }}
      then {{ the sentences of an example read as sentences, and only a `//` or `///` comment reads as an aside }}
    }

    small_text_for_facts: rule(system.docs_generator) {
      must_not {{ set a sentence from the spec in `text-faint`, in `text-decor` or below the docs prose size }}
      instead {{ keep `text-secondary` and the smaller sizes for labels, breadcrumbs, facts lines and captions }}
    }
  }

  composing: section {
    | These bind whoever builds a view of the docs, and the reviewer of it.

    dark_first: rule(actors.implementer) {
      must {{ design the dark theme first, and the light theme alongside it rather than inverted from it }}
    }

    hairlines_not_shadows: rule(actors.implementer) {
      must_not {{ separate things with shadows }}
      instead {{ separate them with hairline borders in three strengths, `border-faint`, `border` and `border-strong` }}
    }

    flows_without_hairlines: rule(actors.implementer) {
      must_not {{ draw a hairline between consecutive items of one flow, such as rules, terms, steps or diagnostics }}
      instead {{ separate them by space, and keep hairlines for the edges of regions, the rows of [tables](#heron.language.markup.components.table) and code blocks; the line that joins the numbers of a stepper's steps is part of its marks, not a separator }}
    }

    one_level_of_indent: rule(actors.implementer) {
      must_not {{ nest a bordered box inside another, or indent content more than one level from its [column](#heron.language.grammar.lexical.column) }}
      instead {{ show hierarchy with headings, their levels and the navigation }}
    }

    overlays_cast_shadows: rule(actors.implementer) {
      may {{ give an overlay the `shadow-overlay` shadow, such as a menu, a popover or the search palette }}
    }

    project_colour_never_fills: rule(actors.implementer) {
      must_not {{ fill a button, card, callout, code block or cell with the [project colour](#tools.docs.design_system.project_colour) }}
    }

    status_colours_mean: rule(actors.implementer) {
      must_not {{ use a [status colour](#tools.docs.design_system.status_colours) for anything but what it means }}
    }

    no_filled_pills: rule(actors.implementer) {
      must_not {{ show a status or kind colour as a filled pill }}
      instead {{ show it as coloured text or a 1 px outline }}
    }

    buttons: rule(actors.implementer) {
      must {{ give buttons grey fills with no outline, one primary button per view filled with the text colour, and icon buttons a transparent fill until hovered }}
    }

    headings: rule(actors.implementer) {
      must {{ set headings in semibold with the `tracking-heading` letter spacing, and group labels in the faintest readable level }}
    }

    polish_from_detail: rule(actors.implementer) {
      must_not {{ use gradients on text or [surfaces](#tools.docs.design_system.surfaces), glow, emoji or illustrations }}
      instead {{ polish through detail: a translucent top bar with backdrop blur, a faint dot grid behind diagrams, focus rings on keyboard focus only, syntax colours from the same tokens, and code blocks with a title bar and a copy button }}
    }

    motion_explains: rule(actors.implementer) {
      may {{ animate a change that motion explains, such as a panel opening, a row expanding or a result arriving }}
      while {{ the reader allows motion }}
    }

    keyboard_first: rule(actors.implementer) {
      must {{ offer the search palette on ⌘K on the docs, shortcuts for every frequent action, and focus that's always visible }}
    }

    ui_sdk_base: rule(actors.implementer) {
      must {{ compose the islands' components from the [UI SDK](#tools.docs.design_system.ui_sdk)'s behaviours, rather than writing popups, selection, typeahead, roving focus, reordering, resizing or virtual lists by hand }}
      then {{ accessibility comes with the behaviours rather than being added per component }}
    }
  }

  @display("UI SDK")
  ui_sdk: term {{
    The base of the docs' islands: behaviours and primitives with Solid bindings, such as popups,
    selection, typeahead, roving focus, reordering, resizing and virtualized lists, which
    the islands compose into their components. Its skill is part of the
    repository's generated agent files, so an agent composes from the same behaviours.
  }}
}
