@display("Rendering baseline")
rendering: section {
  | Every lens renders by the same baseline, `explore` included: a page reads as text, its
  | hierarchy comes from headings and the navigation, and structure shows only where the
  | data has it. How a rule's sentence is built is [the requirements' rendering](#language.specifications.requirements.ears_sentence); these
  | rules say how it and the nodes around it sit on the page.

  small_table: term {{
    Data a page would show as a table that has one column, or fewer than three rows below
    its header.
  }}

  rules_as_prose: rule(language.specifications.requirements.rule_kind, by = product.system.docs_generator) {
    must {{ render a rule as one paragraph holding its sentence, set in the docs body face at the size and level of the page's prose, starting at the left edge of the text column }}
  }

  no_rule_columns: rule(language.specifications.requirements.rule_kind, by = product.system.docs_generator) {
    mustNot {{ render a rule's strength, conditions or consequences in a label column, in a hanging indent, or in a smaller or fainter style than its sentence }}
  }

  formal_parts_on_hover: rule(language.specifications.requirements.rule_kind, by = product.system.docs_generator) {
    must {{ show a rule's path, targets, subject and strength's keyword in a hover card on its anchor, outside the `explore` lens, which shows them on the page }}
  }

  target_chip: rule(language.specifications.requirements.rule_kind, by = product.system.docs_generator) {
    where {{ a target of a rule is the node the rule stands in, or the section that holds it }}
    mustNot {{ show that target as a chip beside the rule }}
    then {{ a chip shows only the targets a reader couldn't tell from where the rule is }}
  }

  rules_flow: rule(language.specifications.requirements.rule_kind, by = product.system.docs_generator) {
    must {{ separate consecutive rules, terms and diagnostics of one section by the space between two paragraphs, with no border or rule line between them }}
  }

  tables_for_tabular_data: rule(tools.docs.rendering, by = product.system.docs_generator) {
    must {{ render as a table only data of at least two columns and at least three rows below its header, such as the fields of a type, the options of a command or a status matrix }}
  }

  small_tables_as_lines: rule(small_table, by = product.system.docs_generator) {
    where {{ data the generator would render as a table is a [small table](#tools.docs.rendering.small_table) }}
    must {{ render each of its rows as one line, its first cell first and every other cell after the label its column has in the [string catalogue](#tools.frontend.writing.string_catalogue) }}
    example {{ a command with one option shows `--addr` String, default `127.0.0.1:7340` on one line, not a table of one row }}
  }

  authored_tables_kept: rule(small_table, by = product.system.docs_generator) {
    must {{ render a table written in prose as the table it is, whatever its size }}
    then {{ a [small table](#tools.docs.rendering.small_table) in prose is the author's to fix, as [the guide](#guide.kinds.no_small_tables) asks }}
  }

  lists_stay_lists: rule(tools.docs.rendering, by = product.system.docs_generator) {
    must {{ render a list written in prose as a list, and a list of nodes, such as a section's terms or a diagnostics index, as a list of entries, never as a table or a grid of cards }}
  }

  diagnostics_compact: rule(language.specifications.tech_kinds.diagnostic_kind, by = product.system.docs_generator) {
    must {{ list the diagnostics of the diagnostics page as compact entries, each its code and its message on one line with its fix, the first sentence of its prose, under it }}
  }

  one_indent: rule(tools.docs.rendering, by = product.system.docs_generator) {
    must {{ indent a page's content at most one level from the left edge of its text column, and show a node's depth by its heading's level and its place in the navigation }}
  }

  no_nested_boxes: rule(tools.docs.rendering, by = product.system.docs_generator) {
    mustNot {{ draw a bordered box inside another, or indent a node's children under the node }}
  }
}
