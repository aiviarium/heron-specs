@display("API page")
api_page: screen(route = "/<api>.html") {
  | An api's landing page in the API reference: what it is, how it travels on the wire, and
  | every op grouped by the surface it belongs to, one line each, so a reader finds an op
  | without opening each one. The top bar and the sidebar are the [op page](#tools.docs.screens.op_page)'s.

  lead: region(tools.docs.screens.api_page.lead.api_facts) {
    | The api's prose, its base path and its wire format.

    api_facts: rule(system.docs_generator) {
      must {{ show the api's prose, its base path, and its wire format: JSON bodies over HTTP, streams as server-sent events and sockets as websocket frames }}
    }
  }

  service: region(tools.docs.screens.api_page.service.service_lead, tools.docs.screens.api_page.service.methods_grouped, tools.docs.screens.api_page.service.signature_each, tools.docs.screens.api_page.service.facts_by_binding) {
    | An api bound to a gRPC service, to JSON-RPC or to a [Sparrow facet](#language.apis.sparrow.sparrow_facet) reads as a service: its
    | name, its protocols, and its methods by their signatures.

    service_lead: rule(system.docs_generator) {
      where {{ an api is bound by `std/proto`, `std/jsonrpc` or `std/sparrow` }}
      must {{ show the service's fully qualified name with a copy button, the [protocols](#language.apis.grpc.proto_protocol) it's served over, its JSON-RPC [framing](#language.apis.jsonrpc.jsonrpc_framing) and encoding, whether it takes batches, its Sparrow [facet](#language.apis.sparrow.sparrow_facet) with its id, version, facet hash and retired ids and its service with its id, and its [server URLs](#language.apis.rpc.server_url) }}
    }

    facts_by_binding: rule(system.docs_generator) {
      must {{ show each fact as its label and its value, and under the binding switch only the facts of the binding picked: the base path and the wire format for HTTP, the service and its protocols for gRPC and Connect, the framing, the encoding and batches for JSON-RPC, the facet, its version and hash and the service for Sparrow, and the servers and the cross-cutting annotations for every binding }}
    }

    methods_grouped: rule(system.docs_generator) {
      where {{ an api is bound by `std/proto`, `std/jsonrpc` or `std/sparrow` }}
      must {{ group a gRPC service's methods by [streaming kind](#language.apis.rpc.streaming_kind), unary first, a Sparrow service's likewise with its [notifications](#language.apis.sparrow.sparrow_notification) last, and a JSON-RPC api's by the part of the method's name before its first `/` or `.`, [notifications](#language.apis.jsonrpc.jsonrpc_notification) last }}
    }

    signature_each: rule(system.docs_generator) {
      must {{ show each method on one line under its group's heading: its signature as `Method(Request) returns (stream Response)`, its JSON-RPC name, or its [Sparrow method](#language.apis.sparrow.sparrow_method)'s id and signature, its [display name](#language.core_format.naming.display_name) linked to its page, and the first sentence of its prose }}
      then {{ the group's heading names the [streaming kind](#language.apis.rpc.streaming_kind) once, rather than a badge on each method }}
    }

    both_indexes: rule(system.docs_generator) {
      where {{ an api has more than one binding }}
      must {{ show each binding's index under the binding switch, one binding at a time }}
    }
  }

  ops: region(tools.docs.screens.api_page.ops.ops_grouped, tools.docs.screens.api_page.ops.one_line_each) {
    | The ops, grouped.

    ops_grouped: rule(system.docs_generator) {
      must {{ group the api's ops by the first segment of their path after the base path, each group in the order its first op is written }}
    }

    one_line_each: rule(system.docs_generator) {
      must {{ show each op on one row: its method, its path, its [display name](#language.core_format.naming.display_name) linked to its page, the first sentence of its prose, and a mark when it's deprecated }}
    }
  }

  types: region(tools.docs.screens.api_page.types.types_listed) {
    | The types and errors the api's ops name.

    types_listed: rule(system.docs_generator) {
      must {{ list the types and the errors the api's ops name, directly or through the fields of other types, each linked to its page with the first sentence of its docs }}
    }
  }
}
