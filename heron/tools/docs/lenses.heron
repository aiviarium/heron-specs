lenses: section {
  | One tree has readers who want different things from it: a person who uses the product
  | wants tasks and the commands they type, a person who writes a spec in the language wants
  | its forms and examples, and an implementer wants every rule. A lens is one of these ways
  | through the tree. Every lens of a site is rendered from the same checked tree in the same
  | run, so no lens can drift from another, and lenses are declared in Heron, so a package
  | adds its own beside the [standard lenses](#tools.docs.standard_lenses).

  lens_kind: term {{
    `name: lens { … }`, `std/docs`'s kind for one way through a tree, named by its node's
    name. Its fields: `title`, the name the lens switcher shows; `default`, whether the
    lens is the one served at the site's root; `show`, the kinds and categories it renders
    in full; `summarize`, the kinds it renders as one line that expands; `hide`, the kinds
    it leaves out; `nav`, how its navigation is ordered; `entry`, the [authored pages](#language.markup.authored_pages.authored_page) it puts
    first; `depth`, how many levels of sections get pages of their own in it, in place of
    the [docs block](#tools.docs.extending.docs_block)'s; `prefix`, the folder of the site its pages are written in;
    `format`, what it's written as; `marks`, whether it reads [lens marks](#tools.docs.lenses.lens_mark); `budget`, the [size budget](#tools.docs.agents.size_budget) of a file it writes in Markdown; and `kinds`, a `KindMarks`, whether it marks a node's kind with its icon, `ICON`, the default, or not at all, `NONE`.
  }}

  lens_format: term {{
    `std/docs`'s enum `LensFormat`, what a lens is written as: `HTML`, the default, as pages of
    the site, or `MARKDOWN`, as the plain files of the [agent export](#tools.docs.agents.agent_export).
  }}

  lens_nav: term {{
    `std/docs`'s enum `LensNav`, how a lens orders its navigation: `TASK` puts the [authored pages](#language.markup.authored_pages.authored_page) first and the reference after them, `TOPIC` follows the tree's sections as topics,
    and `TREE` lists every node of the tree in its place.
  }}

  lens_mark: term {{
    `@lens(names…)` on a node or a [prose run](#language.markup.lens_marks.prose_run), or `@lens="names…"` on an
    element: the [lenses](#tools.docs.lenses.lens_kind) the node or the block is for, each named by a reference to a
    lens node.
  }}

  declaring: section {
    | A lens is a node like any other: a package declares one where its readers need it, and
    | a tree that declares a lens with the name of an imported one uses its own, as any name
    | in scope shadows an imported one.

    lens_fields: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      must {{ check a lens's fields against `lens`'s declaration in `std/docs`: `title` a `String`, `default` an optional `Bool`, `show`, `summarize`, `hide` and `entry` optional lists of references, `nav` a `LensNav`, `depth` an optional `Int`, `prefix` a `String`, `format` an optional `LensFormat`, `marks` an optional `Bool`, `budget` an optional `Int` and `kinds` an optional `KindMarks` }}
      example {{ `nav = LensNav.PAGES` reports "LensNav has no member PAGES" }}
    }

    lists_name_kinds: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      if {{ an entry of a lens's `show`, `summarize` or `hide` names a node that's neither a kind nor a category }}
      must {{ report not a kind at the entry }}
    }

    entry_names_pages: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      if {{ an entry of a lens's `entry` names a node that isn't an [authored page](#language.markup.authored_pages.authored_page) }}
      must {{ report not an [authored page](#heron.language.markup.authored_pages.authored_page) at the entry }}
    }

    prefix_form: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      if {{ a lens's `prefix` is anything but `""` or one path segment of lower-case letters, digits and `-` }}
      must {{ report bad prefix at the prefix }}
      example {{ `"dev"` and `"explore"` are prefixes; `"/dev/"`, `"Dev"` and `"docs/dev"` aren't }}
    }

    budget_form: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      if {{ a lens's `budget` is below 500 }}
      must {{ report bad budget at the budget }}
      then {{ no [area file](#tools.docs.agents.area_file) is split into parts smaller than a page of text }}
    }

    lens_names_resolve: rule(tools.docs.lenses.lens_mark, by = system.checker) {
      if {{ a name in a [lens mark](#tools.docs.lenses.lens_mark) or in a docs block's `lenses` resolves to nothing in scope, or to a node that isn't a lens }}
      must {{ report unknown lens with the lenses in scope, or not a lens, at the name, as an error }}
    }

    overriding: rule(tools.docs.lenses.lens_kind, by = system.checker) {
      where {{ a tree declares a lens with the name of a lens it imports, as `user` }}
      must {{ resolve that name, in the [docs block](#tools.docs.extending.docs_block) and in every [lens mark](#tools.docs.lenses.lens_mark) of the tree, to the tree's own lens }}
      then {{ a package overrides a standard lens by declaring one of the same name, and the standard one is left as it was for every other tree }}
    }

    @display("Declaring a lens")
    declaring_a_lens: example {
      | ```heron
      | import = ["std/doc@1", "std/spec@1", "std/docs@1"]
      |
      | /// For the support team: the commands they run and the errors customers meet.
      | support: lens {
      |   title = "Support"
      |   nav = LensNav.TASK
      |   show = [docs.authored, spec.command, spec.error]
      |   prefix = "support"
      | }
      |
      | docs {
      |   lenses = [user, support, explore]
      | }
      | ```
    }
  }

  choosing: section {
    | The [docs block](#tools.docs.extending.docs_block) chooses which lenses a site builds and in what order the lens switcher
    | lists them, as `docs { lenses = [user, developer, explore] }`.

    lenses_built: rule(tools.docs.lenses.choosing, by = system.docs_generator) {
      must {{ build one set of pages for each lens the docs block's `lenses` lists, in one run, from the one checked tree }}
    }

    lenses_unset: rule(tools.docs.lenses.choosing, by = system.docs_generator) {
      where {{ the [docs block](#tools.docs.extending.docs_block) sets no `lenses`, or the tree has no [docs block](#tools.docs.extending.docs_block) }}
      must {{ build the `explore` lens alone, at the site's root, with no lens switcher }}
      then {{ a tree that chooses no lens gets the full site it got before lenses existed }}
    }

    no_lens: rule(tools.docs.lenses.choosing, by = system.checker) {
      if {{ a [docs block](#tools.docs.extending.docs_block) sets `lenses` to an empty list }}
      must {{ report no lens at the list }}
    }

    one_default: rule(tools.docs.lenses.choosing, by = system.checker) {
      if {{ the lenses a [docs block](#tools.docs.extending.docs_block) lists hold no lens whose `default` is true, or more than one }}
      must {{ report one default lens at the `lenses` list }}
    }

    default_at_root: rule(tools.docs.lenses.choosing, by = system.docs_generator) {
      must {{ serve the default lens at the site's root, whatever its `prefix`, and every other lens of the list under its `prefix` }}
    }

    empty_prefix_only_default: rule(tools.docs.lenses.choosing, by = system.checker) {
      if {{ a lens of a docs block's `lenses` other than its default one has the `prefix` `""` }}
      must {{ report bad prefix at the `lenses` list, naming the lens }}
    }

    distinct_prefixes: rule(tools.docs.lenses.choosing, by = system.checker) {
      if {{ two lenses of a docs block's `lenses`, neither of them its default one, have the same `prefix`, or one of them has the `prefix` of the `agent` lens in scope }}
      must {{ report prefix taken at the `lenses` list }}
    }

    html_lenses_only: rule(tools.docs.lenses.choosing, by = system.checker) {
      if {{ a docs block's `lenses` lists a lens whose `format` is `MARKDOWN` }}
      must {{ report not a site lens at the entry }}
      then {{ the site's lenses are its pages, and the [agent export](#tools.docs.agents.agent_export) is written through the `agent` lens alone }}
    }
  }

  what_a_lens_shows: section {
    | A lens decides each node by its kind and by the [lens marks](#tools.docs.lenses.lens_mark) on it and above it. A
    | node is rendered in full, rendered as a [summary line](#tools.docs.lenses.what_a_lens_shows.summary_line), or left out.

    summary_line: term {{
      A node rendered as one line at its anchor: a rule's sentence, or else the node's
      [display name](#language.core_format.naming.display_name) and the first sentence of its prose, with a disclosure that opens the
      node in full in place, without a script.
    }}

    named_nodes_decided: rule(tools.docs.lenses.what_a_lens_shows, by = system.docs_generator) {
      must {{ decide each named node of the tree on its own, and render the nodes a node's prose builds, such as its paragraphs, lists, [tables](#heron.language.markup.components.table) and tags, with that node }}
    }

    kind_lists: rule(tools.docs.lenses.lens_kind, by = system.docs_generator) {
      must {{ leave out a node whose kind the lens's `hide` names, render as a [summary line](#tools.docs.lenses.what_a_lens_shows.summary_line) a node whose kind `summarize` names, and render in full a node whose kind `show` names, by the first of these that holds; and where none holds, do the same with each of the kind's categories }}
      then {{ a list naming the kind itself wins over one naming its category, and between two lists naming the same kind or category, `hide` wins over `summarize` and `summarize` over `show` }}
      example {{ with `show = [doc.block]` and `hide = [spec.rule]`, a rule is left out though its kind is a block }}
    }

    unlisted_kinds: rule(tools.docs.lenses.lens_kind, by = system.docs_generator) {
      where {{ a node's kind and its categories are in none of the lens's three lists }}
      must {{ treat the node as its parent is treated, and treat a child of the tree's root as rendered in full when the lens sets no `show` and as left out when it does }}
      then {{ `show` lists what a lens keeps: in the `user` lens a guide's own sections show with it, and the tree's sections don't }}
    }

    lens_depth: rule(tools.docs.lenses.lens_kind, by = system.docs_generator) {
      where {{ a lens sets `depth` }}
      must {{ give pages of their own, in that lens, to the sections and [folder scopes](#guide.layout.folder_scope) less than its `depth` levels down, in place of the [docs block](#tools.docs.extending.docs_block)'s `depth`, and show a deeper section on its nearest ancestor's page, under its heading }}
      then {{ the `user` lens's language reference is a page per part of the language, while `developer` and `explore` keep a page per concern }}
    }

    containers_kept: rule(tools.docs.lenses.what_a_lens_shows, by = system.docs_generator) {
      where {{ a lens leaves a section out and keeps a node below it }}
      must {{ keep the section's heading, and its page where it's a [page node](#tools.docs.site.page_node), as the place of the nodes it keeps, without the section's own prose }}
    }

    empty_containers_dropped: rule(tools.docs.lenses.what_a_lens_shows, by = system.docs_generator) {
      where {{ a lens shows nothing of a section's or a [folder scope](#guide.layout.folder_scope)'s subtree, neither a node below it nor a [prose run](#language.markup.lens_marks.prose_run) of its own }}
      mustNot {{ give the section or the scope a heading, a page or a place in the navigation in that lens }}
      then {{ a folder whose pages and prose are all marked for `user` has no empty page in `developer` }}
    }

    marked_nodes: rule(tools.docs.lenses.lens_mark, by = system.docs_generator) {
      where {{ a node or a [prose run](#language.markup.lens_marks.prose_run) carries a [lens mark](#tools.docs.lenses.lens_mark) }}
      must {{ leave it, with its subtree, out of every lens the mark doesn't name, except `explore` and a lens whose `marks` is false }}
    }

    marks_unread: rule(tools.docs.lenses.lens_mark, by = system.docs_generator) {
      where {{ a lens's `marks` is false }}
      must {{ decide every node and [prose run](#language.markup.lens_marks.prose_run) by the lens's kind lists alone, whatever [lens marks](#tools.docs.lenses.lens_mark) it carries }}
      then {{ a lens for every reader of the whole tree, as `agent` is, isn't narrowed by marks written for the site's audiences }}
    }

    mark_keeps_node: rule(tools.docs.lenses.lens_mark, by = system.docs_generator) {
      where {{ a [lens mark](#tools.docs.lenses.lens_mark) names a lens whose lists would leave the marked node out }}
      must {{ render the node in full in that lens }}
      then {{ `@lens(user)` on a section shows the section and its prose in the `user` lens, which doesn't show the tree's sections by their kind }}
    }

    marks_inherit: rule(tools.docs.lenses.lens_mark, by = system.docs_generator) {
      where {{ a node or a [prose run](#language.markup.lens_marks.prose_run) below a marked node carries no [lens mark](#tools.docs.lenses.lens_mark) of its own }}
      must {{ give it the lenses of the nearest marked node above it }}
    }

    inner_mark_narrows: rule(tools.docs.lenses.lens_mark, by = system.docs_generator) {
      where {{ a marked node holds a node or a [prose run](#language.markup.lens_marks.prose_run) marked with a lens its own mark doesn't name }}
      must {{ leave the inner one out of that lens too }}
      then {{ a [lens mark](#tools.docs.lenses.lens_mark) narrows the lenses of what's above it and never widens them }}
    }

    links_across_lenses: rule(tools.docs.lenses.what_a_lens_shows, by = system.docs_generator) {
      where {{ a link on a page of one lens leads to a node that lens leaves out }}
      must {{ link the node's anchor on its page in the first lens of the site's `lenses` that shows it, with that lens named only in the link's tooltip, as "Opens in the Developer docs" }}
      then {{ a user's page can link a rule, which opens in `explore`, and every link reads as its words alone }}
    }
  }

  navigation: section {
    | A lens's `nav` orders its navigation tree and its home page; the pages themselves are
    | the same [page nodes](#tools.docs.site.page_node) in every lens that keeps them.

    task_nav: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TASK` }}
      must {{ list in its navigation the pages its `entry` names, then its other [authored pages](#language.markup.authored_pages.authored_page) grouped by kind as guides, tutorials, how-tos and concepts, each group in the order the tree writes it, then a group of the reference: every other page the lens keeps, in the order of the tree, then its diagnostics page, titled with the [string catalogue](#tools.frontend.writing.string_catalogue)'s word for errors, and its glossary }}
    }

    task_reference_once: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TASK`, and a page of the reference holds nothing the lens shows but its own prose and [authored pages](#language.markup.authored_pages.authored_page) its navigation already lists }}
      mustNot {{ list that page in the reference group }}
      then {{ a folder of how-tos is listed once, by its how-tos, and not again by its folder }}
    }

    task_home: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TASK` }}
      must {{ show on its home page the site's title and the root's prose the lens keeps; then the first page its `entry` names, or else its first tutorial, as the primary link, with the page's title and the first sentence of its prose; then a group for each group of its navigation, labelled as the navigation labels it, with a link to each of its pages but the primary one, each with the page's title and the first sentence of its prose where it has one }}
      then {{ the home page reaches every page its navigation lists, and a group left with no page is left out }}
    }

    topic_home: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TOPIC` }}
      must {{ show on its home page the site's title and the root's prose the lens keeps, then a group for each group of its navigation, labelled with its section's title, with a link to each of its pages and the first sentence of the page's prose where it has one }}
    }

    topic_nav: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TOPIC` }}
      must {{ list in its navigation the sections the lens keeps, nested as the tree nests them, and the other [page nodes](#tools.docs.site.page_node) it keeps under the section that holds them }}
      then {{ the navigation names topics and pages, and never a rule, a term or a diagnostic }}
    }

    tree_nav: rule(tools.docs.lenses.lens_nav, by = system.docs_generator) {
      where {{ a lens's `nav` is `LensNav.TREE` }}
      must {{ list in its navigation every page the lens keeps, nested as the tree nests them }}
      then {{ a node that's an anchor on a page is in that page's outline, as [page_layout.outline_nested] says, never in the navigation }}
    }

    nav_by_area: rule(tools.docs.lenses.navigation, by = system.docs_generator) {
      must {{ split each lens's navigation by [site area](#tools.docs.site.site_area), so each area's tab shows its part of the lens's navigation }}
    }
  }

  errors: section {
    @realizes(tools.docs.lenses.declaring.budget_form)
    @display("Bad budget")
    bad_budget: error("lens", by = system.checker) {
      title = "{lens}: a budget is at least 500 tokens, not {budget}"
      lens: field(String)
      budget: field(String)
    }

    @realizes(tools.docs.lenses.choosing.html_lenses_only)
    @display("Not a site lens")
    markdown_lens_listed: error("lens", by = system.checker) {
      title = "{lens} is written as Markdown; a site's lenses are written as HTML, and heron generate agents writes the agent lens"
      lens: field(String)
    }

    @realizes(tools.docs.lenses.declaring.lens_names_resolve)
    @display("Unknown lens")
    unknown_lens: error("unresolved", by = system.checker) {
      title = "unknown lens {name}; the lenses in scope are {names}"
      name: field(String)
      names: field(String)
      | A [lens mark](#tools.docs.lenses.lens_mark) or a docs block's `lenses` naming a lens that's declared nowhere in scope.
    }

    @realizes(tools.docs.lenses.declaring.lens_names_resolve)
    @display("Not a lens")
    not_a_lens: error("lens", by = system.checker) {
      title = "{name} is a {kind}, not a lens"
      name: field(String)
      kind: field(String)
      | A [lens mark](#tools.docs.lenses.lens_mark) or a docs block's `lenses` naming a node of another kind.
    }

    @realizes(tools.docs.lenses.declaring.lists_name_kinds)
    @display("Not a kind")
    lens_not_a_kind: error("lens", by = system.checker) {
      title = "{name} is a {kind}; a lens's {field} lists kinds and categories"
      name: field(String)
      kind: field(String)
      field: field(String)
    }

    @realizes(tools.docs.lenses.declaring.entry_names_pages)
    @display("Not an authored page")
    entry_not_a_page: error("lens", by = system.checker) {
      title = "{name} is a {kind}; a lens's entry lists guides, how-tos, concepts and tutorials"
      name: field(String)
      kind: field(String)
    }

    @realizes(tools.docs.lenses.choosing.no_lens)
    @display("No lens")
    no_lens: error("lens", by = system.checker) {
      title = "the site builds no lens: name at least one in lenses"
    }

    @realizes(tools.docs.lenses.choosing.one_default)
    @display("One default lens")
    one_default_lens: error("lens", by = system.checker) {
      title = "a site has exactly one default lens; {count} of {names} set default = true"
      count: field(String)
      names: field(String)
      | Set `default = true` on the lens the site's root serves, and on no other lens of the list.
    }

    @realizes(tools.docs.lenses.choosing.empty_prefix_only_default, tools.docs.lenses.declaring.prefix_form)
    @display("Bad prefix")
    bad_prefix: error("lens", by = system.checker) {
      title = "{lens}: {reason}"
      lens: field(String)
      reason: field(String)
      | A prefix is `""` or one lower-case path segment, and only the default lens is written at the root.
    }

    @realizes(tools.docs.lenses.choosing.distinct_prefixes)
    @display("Prefix taken")
    prefix_taken: error("lens", by = system.checker) {
      title = "{lens} and {other} are both served under {prefix}/"
      lens: field(String)
      other: field(String)
      prefix: field(String)
    }
  }
}
