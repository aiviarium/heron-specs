documenting: epic {
  | Publishing a tree as a documentation site that each of its readers can use: the people
  | who use what it describes, the people who write trees of their own, and the implementers
  | who build from it. Every reader's view is a [lens](#tools.docs.lenses.lens_kind) of the same tree, so the views can't
  | disagree.

  user_audience: section {
    | For a [reader](#product.actors.reader): compact, task first, and nothing that binds an implementation.

    tasks_first: story(as = product.actors.reader) {
      want =| the docs to open on the tasks I can do with the product
      so =| I get something done without reading its spec

      opens_on_tasks: criterion {
        given {{ a site whose [docs block](#tools.docs.extending.docs_block) lists `user`, `developer` and `explore`, and a tree with a guide and two how-tos }}
        when {{ the reader opens the site's `index.html` }}
        then {{ the page is the `user` lens's home, with a link to the guide and to each how-to }}
        then {{ the navigation lists the guide, then the how-tos, then the reference }}
      }

      no_rules_shown: criterion {
        given {{ a section that holds a rule, a term and a command }}
        when {{ the reader opens the command's page in the `user` lens }}
        then {{ the page shows the command with its options and exit codes, and no rule }}
        then {{ the glossary lists the term }}
      }

      errors_as_fixes: criterion {
        given {{ a diagnostic with a code, a message and prose }}
        when {{ the reader opens the `user` lens's diagnostics page }}
        then {{ the diagnostic is one entry with its code, its message and the first sentence of its prose, without its severity or the part that reports it }}
      }
    }

    pages_stay_true: story(as = product.actors.reader) {
      want =| every example and fact on a page to match the product I have
      so =| what I copy from the docs works

      broken_example_fails: criterion {
        given {{ a how-to whose example uses an option the spec has since removed }}
        when {{ the author runs `heron check` }}
        then {{ it fails with [example doesn't check](#language.markup.authored_pages.diagnostics.example_fails) at the example }}
      }

      fact_follows_spec: criterion {
        given {{ a how-to that inserts `${cli.serve.addr.default}` }}
        when {{ the option's default changes and the docs are generated again }}
        then {{ the how-to shows the new default }}
      }

      fact_gone_fails: criterion {
        given {{ a how-to that inserts an option's default }}
        when {{ the option is removed and the author runs `heron check` }}
        then {{ it fails with [unknown name](#language.core_format.naming.diagnostics.unknown_name) at the [insertion](#language.markup.inserts.insertion) }}
      }
    }
  }

  developer_audience: section {
    | For an [author](#product.actors.author) writing a tree of their own: concise, navigable and pleasant to read.

    write_for_readers: story(as = product.actors.author) {
      want =| to write guides, how-tos, concepts and tutorials in the tree they explain
      so =| my readers get pages written for them that can't drift from the spec

      authored_page_shown: criterion {
        given {{ a how-to with three steps and no [lens mark](#tools.docs.lenses.lens_mark) }}
        when {{ the docs are generated }}
        then {{ the how-to has a page in each lens the site builds, its steps numbered 1 to 3, each step at its own anchor }}
      }

      marked_for_users: criterion {
        given {{ a section with one [prose run](#language.markup.lens_marks.prose_run) marked `@lens(user)` and one marked `@lens(developer)` }}
        when {{ the docs are generated with the three standard lenses }}
        then {{ the `user` page shows only the first run, the `developer` page only the second, and the `explore` page both, each beside the title of its lens }}
      }

      unknown_lens_reported: criterion {
        given {{ a node marked `@lens(users)` in a tree that declares no lens `users` }}
        when {{ the author runs `heron check` }}
        then {{ it fails with [unknown lens](#tools.docs.lenses.diagnostics.unknown_lens), listing `user`, `developer` and `explore` }}
      }
    }

    read_by_topic: story(as = product.actors.author) {
      want =| the language's docs by topic, with its examples first and each rule in one line
      so =| I find the form I need and see it used before I read its rules

      topics_and_lines: criterion {
        given {{ a section with two rules and an example }}
        when {{ the author opens the section's page in the `developer` lens }}
        then {{ the example comes first, rendered in full, and each rule follows as one line that opens in place }}
        then {{ the navigation lists sections, and no rule }}
      }

      readable_rule: criterion {
        given {{ a rule with a `when`, a `must` and a `then`, targeting the section it stands in }}
        when {{ the page renders }}
        then {{ the rule is one sentence in the body text, with no label column, no target chip and no border to the next rule }}
      }
    }

    own_lenses: story(as = product.actors.author) {
      want =| to declare the lenses my readers need, and change a standard one
      so =| my organization's docs show each audience what it needs

      declared_lens_built: criterion {
        given {{ a tree that declares `support: lens { … prefix = "support" }` and lists it in its [docs block](#tools.docs.extending.docs_block) }}
        when {{ the docs are generated }}
        then {{ the site has the lens's pages under `support/`, and the lens switcher lists its title }}
      }

      override_used: criterion {
        given {{ a tree that declares its own `user` lens with a different `show` }}
        when {{ the docs are generated }}
        then {{ the site's root shows what the tree's `user` lens shows, and `std/docs`'s `user` lens is unused }}
      }
    }
  }

  implementer_audience: section {
    | For an [implementer](#product.actors.implementer): every rule and every node, in its place, from the same tree.

    full_view: story(as = product.actors.implementer) {
      want =| one view of the docs that shows every node with its formal parts
      so =| nothing another lens leaves out is hidden from me

      everything_in_explore: criterion {
        given {{ a rule, and a section marked `@lens(user)` }}
        when {{ the implementer opens them in the `explore` lens }}
        then {{ both are on their pages, the rule with its path, targets, subject and strength on one line under its sentence, and the section with the title of the `user` lens beside it }}
      }
    }

    same_node_everywhere: story(as = product.actors.implementer) {
      want =| a link to a node to lead to the same node in every lens
      so =| I can send a reader of another lens to what I mean

      switch_keeps_place: criterion {
        given {{ the page of a command in the `user` lens, scrolled to an option's anchor }}
        when {{ the implementer picks `Explore` in the lens switcher }}
        then {{ the command's page opens in `explore/` at the same anchor }}
      }

      hidden_target_opens: criterion {
        given {{ a how-to in the `user` lens that links a rule }}
        when {{ a reader follows the link }}
        then {{ the rule's anchor opens in the `explore` lens }}
      }
    }
  }
}
