serve(
  /// The address to listen on, as `host:port`; port 0 picks a free one, which the printed
  /// URL shows.
  @option(value = "host:port")
  addr: String = "127.0.0.1:7340",
  /// The [entry point](#language.core_format.files.entry_point): a file, or a folder's `index.heron`, relative to the working
  /// folder. With none, `.`.
  entry_point?: String,
): command("heron serve", cli.serve.serves_workspace) {
  | Serves the spec browser of one tree, rendered live, and its [agent export](#tools.docs.agents.agent_export), and prints the URL
  | it listens on, as `http://127.0.0.1:7340/`, on standard output. What it serves is [the server](#system.server). It runs until it's stopped.

  | Exits 0 when: the server was closed.
  @status(500)
  exit_1: error("heron serve exit 1") {
    title = "the address can't be listened on, or the server failed"
  }
  @status(400)
  exit_2: error("heron serve exit 2") {
    title = "an unknown option, or a workspace that can't be opened at the entry point"
  }

  example {{ `heron serve --addr 127.0.0.1:0 petstore` serves a sample tree on a free port and prints its URL. }}

  serves_workspace: rule(system.server) {
    must {{ serve the workspace and its spec browser over HTTP until it's stopped }}
  }
}
