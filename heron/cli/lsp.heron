lsp(
  /// How long to wait after an edit before checking again, as a Go duration such as
  /// `300ms`. Zero, the value it starts from, means the default.
  @option(value = "duration")
  debounce: String = "150ms",
  /// Accepted for editors that pass it; standard input and output are the only transport.
  @option
  stdio: Bool = true,
): command("heron lsp", cli.lsp.answers_lsp) {
  | Serves the language server over standard input and output, for an editor to start. It
  | checks and lints with every lint and prose provider registered, whoever registered
  | them, and logs to standard error. What it serves is [the language server](#system.language_server).

  | Exits 0 when: the editor shut the server down.
  @status(500)
  exit_1: error("heron lsp exit 1") {
    title = "the connection failed"
  }
  @status(400)
  exit_2: error("heron lsp exit 2") {
    title = "an unknown option"
  }

  example {{ An editor's client starts `heron lsp --stdio` in the project's folder and speaks LSP over the pipe. }}

  answers_lsp: rule(system.language_server) {
    must {{ answer the Language Server Protocol over standard input and output until the client exits }}
  }
}
