fmt: command("heron fmt") {
  usage = ["heron fmt [--check] [--stdout] [paths…]"]

  | Formats [Heron files](#language.core_format.files.heron_file) in place from their [lossless tree](#language.grammar.recovery.lossless_tree), as [the formatter](#product.system.formatter) lays
  | them out, writing a file only when its text changes. A folder is walked for `.heron`
  | and `.heron.md` files, skipping folders whose names start with `.` and `node_modules`.
  | A file with syntax errors is formatted too. Options come before the paths.

  paths: argument("paths", type = String, optional = true, variadic = true) {
    | Files and folders, relative to the working folder. With none, `.`. A file named
    | directly is formatted whatever its extension.
  }

  check: option("--check", type = Bool, default = false) {
    | Changes nothing, and prints the path of every file that isn't formatted, relative to
    | the working folder, one per line.
  }

  stdout: option("--stdout", type = Bool, default = false) {
    | Prints every file's formatted text, one after another, instead of rewriting it. It
    | wins over `--check`.
  }

  exit(0) {{ Every file is formatted, or was rewritten. }}
  exit(1) {{ With `--check`, a file isn't formatted; or a path doesn't exist, or a file can't be read or written. }}
  exit(2) {{ An unknown option. }}

  example {{ `heron fmt --check fixtures spec std` lists the files a commit would leave unformatted, as CI runs it. }}

  check_changes_nothing: rule(fmt.check, by = product.system.command_line) {
    mustNot {{ write any file }}
  }

}
